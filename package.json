{
  "name": "nuditos",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev --host",
    "build": "astro build && echo # > dist/.assetsignore",
    "deploy": "astro build && wrangler pages deploy dist --project-name=nuditos --branch=main",
    "preview": "astro preview",
    "upload": "node scripts/upload-image.js"
  },
  "engines": {
    "node": ">=20.10.0"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.8",
    "@astrojs/cloudflare": "^11.2.0",
    "@astrojs/sitemap": "3.6.0",
    "@astrojs/tailwind": "^6.0.2",
    "@nanostores/persistent": "^1.3.3",
    "astro": "^4.16.0",
    "cloudinary": "^2.10.0",
    "nanostores": "^1.2.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "wrangler": "^3.114.17"
  }
}
