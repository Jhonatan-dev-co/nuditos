---
import Icon from './Icon.astro';
---

<section class="bg-stone-50 py-8 sm:py-10 md:py-14 px-3 sm:px-4 md:px-6 border-y border-stone-100">
  <div class="max-w-[1200px] mx-auto">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
      
      <div class="flex items-start gap-3 p-3.5 sm:p-4 bg-white rounded-2xl border border-stone-100 shadow-xs hover:shadow-md transition-all">
        <div class="w-9 h-9 rounded-xl bg-amber-100 flex items-center justify-center flex-shrink-0">
          <Icon name="leaf" class="w-4.5 h-4.5 text-amber-600" />
        </div>
        <div class="min-w-0">
          <div class="text-xs sm:text-[13px] font-bold text-slate-800 mb-0.5">Hecho a Mano</div>
          <p class="text-slate-500 leading-relaxed text-[11px] sm:text-xs">Crochet 100% artesanal que dura para siempre.</p>
        </div>
      </div>

      <div class="flex items-start gap-3 p-3.5 sm:p-4 bg-white rounded-2xl border border-stone-100 shadow-xs hover:shadow-md transition-all">
        <div class="w-9 h-9 rounded-xl bg-emerald-100 flex items-center justify-center flex-shrink-0">
          <Icon name="truck" class="w-4.5 h-4.5 text-emerald-600" />
        </div>
        <div class="min-w-0">
          <div class="text-xs sm:text-[13px] font-bold text-slate-800 mb-0.5">Envío Incluido</div>
          <p class="text-slate-500 leading-relaxed text-[11px] sm:text-xs">A todo Colombia, sin mínimos ni sorpresas.</p>
        </div>
      </div>

      <div class="flex items-start gap-3 p-3.5 sm:p-4 bg-white rounded-2xl border border-stone-100 shadow-xs hover:shadow-md transition-all">
        <div class="w-9 h-9 rounded-xl bg-blue-100 flex items-center justify-center flex-shrink-0">
          <Icon name="bank-card" class="w-4.5 h-4.5 text-blue-600" />
        </div>
        <div class="min-w-0">
          <div class="text-xs sm:text-[13px] font-bold text-slate-800 mb-0.5">Pagos Seguros</div>
          <p class="text-slate-500 leading-relaxed text-[11px] sm:text-xs">100% seguros con Nequi, PSE y tarjetas.</p>
        </div>
      </div>

      <div class="flex items-start gap-3 p-3.5 sm:p-4 bg-white rounded-2xl border border-stone-100 shadow-xs hover:shadow-md transition-all">
        <div class="w-9 h-9 rounded-xl bg-green-100 flex items-center justify-center flex-shrink-0">
          <Icon name="whatsapp" class="w-4.5 h-4.5 text-green-600" />
        </div>
        <div class="min-w-0">
          <div class="text-xs sm:text-[13px] font-bold text-slate-800 mb-0.5">Soporte Humano</div>
          <p class="text-slate-500 leading-relaxed text-[11px] sm:text-xs">Escríbenos para personalizar tu ramo eterno.</p>
        </div>
      </div>

    </div>
  </div>
</section>
