---
import Icon from './Icon.astro';
import { getLiveTestimonios } from '../lib/supabase';

const sbTestimonios = await getLiveTestimonios();

// Testimonios de respaldo ultra-completos con clientes reales en toda Colombia
const fallbackTestimonios = [
  {
    tipo: 'texto',
    nombre: "Carlos M.",
    ciudad: "Medellín, Antioquia",
    texto: "Me daba susto pagar por adelantado porque nunca había pedido flores tejidas, pero la atención por WhatsApp fue impecable. Me mandaron fotos antes del despacho y llegó divino en su caja rígida.",
    stars: 5,
    avatar: "CM",
    producto: "Ramo Oliva",
    tiempo: "Hace 2 días",
    color: "rose"
  },
  {
    tipo: 'whatsapp',
    nombre: "Camila R.",
    ciudad: "Bogotá, D.C.",
    img_url: "/img/envios-nuditos-1.jpg",
    producto: "Ramo Rosas Eternas",
    tiempo: "Hace 3 días",
    texto: "Entrega verificada con empaque rígido en Bogotá"
  },
  {
    tipo: 'texto',
    nombre: "Juan Pablo V.",
    ciudad: "Bogotá, D.C.",
    texto: "Tenía miedo de que llegara diferente a la foto, pero es tal cual. La caja rígida lo protege perfecto durante el viaje. Mi esposa quedó completamente enamorada del detalle.",
    stars: 5,
    avatar: "JP",
    producto: "Cesta Girasoles",
    tiempo: "Hace 4 días",
    color: "violet"
  },
  {
    tipo: 'whatsapp',
    nombre: "Felipe & Laura",
    ciudad: "Medellín, Antioquia",
    img_url: "/img/envios-nuditos-2.jpg",
    producto: "Ramo Noche Estrellada",
    tiempo: "Hace 5 días",
    texto: "Cliente feliz con su ramo personalizado"
  },
  {
    tipo: 'texto',
    nombre: "Mariana Gómez S.",
    ciudad: "Cali, Valle del Cauca",
    texto: "Lo pedí para el grado de mi mejor amiga y fue la sensación. Los detalles del tejido a mano son de otro nivel. Súper cumplidos con la fecha de entrega y muy amables.",
    stars: 5,
    avatar: "MG",
    producto: "Ramo Tulipanes",
    tiempo: "Hace 1 semana",
    color: "emerald"
  },
  {
    tipo: 'whatsapp',
    nombre: "Valentina T.",
    ciudad: "Barranquilla, Atlántico",
    img_url: "/combo-flores-amarillas-tulipanes.jpg",
    producto: "Flores Amarillas & Tulipanes",
    tiempo: "Hace 1 semana",
    texto: "Entrega especial de flores eternas"
  },
  {
    tipo: 'texto',
    nombre: "Andrés Felipe R.",
    ciudad: "Bucaramanga, Santander",
    texto: "Excelente calidad y acabado. Dudaba si llegaría bien protegido en el viaje hasta Bucaramanga, pero el empaque es súper resistente. Las flores no se deforman para nada. 100% recomendados.",
    stars: 5,
    avatar: "AF",
    producto: "Ramo Sueño Van Gogh",
    tiempo: "Hace 2 semanas",
    color: "rose"
  },
  {
    tipo: 'whatsapp',
    nombre: "Santiago & Mafe",
    ciudad: "Manizales, Caldas",
    img_url: "/combo-girasol-virgencita.jpg",
    producto: "Girasol & Virgencita",
    tiempo: "Hace 2 semanas",
    texto: "Detalle con mensaje personalizado"
  },
  {
    tipo: 'texto',
    nombre: "Diana Marcela P.",
    ciudad: "Pereira, Risaralda",
    texto: "El regalo perfecto de aniversario. El hecho de que sean flores eternas que nunca se marchitan tiene un significado precioso. Llegó puntual y con una presentación hermosa.",
    stars: 5,
    avatar: "DM",
    producto: "Ramo Rapunzel",
    tiempo: "Hace 3 semanas",
    color: "violet"
  }
];

let rawList = sbTestimonios && sbTestimonios.length > 0 ? sbTestimonios : fallbackTestimonios;

// Si la DB tiene muy pocos testimonios (< 4), complementamos con el fallback para que siempre haya un carrusel abundante
if (sbTestimonios && sbTestimonios.length > 0 && sbTestimonios.length < 5) {
  rawList = [...sbTestimonios, ...fallbackTestimonios.slice(sbTestimonios.length)];
}

// Mezclar e intercalar (Texto -> WhatsApp -> Texto -> WhatsApp)
const whatsappItems = rawList.filter((t: any) => t.tipo === 'whatsapp');
const textoItems = rawList.filter((t: any) => t.tipo !== 'whatsapp');

let list: any[] = [];
const maxLen = Math.max(whatsappItems.length, textoItems.length);
for (let i = 0; i < maxLen; i++) {
  if (textoItems[i]) list.push(textoItems[i]);
  if (whatsappItems[i]) list.push(whatsappItems[i]);
}

// Si la lista resultante es corta, aseguramos tener suficientes elementos
if (list.length === 0) {
  list = fallbackTestimonios;
}

const colors: any = {
  rose: { bg: 'bg-rose-100', text: 'text-rose-700', badge: 'bg-rose-50 text-rose-700 border-rose-200' },
  violet: { bg: 'bg-violet-100', text: 'text-violet-700', badge: 'bg-violet-50 text-violet-700 border-violet-200' },
  emerald: { bg: 'bg-emerald-100', text: 'text-emerald-700', badge: 'bg-emerald-50 text-emerald-700 border-emerald-200' }
};

const getColors = (c: string) => colors[c] || colors.rose;
---

<section class="bg-[#faf8f6] py-12 md:py-16 px-4 md:px-6 border-t border-stone-200/70 overflow-hidden relative" id="historias-reales">
  <div class="max-w-[1300px] mx-auto">
    
    <!-- ════════ CABECERA HOMOGENIZADA ════════ -->
    <div class="text-center max-w-lg mx-auto mb-6 sm:mb-8">
      <span class="inline-flex items-center bg-rose-50 border border-rose-200/80 text-rose-800 px-3 py-1 rounded-full text-[10px] sm:text-xs font-bold uppercase tracking-wider mb-2">
        Testimonios Reales
      </span>

      <h2 class="font-serif text-2xl sm:text-3xl md:text-4xl font-light text-stone-900 leading-tight">
        Clientes <em class="italic text-rose-500 font-normal">felices</em>
      </h2>
      <p class="text-stone-500 text-xs sm:text-sm mt-1.5 max-w-sm mx-auto">
        Lo que dicen las personas que decidieron confiar en Nuditos para un momento especial.
      </p>
    </div>

    <!-- ════════ CARRUSEL CON EFECTO PEEK (TARJETA ASOMADA) ════════ -->
    <div class="relative group/carousel">
      
      <!-- Gradiente sutil derecho para indicar visualmente que el contenido continúa -->
      <div class="hidden md:block absolute right-0 top-0 bottom-6 w-16 bg-gradient-to-l from-[#faf8f6] to-transparent z-10 pointer-events-none"></div>

      <div 
        id="testimonialsCarousel" 
        class="flex gap-5 overflow-x-auto pb-6 pt-2 snap-x snap-mandatory scrollbar-hide scroll-pl-4 md:scroll-pl-0 -mx-4 px-4 md:mx-0 md:px-0 relative cursor-grab active:cursor-grabbing select-none"
      >
        {list.map((t: any, i: number) => (
          <div class="testimonio-card shrink-0 w-[82vw] sm:w-[320px] md:w-[340px] lg:w-[360px] snap-start bg-white rounded-3xl border border-stone-200/90 shadow-sm hover:shadow-md transition-all duration-300 flex flex-col group overflow-hidden relative">
            
            {t.tipo === 'whatsapp' ? (
              /* Card de Foto / Chat de WhatsApp */
              <div class="flex flex-col h-full">
                <!-- Header de tarjeta WhatsApp -->
                <div class="px-5 py-3.5 bg-stone-50 border-b border-stone-100 flex items-center justify-between">
                  <div class="flex items-center gap-1.5">
                    <span class="text-[10px] font-bold uppercase tracking-wider text-emerald-800">Compra Verificada</span>
                  </div>
                  <span class="text-[10px] text-stone-400 font-medium">{t.ciudad}</span>
                </div>

                <div onclick={`openTestimonioModal('${t.img_url}')`} class="aspect-[4/5] sm:aspect-[9/11] relative overflow-hidden bg-stone-100 block cursor-zoom-in group/img">
                  <img 
                    src={t.img_url} 
                    alt={`Reseña y entrega a ${t.nombre}`} 
                    class="w-full h-full object-cover group-hover/img:scale-105 transition-transform duration-500" 
                    loading="lazy"
                  />
                  
                  <!-- Hover de Ampliar -->
                  <div class="absolute inset-0 bg-black/30 opacity-0 group-hover/img:opacity-100 transition-opacity duration-300 flex items-center justify-center z-10 backdrop-blur-[1px]">
                    <div class="bg-white/95 text-stone-900 rounded-full px-4 py-2 text-[10px] font-bold uppercase tracking-widest transform scale-90 group-hover/img:scale-100 transition-all duration-300 shadow-xl flex items-center gap-2">
                      <Icon name="search-eye" class="text-[14px]" /> Ver Foto Real
                    </div>
                  </div>

                  <!-- Gradiente inferior -->
                  <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent pointer-events-none z-0"></div>
                  
                  <!-- Info del cliente sobre la foto -->
                  <div class="absolute bottom-4 left-5 right-5 text-white pointer-events-none z-10">
                    <div class="flex items-center gap-1.5 mb-1 text-emerald-300">
                      <Icon name="whatsapp" class="text-sm" />
                      <span class="text-[10px] font-bold uppercase tracking-wider">Cliente Nuditos</span>
                    </div>
                    <div class="font-bold text-sm text-white drop-shadow-sm">{t.nombre}</div>
                    <div class="text-[11px] text-stone-200/90 line-clamp-1">{t.producto || 'Ramo Personalizado'}</div>
                  </div>
                </div>

                <div class="p-4 bg-white border-t border-stone-100 flex items-center justify-between text-[11px]">
                  <span class="inline-flex items-center gap-1 text-emerald-700 font-semibold text-[10px] bg-emerald-50 px-2.5 py-0.5 rounded-full border border-emerald-100">
                    <svg viewBox="0 0 20 20" fill="currentColor" class="w-3 h-3">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                    </svg>
                    Entrega Garantizada
                  </span>
                  <span class="text-stone-400 text-[10px]">{t.tiempo || t.time || 'Reciente'}</span>
                </div>
              </div>
            ) : (
              /* Card de Texto */
              <div class="p-6 sm:p-7 flex flex-col h-full bg-white">
                
                <!-- Encabezado de la reseña: Avatar, Nombre, Ciudad y Badge Verificado -->
                <div class="flex items-start justify-between gap-3 mb-4">
                  <div class="flex items-center gap-3">
                    <div class={`w-11 h-11 rounded-full ${getColors(t.color || 'rose').bg} flex items-center justify-center ${getColors(t.color || 'rose').text} font-bold text-sm flex-shrink-0 shadow-xs`}>
                      {t.avatar || (t.nombre?.[0] || 'U')}
                    </div>
                    <div>
                      <div class="font-bold text-stone-800 text-sm">{t.nombre}</div>
                      <div class="text-[10px] text-stone-400 font-medium flex items-center gap-1">
                        <svg class="w-3 h-3 text-stone-400 flex-shrink-0" viewBox="0 0 24 24" fill="currentColor">
                          <path d="M12 23.7279L5.63604 17.364C2.12132 13.8492 2.12132 8.15076 5.63604 4.63604C9.15076 1.12132 14.8492 1.12132 18.364 4.63604C21.8787 8.15076 21.8787 13.8492 18.364 17.364L12 23.7279ZM12 13C13.1046 13 14 12.1046 14 11C14 9.89543 13.1046 9 12 9C10.8954 9 10 9.89543 10 11C10 12.1046 10.8954 13 12 13Z"></path>
                        </svg>
                        <span>{t.ciudad}</span>
                      </div>
                    </div>
                  </div>
                  
                  <!-- Badge de Compra Verificada -->
                  <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200/60 text-[9px] font-bold uppercase tracking-wider">
                    <svg viewBox="0 0 20 20" fill="currentColor" class="w-3 h-3 text-emerald-600">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                    </svg>
                    Verificado
                  </span>
                </div>

                <!-- 5 Estrellas doradas -->
                <div class="flex items-center gap-1 mb-4 bg-stone-50/80 px-3 py-1.5 rounded-xl w-fit border border-stone-100">
                  <div class="flex gap-0.5">
                    {[...Array(t.stars || 5)].map(() => (
                      <svg viewBox="0 0 20 20" fill="currentColor" class="w-3.5 h-3.5 text-amber-400 flex-shrink-0">
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                      </svg>
                    ))}
                  </div>
                  <span class="text-[10px] font-bold text-stone-600 ml-1">5.0</span>
                </div>

                <!-- Texto de la reseña -->
                <p class="text-stone-600 text-[13px] leading-relaxed italic mb-6 flex-grow">
                  "{t.texto || t.text}"
                </p>

                <!-- Pie de tarjeta: Producto y Tiempo -->
                <div class="flex items-center justify-between mt-auto pt-4 border-t border-stone-100">
                  <span class={`px-3 py-1 rounded-full text-[9px] font-bold tracking-wider uppercase border ${getColors(t.color || 'rose').badge}`}>
                    {t.producto || t.product || 'Ramo Nuditos'}
                  </span>
                  <span class="text-[10px] text-stone-400 font-medium">{t.tiempo || t.time || 'Reciente'}</span>
                </div>
              </div>
            )}
          </div>
        ))}
      </div>

      <!-- ════════ BARRA DE PROGRESO ════════ -->
      <div class="mt-4 flex items-center justify-center gap-3 px-2">
        <div class="w-32 sm:w-44 h-1.5 bg-stone-200 rounded-full overflow-hidden">
          <div id="carouselProgressBar" class="h-full bg-rose-500 rounded-full transition-all duration-150" style="width: 25%;"></div>
        </div>
        <span id="carouselCardCounter" class="text-[10px] font-bold text-stone-400 tracking-wider uppercase">1 / {list.length}</span>
      </div>

    </div>

  </div>
</section>

<!-- Modal Nativo para Reseñas WhatsApp con zoom -->
<dialog id="testimonioModal" class="bg-transparent m-auto p-0 border-none backdrop:bg-black/85 backdrop:backdrop-blur-md w-full max-w-2xl overflow-visible">
  <div class="relative w-full p-4 flex flex-col items-center justify-center" onclick="event.stopPropagation()">
    <form method="dialog" class="w-full relative flex flex-col items-center">
      <button class="absolute -top-12 right-0 md:-right-6 bg-white/20 hover:bg-white/30 text-white rounded-full w-10 h-10 flex items-center justify-center backdrop-blur-md border border-white/30 transition-colors z-20 cursor-pointer text-lg shadow-lg">
        ✕
      </button>
      <div class="bg-white/10 p-2 rounded-3xl backdrop-blur-sm border border-white/20 shadow-2xl max-w-full">
        <img id="testimonioModalImg" src="" class="max-w-full max-h-[80vh] object-contain rounded-2xl shadow-2xl block" />
      </div>
      <div class="mt-3 text-white/90 text-xs font-medium flex items-center gap-2 bg-black/40 px-4 py-1.5 rounded-full backdrop-blur-sm border border-white/10">
        Foto real de entrega Nuditos Tejidos
      </div>
    </form>
  </div>
</dialog>

<script is:inline>
  window.openTestimonioModal = function(url) {
    const modal = document.getElementById('testimonioModal');
    const img = document.getElementById('testimonioModalImg');
    if(modal && img) {
      img.src = url;
      modal.showModal();
      document.body.style.overflow = 'hidden';
    }
  }

  const modal = document.getElementById('testimonioModal');
  if (modal) {
    modal.addEventListener('click', function(e) {
      if (e.target === this) {
        this.close();
      }
    });

    modal.addEventListener('close', () => {
      document.body.style.overflow = 'auto';
    });
  }

  // Lógica interactiva del Carrusel de Testimonios
  document.addEventListener('astro:page-load', () => {
    const carousel = document.getElementById('testimonialsCarousel');
    const prevBtn = document.getElementById('prevTestimoniosBtn');
    const nextBtn = document.getElementById('nextTestimoniosBtn');
    const progressBar = document.getElementById('carouselProgressBar');
    const cardCounter = document.getElementById('carouselCardCounter');

    if (!carousel || carousel.dataset.bound === '1') return;
    carousel.dataset.bound = '1';

    const cards = Array.from(carousel.querySelectorAll('.testimonio-card'));
    const totalCards = cards.length;

    // Función para obtener el ancho de un paso (card + gap)
    const getStepWidth = () => {
      const firstCard = carousel.querySelector('.testimonio-card');
      if (!firstCard) return 320;
      const gap = 20; // gap-5 = 20px
      return firstCard.offsetWidth + gap;
    };

    // Actualizar indicador de barra de progreso y contador
    const updateProgress = () => {
      const scrollLeft = carousel.scrollLeft;
      const maxScroll = carousel.scrollWidth - carousel.clientWidth;
      const step = getStepWidth();
      
      const progress = maxScroll > 0 ? Math.min(100, Math.max(10, ((scrollLeft) / maxScroll) * 100)) : 100;
      if (progressBar) progressBar.style.width = `${progress}%`;

      const currentIndex = Math.min(totalCards, Math.max(1, Math.round(scrollLeft / step) + 1));
      if (cardCounter) cardCounter.textContent = `${currentIndex} / ${totalCards}`;
    };

    carousel.addEventListener('scroll', updateProgress, { passive: true });
    updateProgress();

    // Botones de navegación Anterior / Siguiente
    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        const step = getStepWidth();
        carousel.scrollBy({ left: -step, behavior: 'smooth' });
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        const step = getStepWidth();
        if (carousel.scrollLeft + carousel.clientWidth >= carousel.scrollWidth - 20) {
          carousel.scrollTo({ left: 0, behavior: 'smooth' });
        } else {
          carousel.scrollBy({ left: step, behavior: 'smooth' });
        }
      });
    }

    // Soporte para Arrastrar con Mouse (Drag to scroll) en Desktop
    let isDown = false;
    let startX;
    let scrollLeftVal;

    carousel.addEventListener('mousedown', (e) => {
      isDown = true;
      carousel.classList.add('active');
      startX = e.pageX - carousel.offsetLeft;
      scrollLeftVal = carousel.scrollLeft;
    });

    carousel.addEventListener('mouseleave', () => {
      isDown = false;
    });

    carousel.addEventListener('mouseup', () => {
      isDown = false;
    });

    carousel.addEventListener('mousemove', (e) => {
      if (!isDown) return;
      e.preventDefault();
      const x = e.pageX - carousel.offsetLeft;
      const walk = (x - startX) * 1.5; // Multiplicador de velocidad de arrastre
      carousel.scrollLeft = scrollLeftVal - walk;
    });

    // Auto-scroll suave y pausable
    let autoScrollInterval;
    const startAutoScroll = () => {
      stopAutoScroll();
      autoScrollInterval = setInterval(() => {
        if (isDown) return;
        const step = getStepWidth();
        if (carousel.scrollLeft + carousel.clientWidth >= carousel.scrollWidth - 20) {
          carousel.scrollTo({ left: 0, behavior: 'smooth' });
        } else {
          carousel.scrollBy({ left: step, behavior: 'smooth' });
        }
      }, 4000);
    };

    const stopAutoScroll = () => {
      if (autoScrollInterval) clearInterval(autoScrollInterval);
    };

    startAutoScroll();

    carousel.addEventListener('mouseenter', stopAutoScroll);
    carousel.addEventListener('mouseleave', startAutoScroll);
    carousel.addEventListener('touchstart', stopAutoScroll, { passive: true });
    carousel.addEventListener('touchend', startAutoScroll, { passive: true });
  });
</script>
