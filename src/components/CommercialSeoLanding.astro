---
import Layout from '../layouts/Layout.astro';
import ProductCard from './ProductCard.astro';
import Icon from './Icon.astro';
import type { CommercialLandingConfig } from '../data/seo-landings';

interface ProductLike {
  id: number;
  name: string;
  desc?: string;
  cat?: string;
  cats?: string[];
  activo?: boolean;
}

interface Props {
  config: CommercialLandingConfig;
  products: ProductLike[];
}

const { config, products } = Astro.props as Props;

function scoreProduct(p: ProductLike, hints: string[]): number {
  const bag = `${p.name || ''} ${p.desc || ''} ${p.cat || ''} ${(p.cats || []).join(' ')}`.toLowerCase();
  return hints.reduce((acc, hint) => acc + (bag.includes(hint.toLowerCase()) ? 1 : 0), 0);
}

const activeProducts = (products || []).filter((p: any) => p.activo !== false);
const sortedProducts = [...activeProducts]
  .map((p) => ({ p, score: scoreProduct(p, config.productHints || []) }))
  .sort((a, b) => b.score - a.score);
const featuredProducts = sortedProducts.slice(0, 8).map((x) => x.p);

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: config.faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
};
---

<Layout title={config.title} description={config.description} keywords={config.keywords}>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <section class="bg-gradient-to-br from-stone-50 via-white to-amber-50/20 pt-20 sm:pt-24 pb-14 sm:pb-16 px-4 md:px-6 border-b border-stone-100">
    <div class="max-w-5xl mx-auto text-center">
      <div class="inline-flex items-center gap-1.5 bg-amber-50 border border-amber-200/70 text-amber-900 px-3.5 py-1 rounded-full text-[10px] sm:text-xs font-bold uppercase tracking-wider mb-4">
        {config.eyebrow}
      </div>
      <h1 class="font-serif text-[clamp(2.1rem,6vw,4.4rem)] font-light leading-[1.08] text-slate-800 mb-4">{config.h1}</h1>
      <p class="max-w-2xl mx-auto text-slate-500 text-xs sm:text-sm md:text-base leading-relaxed mb-6 sm:mb-8">{config.heroCopy}</p>
      
      <!-- Pills de Valor -->
      <div class="flex items-center justify-center gap-2 mb-6 sm:mb-8 flex-wrap">
        <span class="inline-flex items-center gap-1.5 bg-emerald-50 text-emerald-800 px-3 py-1 rounded-full text-[10px] sm:text-xs font-bold border border-emerald-200/60">
          <Icon name="truck" class="w-3.5 h-3.5 text-emerald-600" /> Envío gratis
        </span>
        <span class="inline-flex items-center gap-1.5 bg-amber-50 text-amber-900 px-3 py-1 rounded-full text-[10px] sm:text-xs font-bold border border-amber-200/60">
          <Icon name="hand-heart" class="w-3.5 h-3.5 text-amber-600" /> Hecho a mano
        </span>
        <span class="inline-flex items-center gap-1.5 bg-stone-100 text-stone-700 px-3 py-1 rounded-full text-[10px] sm:text-xs font-bold border border-stone-200">
          <Icon name="checkbox-circle" class="w-3.5 h-3.5 text-stone-600" /> Desde 2022
        </span>
      </div>

      <div class="flex justify-center gap-2.5 sm:gap-3 flex-wrap">
        <a href="/catalogo" class="inline-flex items-center justify-center gap-2 bg-[#1a1220] hover:bg-black text-white px-6 sm:px-8 py-3.5 sm:py-4 rounded-xl sm:rounded-2xl text-xs sm:text-sm font-bold tracking-wide transition-all shadow-lg active:scale-95">
          <Icon name="shopping-bag-3" class="w-4 h-4 text-amber-400" />
          <span>Ver catálogo</span>
        </a>
        <a href="https://wa.me/573144931525" class="inline-flex items-center justify-center gap-2 bg-emerald-600 hover:bg-emerald-700 text-white px-5 sm:px-7 py-3.5 sm:py-4 rounded-xl sm:rounded-2xl text-xs sm:text-sm font-bold tracking-wide transition-all shadow-md active:scale-95">
          <Icon name="whatsapp" class="w-4 h-4" />
          <span>{config.ctaLabel}</span>
        </a>
      </div>
    </div>
  </section>

  <section class="max-w-[1200px] mx-auto px-4 sm:px-6 py-10 sm:py-14">
    <div class="grid md:grid-cols-2 gap-4 sm:gap-6">
      <article class="bg-white border border-stone-100 rounded-2xl sm:rounded-3xl p-6 sm:p-8 shadow-xs">
        <h2 class="font-serif text-2xl sm:text-3xl font-light text-slate-800 mb-3">{config.whyTitle}</h2>
        <p class="text-slate-500 leading-relaxed text-xs sm:text-sm">{config.whyCopy}</p>
      </article>
      <article class="bg-white border border-stone-100 rounded-2xl sm:rounded-3xl p-6 sm:p-8 shadow-xs">
        <h2 class="font-serif text-2xl sm:text-3xl font-light text-slate-800 mb-3">{config.occasionBlockTitle}</h2>
        <p class="text-slate-500 leading-relaxed text-xs sm:text-sm">{config.occasionBlockCopy}</p>
        <div class="mt-4 text-[11px] sm:text-xs font-bold text-amber-800 bg-amber-50 border border-amber-200/60 rounded-xl px-3 py-2 inline-flex items-center gap-1.5">
          <Icon name="check" class="w-3.5 h-3.5 text-amber-600" />
          <span>{config.audience}</span>
        </div>
      </article>
    </div>
  </section>

  <section class="max-w-[1200px] mx-auto px-4 sm:px-6 pb-12 sm:pb-16">
    <div class="flex items-end justify-between mb-6 border-b border-stone-200 pb-3">
      <div>
        <h2 class="font-serif text-2xl sm:text-3xl font-light text-slate-800">Favoritos recomendados</h2>
        <p class="text-xs text-slate-500 mt-1">Selección pensada para {config.primaryKeyword}.</p>
      </div>
      <a href="/catalogo" class="text-[10px] uppercase tracking-widest font-bold text-stone-500 hover:text-stone-900 border border-stone-200 px-3 py-1 bg-white hover:bg-stone-50 transition-colors rounded-lg">Ver todo</a>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-6">
      {featuredProducts.map((p: any) => <ProductCard p={p} />)}
    </div>
  </section>

  <!-- FAQ Acordeón -->
  <section class="bg-stone-50 py-10 sm:py-14 px-4 sm:px-6 border-y border-stone-100">
    <div class="max-w-[800px] mx-auto">
      <div class="text-center max-w-lg mx-auto mb-6 sm:mb-8">
        <span class="inline-flex items-center bg-stone-100 border border-stone-200 text-stone-700 px-3 py-1 rounded-full text-[10px] sm:text-xs font-bold uppercase tracking-wider mb-2">
          Dudas frecuentes
        </span>
        <h2 class="font-serif text-2xl sm:text-3xl font-light text-slate-800 leading-tight">Preguntas frecuentes</h2>
      </div>
      <div class="space-y-0 rounded-xl sm:rounded-2xl overflow-hidden border border-stone-200 bg-white shadow-xs">
        {config.faq.map((item, idx) => (
          <details class="group" open={idx === 0}>
            <summary class="flex items-center gap-2.5 sm:gap-3 px-3.5 sm:px-4 py-3 sm:py-3.5 cursor-pointer select-none hover:bg-stone-50 transition-colors border-b border-stone-100 list-none [&::-webkit-details-marker]:hidden">
              <div class="w-6 h-6 sm:w-7 sm:h-7 rounded-lg bg-amber-50 flex items-center justify-center flex-shrink-0">
                <Icon name="sparkling" class="w-3 h-3 sm:w-3.5 sm:h-3.5 text-amber-600" />
              </div>
              <span class="flex-1 text-xs sm:text-[13px] font-bold text-slate-800">{item.q}</span>
              <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-stone-400 transition-transform group-open:rotate-180 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
            </summary>
            <p class="text-slate-500 text-[11px] sm:text-xs leading-relaxed px-3.5 pb-3.5 pt-1 pl-11 sm:px-4 sm:pb-4 sm:pl-14">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA FINAL -->
  <section class="bg-[#1a1220] py-8 sm:py-10 md:py-14 px-3 sm:px-4 md:px-6 relative overflow-hidden text-center">
    <div class="max-w-lg mx-auto relative z-10">
      <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-2xl bg-green-500/20 flex items-center justify-center mx-auto mb-3 sm:mb-4">
        <Icon name="whatsapp" class="w-6 h-6 sm:w-7 sm:h-7 text-green-400" />
      </div>
      <h2 class="font-serif text-2xl sm:text-3xl md:text-4xl font-light text-white mb-2 leading-tight">
        Explora más opciones <em class="italic text-green-400 font-normal">especiales</em>
      </h2>
      <p class="text-stone-400 text-xs sm:text-[13px] leading-relaxed mb-6 max-w-sm mx-auto">
        Escríbenos por WhatsApp para asesorarte con el detalle perfecto.
      </p>
      <div class="flex flex-wrap justify-center gap-2 mb-6">
        {config.relatedLinks.map((l) => (
          <a href={l.href} class="px-3.5 py-1.5 rounded-full border border-white/20 text-[10px] uppercase tracking-wider font-bold text-stone-300 hover:border-amber-400 hover:text-amber-400 transition-colors">
            {l.label}
          </a>
        ))}
      </div>
      <a href="https://wa.me/573144931525" class="inline-flex items-center gap-2 bg-green-500 text-white px-6 sm:px-8 py-3.5 sm:py-4 rounded-xl sm:rounded-2xl font-bold shadow-lg shadow-green-500/20 hover:bg-green-400 transition-all text-xs sm:text-sm tracking-wide active:scale-[0.97]">
        <Icon name="whatsapp" class="w-4 h-4" />
        <span>Asesoría por WhatsApp</span>
      </a>
    </div>
    <div class="absolute -top-20 -right-20 w-48 h-48 bg-violet-500/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-20 -left-20 w-48 h-48 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>
  </section>
</Layout>

