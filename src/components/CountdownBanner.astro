---
import Icon from './Icon.astro';

interface Props {
  targetDate?: string;
  title?: string;
  badge?: string;
  slug?: string;
  className?: string;
}

const {
  targetDate = '2026-09-21',
  title = 'Día de las Flores Amarillas',
  badge = '21 de Septiembre',
  slug = 'flores-amarillas',
  className = ''
} = Astro.props;

const isYellow = slug === 'flores-amarillas' || slug?.includes('amarill');
---

<aside 
  class:list={[
    "countdown-banner relative overflow-hidden select-none border-b transition-colors",
    isYellow ? "bg-[#fffdf7] border-amber-200/80 text-stone-800" : "bg-stone-50 border-stone-200 text-stone-800",
    className
  ]}
  id="luxuryCountdownBanner"
  data-target-date={targetDate}
  aria-label="Contador de cuenta regresiva de la colección"
>
  <div class="max-w-[1200px] mx-auto px-3 sm:px-4 py-2 sm:py-2.5 flex flex-col sm:flex-row items-center justify-between gap-2 sm:gap-4 relative z-10">
    
    <!-- Lado Izquierdo: Mensaje Claro y No Invasivo -->
    <div class="flex items-center gap-2 sm:gap-2.5 text-center sm:text-left justify-center sm:justify-start">
      <!-- Badge de campaña pastel -->
      <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-amber-100/80 border border-amber-300/70 text-amber-900 text-[10px] sm:text-[11px] font-bold tracking-wide shadow-2xs whitespace-nowrap">
        <Icon name="sparkling" class="w-3 h-3 text-amber-600" />
        <span>{badge}</span>
      </span>

      <!-- Título de campaña -->
      <div class="flex items-center gap-2">
        <span class="font-bold text-xs sm:text-[13px] tracking-wide text-stone-800">
          {title}
        </span>
        <span class="hidden md:inline text-stone-400 text-xs font-normal">• Preventa activa</span>
      </div>
    </div>

    <!-- Lado Derecho: Tarjetas Claras, Limpias y Legibles -->
    <div class="flex items-center gap-1 sm:gap-1.5" id="madreCountdown">
      <!-- Días -->
      <div class="cd-unit-box">
        <div class="cd-digit-tile">
          <span class="cd-num" id="cdDays">--</span>
        </div>
        <span class="cd-tag">Días</span>
      </div>

      <span class="cd-dot-sep">:</span>

      <!-- Horas -->
      <div class="cd-unit-box">
        <div class="cd-digit-tile">
          <span class="cd-num" id="cdHours">--</span>
        </div>
        <span class="cd-tag">Horas</span>
      </div>

      <span class="cd-dot-sep">:</span>

      <!-- Minutos -->
      <div class="cd-unit-box">
        <div class="cd-digit-tile">
          <span class="cd-num" id="cdMins">--</span>
        </div>
        <span class="cd-tag">Min</span>
      </div>

      <span class="cd-dot-sep">:</span>

      <!-- Segundos -->
      <div class="cd-unit-box">
        <div class="cd-digit-tile cd-digit-tile-sec">
          <span class="cd-num cd-num-sec" id="cdSecs">--</span>
        </div>
        <span class="cd-tag cd-tag-sec">Seg</span>
      </div>
    </div>

  </div>
</aside>

<style>
  /* Contenedor de cada unidad */
  .cd-unit-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 32px;
  }
  @media (min-width: 640px) {
    .cd-unit-box {
      min-width: 38px;
    }
  }

  /* Tarjeta de número clara y limpia */
  .cd-digit-tile {
    width: 32px;
    height: 30px;
    background: #ffffff;
    border: 1px solid rgba(217, 119, 6, 0.25);
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 1px 2px rgba(28, 25, 23, 0.04);
  }

  @media (min-width: 640px) {
    .cd-digit-tile {
      width: 38px;
      height: 34px;
      border-radius: 9px;
    }
  }

  /* Tarjeta de segundos con acento cálido sutil */
  .cd-digit-tile-sec {
    background: #fefce8;
    border-color: rgba(217, 119, 6, 0.45);
  }

  /* Número digital legible */
  .cd-num {
    font-family: 'Jost', 'Inter', system-ui, sans-serif;
    font-size: 0.95rem;
    font-weight: 800;
    color: #451a03;
    line-height: 1;
    font-feature-settings: "tnum";
    font-variant-numeric: tabular-nums;
  }

  @media (min-width: 640px) {
    .cd-num {
      font-size: 1.1rem;
    }
  }

  .cd-num-sec {
    color: #b45309;
  }

  /* Separador de dos puntos */
  .cd-dot-sep {
    font-family: 'Jost', sans-serif;
    font-weight: 800;
    font-size: 0.95rem;
    color: #d97706;
    line-height: 1;
    margin-top: -10px;
    opacity: 0.8;
  }

  /* Etiqueta inferior en gris armonioso */
  .cd-tag {
    display: block;
    text-align: center;
    font-size: 0.52rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #78716c;
    margin-top: 2px;
    text-transform: uppercase;
  }

  @media (min-width: 640px) {
    .cd-tag {
      font-size: 0.58rem;
      letter-spacing: 0.1em;
      margin-top: 3px;
    }
  }

  .cd-tag-sec {
    color: #92400e;
    font-weight: 800;
  }
</style>

<script is:inline>
  (function() {
    function initCountdown() {
      var banner = document.getElementById('luxuryCountdownBanner');
      if (!banner) return;

      var targetDateStr = banner.getAttribute('data-target-date') || (window.LANDING_DATA && window.LANDING_DATA.targetDate) || '2026-09-21';
      var target = new Date(targetDateStr + 'T23:59:59-05:00').getTime();

      var dEl = document.getElementById('cdDays');
      var hEl = document.getElementById('cdHours');
      var mEl = document.getElementById('cdMins');
      var sEl = document.getElementById('cdSecs');

      if (!dEl || !hEl || !mEl || !sEl) return;

      function update() {
        var now = Date.now();
        var diff = target - now;

        if (diff <= 0) {
          banner.innerHTML = '<div class="max-w-[1200px] mx-auto py-2 px-4 text-center font-bold text-xs sm:text-sm text-amber-900">🌸 ¡Día de las Flores Amarillas! Pide tu ramo ahora</div>';
          return;
        }

        var d = String(Math.floor(diff / 864e5)).padStart(2, '0');
        var h = String(Math.floor((diff % 864e5) / 36e5)).padStart(2, '0');
        var m = String(Math.floor((diff % 36e5) / 6e4)).padStart(2, '0');
        var s = String(Math.floor((diff % 6e4) / 1e3)).padStart(2, '0');

        dEl.textContent = d;
        hEl.textContent = h;
        mEl.textContent = m;
        sEl.textContent = s;
      }

      update();
      setInterval(update, 1000);
    }

    document.addEventListener('astro:page-load', initCountdown);
    if (document.readyState === 'complete' || document.readyState === 'interactive') {
      initCountdown();
    }
  })();
</script>
