---
import Icon from './Icon.astro';
import { clUrl } from '../data/datos';

interface Props {
  products?: any[];
  instagramUrl?: string;
  whatsappUrl?: string;
}

const {
  products = [],
  instagramUrl = 'https://www.instagram.com/nuditos_tejidos/',
  whatsappUrl = 'https://wa.me/573144931525?text=Hola%20Nuditos!%20Quiero%20unirme%20a%20la%20comunidad%20🌸'
} = Astro.props;

// Curaduría de momentos y fotos reales para la comunidad
const communityMoments = [
  {
    caption: 'Aniversario inolvidable lleno de amor 🌹✨',
    author: '@valen_gomez',
    likes: '342',
    tag: 'Aniversario',
    productFallbackIdx: 0,
    presetImg: 'https://res.cloudinary.com/dzxgu27wr/image/upload/v1776121095/nuditos-products/flor-y-miel-ramo-tejido-crochet-r4qg.jpg'
  },
  {
    caption: 'Girasoles eternos para su grado especial 🌻🎓',
    author: '@camilo_mora',
    likes: '489',
    tag: 'Grados',
    productFallbackIdx: 1,
    presetImg: 'https://res.cloudinary.com/dzxgu27wr/image/upload/v1776121095/nuditos-products/ramo-girasoles-tejido-crochet-h7kp.jpg'
  },
  {
    caption: 'Sorpresa entregada con amor en Bogotá 🛵🌸',
    author: '@mariap_rojas',
    likes: '275',
    tag: 'Detalle Sorpresa',
    productFallbackIdx: 2,
    presetImg: 'https://res.cloudinary.com/dzxgu27wr/image/upload/v1776121095/nuditos-products/ramo-tulipanes-crochet-m9xz.jpg'
  },
  {
    caption: 'Un detalle que jamás se marchitará 💜🧶',
    author: '@andres_florez',
    likes: '516',
    tag: 'Amor Eterno',
    productFallbackIdx: 3,
    presetImg: 'https://res.cloudinary.com/dzxgu27wr/image/upload/v1776121095/nuditos-products/ramo-rosas-eternas-crochet-q2wl.jpg'
  }
];

// Obtener imágenes reales disponibles
const activeProductsWithImg = products.filter(p => p.img && p.img.length > 0);

const displayCards = communityMoments.map((moment, index) => {
  const matchingProduct = activeProductsWithImg[index % (activeProductsWithImg.length || 1)];
  const finalImg = matchingProduct?.img || moment.presetImg;
  return {
    ...moment,
    imgUrl: finalImg,
    productName: matchingProduct?.name || 'Ramo Nuditos'
  };
});
---

<section class="community-section relative overflow-hidden bg-gradient-to-b from-stone-50/70 via-white to-stone-50/50 py-12 md:py-20 px-4 md:px-6 border-t border-stone-200/60" id="comunidad">
  <!-- Luces decorativas suaves de fondo -->
  <div class="pointer-events-none absolute -top-24 left-1/2 -translate-x-1/2 w-96 h-96 bg-purple-200/20 rounded-full blur-3xl"></div>
  <div class="pointer-events-none absolute -bottom-24 right-10 w-72 h-72 bg-rose-200/20 rounded-full blur-3xl"></div>

  <div class="max-w-[1300px] mx-auto relative z-10">
    
    <!-- ════════ CABECERA DE LA COMUNIDAD ════════ -->
    <div class="text-center max-w-2xl mx-auto mb-10 md:mb-14">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white border border-purple-100 shadow-sm text-purple-700 text-[10px] uppercase font-bold tracking-[0.25em] mb-3">
        <Icon name="heart-3" class="w-3.5 h-3.5 text-rose-500 animate-pulse" />
        <span>Únete a la Familia</span>
      </div>

      <h2 class="font-serif text-2.5xl sm:text-3xl md:text-5xl font-normal text-stone-900 leading-tight">
        Unirse a <em class="italic text-purple-600 font-normal">Nuditos</em>
      </h2>

      <p class="text-stone-500 text-xs sm:text-sm md:text-base leading-relaxed mt-3 max-w-lg mx-auto">
        Historias reales, momentos inolvidables y una comunidad que ama los regalos hechos a mano que perduran para siempre.
      </p>

      <!-- Píldoras de Estadísticas & Confianza -->
      <div class="flex flex-wrap items-center justify-center gap-2 md:gap-3 mt-5">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-xl bg-purple-50/80 text-purple-800 text-[10px] md:text-xs font-semibold">
          <Icon name="instagram" class="w-3.5 h-3.5 text-purple-600" /> +5,000 Seguidores
        </span>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-xl bg-rose-50/80 text-rose-800 text-[10px] md:text-xs font-semibold">
          <Icon name="sparkling" class="w-3.5 h-3.5 text-rose-500" /> Flores que no se marchitan
        </span>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-xl bg-emerald-50/80 text-emerald-800 text-[10px] md:text-xs font-semibold">
          <Icon name="hand-heart" class="w-3.5 h-3.5 text-emerald-600" /> 100% Hecho en Colombia 🇨🇴
        </span>
      </div>
    </div>

    <!-- ════════ GRILLA UGC / INSTAGRAM DE LUJO ════════ -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-6">
      {displayCards.map((item) => (
        <a 
          href={instagramUrl} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="community-card group relative aspect-[4/5] rounded-2xl md:rounded-3xl overflow-hidden bg-stone-900 shadow-md hover:shadow-2xl transition-all duration-500 border border-stone-200/60 block"
          aria-label={`Ver momento de ${item.caption} en Instagram`}
        >
          <!-- Imagen de Fondo con Zoom Suave -->
          <img 
            src={clUrl(item.imgUrl, 600)} 
            alt={item.caption} 
            class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700 ease-out" 
            loading="lazy" 
          />

          <!-- Gradiente sombreado para legibilidad -->
          <div class="absolute inset-0 bg-gradient-to-t from-stone-950/85 via-stone-950/20 to-stone-950/40 group-hover:from-stone-950/90 transition-all duration-300"></div>

          <!-- Tag superior izquierda (Instagram handle) -->
          <div class="absolute top-3 left-3 flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-black/40 backdrop-blur-md border border-white/10 text-white text-[9px] md:text-[10px] font-medium tracking-wide">
            <Icon name="instagram" class="w-3 h-3 text-rose-400" />
            <span>@nuditos_tejidos</span>
          </div>

          <!-- Tag superior derecha (Likes) -->
          <div class="absolute top-3 right-3 flex items-center gap-1 px-2 py-1 rounded-full bg-black/40 backdrop-blur-md border border-white/10 text-rose-300 text-[9px] md:text-[10px] font-bold">
            <Icon name="heart-3" class="w-3 h-3 fill-rose-500 text-rose-500" />
            <span>{item.likes}</span>
          </div>

          <!-- Contenido Inferior (Caption & Detalle) -->
          <div class="absolute inset-x-0 bottom-0 p-3 md:p-5 flex flex-col justify-end text-white">
            <span class="inline-block self-start px-2 py-0.5 rounded-md bg-purple-500/30 border border-purple-400/30 text-purple-200 text-[8px] md:text-[9px] uppercase tracking-widest font-bold mb-1.5">
              {item.tag}
            </span>
            <p class="text-[11px] md:text-xs font-normal text-stone-200 leading-snug line-clamp-2 mb-2 group-hover:text-white transition-colors">
              "{item.caption}"
            </p>

            <!-- Botón Ver en Instagram en Hover -->
            <div class="flex items-center gap-1.5 text-[9px] md:text-[10px] uppercase tracking-widest font-bold text-purple-300 group-hover:text-purple-200 pt-1 border-t border-white/10 transition-all">
              <span>Ver en Instagram</span>
              <Icon name="arrow-right" class="w-3 h-3 transition-transform group-hover:translate-x-1" />
            </div>
          </div>
        </a>
      ))}
    </div>

    <!-- ════════ BANNER DE ACCIÓN SOCIAL & HASHTAG ════════ -->
    <div class="mt-8 md:mt-12 bg-white rounded-2xl md:rounded-3xl p-6 md:p-8 border border-stone-200/80 shadow-sm flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="flex items-center gap-4 text-center md:text-left">
        <div class="w-12 h-12 md:w-14 md:h-14 rounded-2xl bg-gradient-to-tr from-purple-600 via-rose-500 to-amber-400 text-white flex items-center justify-center shadow-md shrink-0">
          <Icon name="instagram" class="w-6 h-6 md:w-7 md:h-7" />
        </div>
        <div>
          <h3 class="font-serif text-lg md:text-2xl text-stone-900 font-medium leading-tight">
            Comparte tu momento con <span class="text-purple-600 font-sans font-bold text-base md:text-xl">#NuditosTejidos</span>
          </h3>
          <p class="text-stone-500 text-xs md:text-sm mt-0.5">
            Etiquétanos en tus fotos con <strong class="text-stone-700">@nuditos_tejidos</strong> para ser destacado en nuestra galería oficial.
          </p>
        </div>
      </div>

      <div class="flex items-center gap-3 w-full md:w-auto flex-wrap sm:flex-nowrap justify-center">
        <a 
          href={instagramUrl} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-[#1a1220] hover:bg-purple-700 text-white px-6 py-3.5 rounded-2xl text-[10px] md:text-xs font-bold uppercase tracking-widest transition-all shadow-md active:scale-95 shrink-0"
        >
          <Icon name="instagram" class="w-4 h-4" />
          <span>Seguir en Instagram</span>
        </a>

        <a 
          href={whatsappUrl} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-emerald-50 hover:bg-emerald-100 text-emerald-700 border border-emerald-200/80 px-5 py-3.5 rounded-2xl text-[10px] md:text-xs font-bold uppercase tracking-widest transition-all active:scale-95 shrink-0"
        >
          <Icon name="whatsapp" class="w-4 h-4 text-emerald-600" />
          <span>Escribir por WhatsApp</span>
        </a>
      </div>
    </div>

  </div>
</section>

<style>
  .community-card {
    will-change: transform;
  }
</style>
