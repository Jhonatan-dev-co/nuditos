---
import Icon from './Icon.astro';
import { slugify, clUrl } from '../data/datos';

interface Props {
  p: any;
  catName?: string;
  class?: string;
  parentView?: 'carousel' | 'grid' | 'list';
  idScope?: string; // Nuevo: para evitar duplicados en view-transition-name
  eager?: boolean;
  showScarcity?: boolean; // Fuerza una barra de stock simulada (solo para landings)
}

const { p, catName = 'Nuditos', class: className, parentView = 'grid', idScope = 'default', eager = false, showScarcity = false } = Astro.props;
const imgLoading = eager ? 'eager' : 'lazy';

const vtScope = `${idScope}-${parentView}`;
const productSlug = slugify(p.name);
const allImgs = [p.img, ...(p.imgs || [])].filter((u, i, arr) => u && arr.indexOf(u) === i);
const hasMultiple = allImgs.length > 1;

const searchStr = `${p.name} ${catName} ${p.badge || ''} ${p.desc || ''}`.replace(/<[^>]*>?/gm, '').toLowerCase();
const allCats = [...new Set([p.cat, ...(p.cats || [])].filter(Boolean))].join(',');

// Lógica de Precios y Stock (CRO y Urgencia Real)
const showPrice = p.oferta && p.precioOferta > 0 ? p.precioOferta : p.price;
const origPrice = p.oferta && p.precioOriginal > 0 ? p.precioOriginal : null;
const amountSaved = origPrice ? origPrice - showPrice : 0;

// Stock ficticio para landings: Calcula un número constante entre 2 y 7 basado en el ID
let finalStock = p.stock;
if (showScarcity) {
  const seed = String(p.id).split('').reduce((acc, char) => acc + char.charCodeAt(0), 0);
  finalStock = (seed % 6) + 2; 
}

const hasLowStock = finalStock !== undefined && finalStock !== null && finalStock <= 12 && finalStock > 0;
const isOutOfStock = p.stock !== undefined && p.stock !== null && p.stock === 0;

const cleanBadge = (txt: string) => (txt || '').replace(/[\u{1F300}-\u{1F9FF}\u{2600}-\u{26FF}\u{2700}-\u{27BF}\u{1F1E6}-\u{1F1FF}\u{1F600}-\u{1F64F}\u{1F680}-\u{1F6FF}\u{1F900}-\u{1F9FF}\u{1FA70}-\u{1FAFF}]/gu, '').trim();

// Formato limpio y conciso para no saturar la fotografía del ramo
const formatBadge = (raw: string) => {
  const clean = cleanBadge(raw);
  if (!clean) return '';
  const lower = clean.toLowerCase();
  if (lower.includes('vendido')) return 'Más Vendido';
  if (lower.includes('destacado')) return 'Destacado';
  if (lower.includes('nuevo')) return 'Nuevo';
  if (lower.includes('favorito') || lower.includes('top')) return 'Favorito';
  if (lower.includes('limitad') || lower.includes('exclusiv')) return 'Exclusivo';
  const firstPart = clean.split(/[·•|-]/)[0].trim();
  if (firstPart.length > 14) return firstPart.slice(0, 13).trim() + '…';
  return firstPart;
};

const discountPercent = origPrice && origPrice > showPrice 
  ? Math.round(((origPrice - showPrice) / origPrice) * 100) 
  : 0;

// Máximo 1 badge sobre la foto: Prioriza badge editorial o porcentaje de descuento
const photoBadge = p.badge 
  ? { type: 'custom', text: formatBadge(p.badge) }
  : (p.oferta ? { type: 'oferta', text: discountPercent > 0 ? `-${discountPercent}%` : 'Oferta' } : null);
---

<article 
  class:list={[
    "product-card group", 
    className,
    { "has-carousel": hasMultiple },
    { "is-sold-out": isOutOfStock }
  ]}
  data-cat={p.cat}
  data-cats={allCats}
  data-price={p.price}
  data-search={searchStr}
  id={`pcard-${p.id}-${vtScope}`}
>
  <div class="card-media">
    <div class="media-viewport">
      <a href={`/ramo/${productSlug}?from=${vtScope}`} class="media-link" data-astro-prefetch="hover">
        <div class="img-track" data-imgs={allImgs.map(img => clUrl(img, 480)).join('|')}>
          <img 
            src={clUrl(allImgs[0], 480)} 
            srcset={`${clUrl(allImgs[0], 280)} 280w, ${clUrl(allImgs[0], 480)} 480w, ${clUrl(allImgs[0], 640)} 640w`}
            sizes="(max-width: 640px) 48vw, (max-width: 1024px) 30vw, 320px"
            alt={p.name}
            class="main-img"
            loading={imgLoading}
            decoding="async"
            fetchpriority={eager ? 'high' : 'auto'}
            width="400" height="500"
            style={`view-transition-name: p-img-${p.id}-${vtScope}`}
          />
          {hasMultiple && (
            <img 
              src={clUrl(allImgs[1], 480)} 
              srcset={`${clUrl(allImgs[1], 280)} 280w, ${clUrl(allImgs[1], 480)} 480w, ${clUrl(allImgs[1], 640)} 640w`}
              sizes="(max-width: 640px) 48vw, (max-width: 1024px) 30vw, 320px"
              alt={p.name}
              class="hover-img"
              loading="lazy"
              decoding="async"
              width="400" height="500"
            />
          )}
        </div>
      </a>
    </div>

    {/* Flechas Flotantes (Solo si hay varias fotos) */}
    {hasMultiple && (
      <div class="media-controls">
        <button class="pcard-nav pcard-prev" aria-label="Anterior">
          <Icon name="arrow-left-s" class="w-5 h-5" />
        </button>
        <button class="pcard-nav pcard-next" aria-label="Siguiente">
          <Icon name="arrow-right-s" class="w-5 h-5" />
        </button>
        
        <div class="pcard-dots">
          {allImgs.map((_, i) => (
            <span class={`dot ${i === 0 ? 'active' : ''}`}></span>
          ))}
        </div>
      </div>
    )}

    {/* Badge exclusivo en imagen: Máximo 1 píldora sutil para no tapar el ramo */}
    {photoBadge && (
      <div class="badges-overlay">
        <span class={`p-badge ${photoBadge.type === 'custom' ? 'badge-custom' : 'p-badge-oferta'}`}>
          {photoBadge.text}
        </span>
      </div>
    )}

    {/* Overlay Agotado — Se Vendió */}
    {isOutOfStock && (
      <div class="sold-out-overlay">
        <span class="sold-out-badge">
          <svg class="sold-out-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 12V22H4V12" />
            <path d="M22 7H2v5h20V7z" />
            <path d="M12 22V7" />
            <path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z" />
            <path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z" />
          </svg>
          Se Vendió
        </span>
      </div>
    )}

    {/* Quick Add icon */}
    {p.price > 0 && !isOutOfStock && (
      <button class="quick-add" onclick={`event.preventDefault(); window.addToCart(${p.id})`} aria-label="Añadir al carrito">
        <Icon name="shopping-bag-3" class="w-4 h-4 sm:w-5 sm:h-5" />
      </button>
    )}
  </div>

  <div class="card-info">
    <div class="flex items-center justify-between gap-1.5 mb-1 sm:mb-1.5">
      <span class="cat-label">{catName}</span>
      <div class="rating-badge">
        <svg class="w-2.5 h-2.5 sm:w-3 sm:h-3 text-amber-500 fill-current" viewBox="0 0 20 20">
          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
        </svg>
        <span>{p.rating || "5.0"}</span>
      </div>
    </div>
    
    <a href={`/ramo/${productSlug}`} class="block">
      <h3 class="product-name" title={p.name}>{p.name}</h3>
    </a>

    {/* Urgencia de Stock (Exclusivo Landing o Real) */}
    {hasLowStock && (
      <div class="stock-urgency my-1.5 sm:my-2">
        <div class="flex justify-between items-center text-[13px] sm:text-sm font-bold text-rose-600 mb-1">
          <span class="truncate">Disponibles:</span>
          <span class="flex-shrink-0 font-extrabold text-rose-700">{finalStock} unid.</span>
        </div>
        <div class="w-full bg-rose-100/80 h-2 rounded-full overflow-hidden">
           <div class="bg-rose-500 h-full rounded-full transition-all duration-500 shadow-2xs" style={`width: ${(finalStock / 15) * 100}%`}></div>
        </div>
      </div>
    )}

    {/* Precio y Ahorro */}
    <div class="price-section">
      <div class="price-row">
        <span class={`price-val ${amountSaved > 0 ? 'text-violet-700' : ''}`}>${showPrice.toLocaleString('es-CO')}</span>
        {amountSaved > 0 && (
          <span class="price-orig">${origPrice.toLocaleString('es-CO')}</span>
        )}
        {discountPercent > 0 && (
          <span class="save-badge">-{discountPercent}%</span>
        )}
      </div>

      {/* Envío gratis como propuesta de valor junto al precio */}
      {p.envioGratis && (
        <div class="card-shipping" title="Envío gratis nacional">
          <Icon name="truck" class="w-3 h-3 sm:w-3.5 sm:h-3.5 text-emerald-600 flex-shrink-0" />
          <span>Envío gratis</span>
        </div>
      )}
    </div>
  </div>
</article>

<style>
  .product-card {
    position: relative;
    background: #ffffff;
    border-radius: 1.25rem;
    overflow: hidden;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.35s ease, border-color 0.35s ease;
    border: 1px solid rgba(28, 25, 23, 0.08);
    box-shadow: 0 4px 16px -4px rgba(28, 25, 23, 0.05), 0 1px 2px rgba(28, 25, 23, 0.02);
    display: flex;
    flex-direction: column;
    height: 100%;
    min-width: 0;
  }

  @media (min-width: 640px) {
    .product-card {
      border-radius: 1.5rem;
      box-shadow: 0 8px 24px -6px rgba(28, 25, 23, 0.06), 0 1px 3px rgba(28, 25, 23, 0.02);
    }
    .product-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 18px 36px -8px rgba(26, 18, 32, 0.12), 0 2px 6px rgba(26, 18, 32, 0.03);
      border-color: rgba(217, 119, 6, 0.3);
    }
  }

  /* MEDIA ALINEADA AL BORDE SUPERIOR (FLUSH) */
  .card-media {
    position: relative;
    aspect-ratio: 4/5;
    background: #fbf9f6;
    overflow: hidden;
    border-top-left-radius: inherit;
    border-top-right-radius: inherit;
    border-bottom-left-radius: 0.85rem;
    border-bottom-right-radius: 0.85rem;
    margin: 0;
  }

  @media (min-width: 640px) {
    .card-media {
      border-bottom-left-radius: 1rem;
      border-bottom-right-radius: 1rem;
    }
  }

  .media-viewport { width: 100%; height: 100%; }
  .media-link { display: block; width: 100%; height: 100%; position: relative; }
  .img-track { width: 100%; height: 100%; position: relative; }

  .main-img, .hover-img {
    width: 100%; height: 100%; object-fit: cover;
    transition: opacity 0.5s ease;
  }
  .hover-img { position: absolute; inset: 0; opacity: 0; }

  /* HOVER EFFECT (SOLO PC) */
  @media (hover: hover) {
    .has-carousel:not(.user-navigating):hover .hover-img { opacity: 1; }
    .has-carousel:not(.user-navigating):hover .main-img { opacity: 0; }
  }

  /* FLECHAS FLOTANTES DE NAVEGACIÓN */
  .media-controls {
    position: absolute; inset: 0;
    pointer-events: none; z-index: 20;
    display: flex; align-items: center; justify-content: space-between;
    padding: 0 0.4rem;
  }
  @media (min-width: 640px) {
    .media-controls { padding: 0 0.65rem; }
  }

  @media (min-width: 768px) {
    .media-controls { opacity: 0; transition: opacity 0.3s ease; }
    .product-card:hover .media-controls { opacity: 1; }
  }

  .pcard-nav {
    background: rgba(28, 25, 23, 0.6); border: none; color: white; cursor: pointer;
    pointer-events: auto; width: 1.85rem; height: 1.85rem; display: flex; align-items: center; justify-content: center;
    border-radius: 50%;
    transition: transform 0.25s, background 0.25s, opacity 0.25s; opacity: 0.9;
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    position: relative;
    touch-action: manipulation;
  }
  .pcard-nav::before {
    content: '';
    position: absolute;
    inset: -8px; /* Touch target >= 44px */
  }
  .pcard-nav:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 2px;
  }
  @media (min-width: 640px) {
    .pcard-nav { width: 2.1rem; height: 2.1rem; }
  }
  .pcard-nav:hover { background: rgba(124, 58, 237, 0.85); transform: scale(1.08); opacity: 1; }

  .pcard-dots {
    position: absolute; bottom: 0.5rem; left: 50%;
    transform: translateX(-50%); display: flex; gap: 4px;
    background: rgba(28, 25, 23, 0.45);
    padding: 3px 6px;
    border-radius: 20px;
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }
  @media (min-width: 640px) {
    .pcard-dots { bottom: 0.65rem; padding: 4px 8px; gap: 5px; }
  }
  .dot { width: 4px; height: 4px; border-radius: 50%; background: rgba(255, 255, 255, 0.5); transition: all 0.3s; }
  .dot.active { width: 10px; border-radius: 3px; background: #fff; }

  /* BOTÓN RÁPIDO DE CARRITO */
  .quick-add {
    position: absolute; 
    bottom: 0.6rem; 
    right: 0.6rem;
    background: #ffffff; 
    color: #1c1917; 
    border-radius: 50%;
    width: 2.5rem; 
    height: 2.5rem;
    display: flex; 
    align-items: center; 
    justify-content: center;
    border: 1px solid rgba(28, 25, 23, 0.1); 
    cursor: pointer; 
    z-index: 30;
    box-shadow: 0 4px 14px rgba(28, 25, 23, 0.14);
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), background-color 0.2s ease, color 0.2s ease, box-shadow 0.2s ease;
    touch-action: manipulation;
  }
  .quick-add::before {
    content: '';
    position: absolute;
    inset: -6px; /* Touch target > 48px */
  }
  @media (min-width: 640px) {
    .quick-add {
      width: 2.7rem; 
      height: 2.7rem;
      bottom: 0.75rem; 
      right: 0.75rem;
      box-shadow: 0 6px 18px rgba(28, 25, 23, 0.14);
    }
  }
  @media (min-width: 768px) {
    .quick-add { opacity: 0; transform: translateY(6px) scale(0.92); }
    .product-card:hover .quick-add { opacity: 1; transform: translateY(0) scale(1); }
  }
  .quick-add:hover { 
    background: #1a1220; 
    color: #ffffff; 
    border-color: #1a1220;
    transform: scale(1.06); 
    box-shadow: 0 8px 22px rgba(26, 18, 32, 0.22);
  }
  .quick-add:active { 
    transform: scale(0.92); 
    background: var(--accent); 
    color: #ffffff; 
  }
  .quick-add:focus-visible {
    outline: none;
    box-shadow: 0 0 0 3px rgba(124, 58, 237, 0.4), 0 4px 14px rgba(28, 25, 23, 0.16);
  }

  /* INFORMACIÓN DEL PRODUCTO */
  .card-info { 
    padding: 0.85rem 0.9rem 1.05rem; 
    display: flex; 
    flex-direction: column; 
    flex-grow: 1;
    min-width: 0;
  }
  @media (min-width: 640px) {
    .card-info { padding: 1rem 1.15rem 1.25rem; }
  }

  .cat-label { 
    font-size: 0.65rem; 
    text-transform: uppercase; 
    letter-spacing: 0.08em; 
    color: #87817c; 
    font-weight: 700;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  @media (min-width: 640px) {
    .cat-label { font-size: 0.7rem; letter-spacing: 0.1em; }
  }

  .rating-badge {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    background: #fafaf9;
    border: 1px solid rgba(28, 25, 23, 0.06);
    padding: 0.2rem 0.45rem;
    border-radius: 50px;
    flex-shrink: 0;
  }
  @media (min-width: 640px) {
    .rating-badge { padding: 0.22rem 0.5rem; gap: 4px; }
  }
  .rating-badge svg {
    color: #f59e0b;
  }
  .rating-badge span {
    font-size: 0.65rem;
    font-weight: 800;
    color: #44403c;
    line-height: 1;
    margin-top: 1px;
  }
  @media (min-width: 640px) {
    .rating-badge span { font-size: 0.7rem; }
  }

  .product-name { 
    font-family: 'Cormorant Garamond', serif; 
    font-size: 1.05rem; 
    font-weight: 600; 
    color: #1c1917; 
    margin: 3px 0 6px; 
    line-height: 1.25;
    transition: color 0.2s ease;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    height: 2.5em; /* Asegura altura idéntica en toda la fila */
    text-wrap: balance;
    word-break: break-word;
  }
  @media (min-width: 640px) {
    .product-name {
      font-size: 1.18rem;
      margin: 4px 0 8px;
      height: 2.5em;
    }
  }
  .product-card:hover .product-name {
    color: var(--accent);
  }

  .stock-urgency {
    margin-top: 0.35rem;
    margin-bottom: 0.35rem;
  }
  @media (min-width: 640px) {
    .stock-urgency { margin-top: 0.45rem; margin-bottom: 0.45rem; }
  }

  .price-section {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .price-row {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .price-val {
    font-family: 'Jost', sans-serif;
    font-weight: 700;
    font-size: 1.12rem;
    color: #1c1917;
    white-space: nowrap;
    letter-spacing: -0.01em;
  }
  @media (min-width: 640px) {
    .price-val { font-size: 1.25rem; }
  }
  .price-val.text-violet-700 {
    color: #6d28d9;
  }

  .price-orig {
    font-family: 'Jost', sans-serif;
    font-size: 0.75rem;
    color: #a8a29e;
    text-decoration: line-through;
    white-space: nowrap;
  }
  @media (min-width: 640px) {
    .price-orig { font-size: 0.82rem; }
  }

  .save-badge {
    background: #fef2f2; 
    color: #b91c1c; 
    padding: 0.15rem 0.4rem; 
    border-radius: 6px; 
    font-size: 0.6rem; 
    font-weight: 800; 
    letter-spacing: 0.02em;
    border: 1px solid rgba(239, 68, 68, 0.18);
    white-space: nowrap;
    align-self: center;
  }
  @media (min-width: 640px) {
    .save-badge {
      padding: 0.18rem 0.45rem;
      border-radius: 6px;
      font-size: 0.65rem;
    }
  }

  /* PROPUESTA DE VALOR: ENVÍO GRATIS */
  .card-shipping {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.66rem;
    font-weight: 600;
    color: #047857;
    margin-top: 0.35rem;
    line-height: 1;
  }
  @media (min-width: 640px) {
    .card-shipping {
      font-size: 0.72rem;
      gap: 5px;
      margin-top: 0.4rem;
    }
  }

  /* BADGE EN IMAGEN (PÍLDORA LIMPIA) */
  .badges-overlay {
    position: absolute;
    top: 8px;
    left: 8px;
    max-width: calc(100% - 16px);
    z-index: 10;
    pointer-events: none;
  }
  @media (min-width: 640px) {
    .badges-overlay { top: 10px; left: 10px; max-width: calc(100% - 20px); }
  }

  .badges-overlay .p-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.22rem 0.55rem;
    font-size: 0.58rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    border-radius: 9999px;
    border: 1px solid rgba(255, 255, 255, 0.4);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    line-height: 1.2;
    white-space: nowrap;
  }
  @media (min-width: 640px) {
    .badges-overlay .p-badge {
      padding: 0.28rem 0.65rem;
      font-size: 0.65rem;
    }
  }

  .badges-overlay .p-badge.badge-custom {
    background: rgba(26, 18, 32, 0.88);
    color: #ffffff;
    border-color: rgba(245, 158, 11, 0.4);
  }

  .badges-overlay .p-badge.p-badge-oferta {
    background: rgba(220, 38, 38, 0.92);
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.5);
  }

  /* ══ AGOTADO / SE VENDIÓ ══ */
  .sold-out-overlay {
    position: absolute;
    inset: 0;
    background: rgba(240, 238, 235, 0.72);
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 25;
    border-radius: inherit;
  }

  .sold-out-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(255, 255, 255, 0.92);
    border: 1.5px solid rgba(120, 113, 108, 0.25);
    color: #78716c;
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.4rem 0.85rem;
    border-radius: 9999px;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
    backdrop-filter: blur(8px);
  }

  .sold-out-icon {
    width: 12px;
    height: 12px;
    opacity: 0.7;
    flex-shrink: 0;
  }

  /* Imagen desaturada cuando está agotado */
  .is-sold-out .main-img,
  .is-sold-out .hover-img {
    filter: grayscale(55%) brightness(0.95);
    transition: filter 0.3s ease, opacity 0.5s ease;
  }

  /* Nombre grisáceo en agotado */
  .is-sold-out .product-name {
    color: #9ca3af !important;
  }
  .is-sold-out:hover .product-name {
    color: #9ca3af !important;
  }

  /* Precio grisáceo en agotado */
  .is-sold-out .price-val {
    color: #b8b0aa !important;
  }
</style>

<script>
  function initProductCards() {
    const cards = document.querySelectorAll('.product-card.has-carousel:not([data-initialized])');
    
    cards.forEach(card => {
      const track = card.querySelector('.img-track') as HTMLElement | null;
      if (!track) return;
      
      const imgs = track.dataset.imgs?.split('|') || [];
      const mainImg = track.querySelector('.main-img') as HTMLImageElement;
      const hoverImg = track.querySelector('.hover-img') as HTMLImageElement;
      const dots = card.querySelectorAll('.dot');
      let currentIdx = 0;

      function update(idx: number) {
        currentIdx = (idx + imgs.length) % imgs.length;
        
        if (mainImg) mainImg.src = imgs[currentIdx];
        if (hoverImg) {
          hoverImg.src = imgs[(currentIdx + 1) % imgs.length];
        }
        
        dots.forEach((d, i) => d.classList.toggle('active', i === currentIdx));

        card.classList.add('user-navigating');
        const existingTimer = (card as any)._navTimer;
        clearTimeout(existingTimer);
        (card as any)._navTimer = setTimeout(() => card.classList.remove('user-navigating'), 2000);
      }

      card.querySelector('.pcard-prev')?.addEventListener('click', (e) => {
        e.preventDefault(); e.stopPropagation(); update(currentIdx - 1);
      });
      card.querySelector('.pcard-next')?.addEventListener('click', (e) => {
        e.preventDefault(); e.stopPropagation(); update(currentIdx + 1);
      });

      card.setAttribute('data-initialized', 'true');
    });
  }

  // Ejecutar en cada carga de página (soporta View Transitions)
  document.addEventListener('astro:page-load', initProductCards);
</script>
