---
import { ICONS } from '../lib/icons';

export interface Props {
  name: string;
  class?: string;
  id?: string;
  style?: string;
  'aria-label'?: string;
  'aria-hidden'?: 'true' | 'false' | boolean;
  role?: string;
}

const { 
  name, 
  class: className = '', 
  id, 
  style,
  'aria-label': ariaLabel,
  'aria-hidden': ariaHidden,
  role
} = Astro.props;

const content = ICONS[name];

if (!content) {
  console.warn(`Icon "${name}" not found in ICONS.`);
}

// Si tiene aria-label o role, no es decorativo; de lo contrario, aria-hidden="true" para cumplir WCAG
const computedAriaHidden = ariaHidden !== undefined 
  ? String(ariaHidden) 
  : (ariaLabel || role ? undefined : 'true');
---
<svg 
  xmlns="http://www.w3.org/2000/svg" 
  viewBox="0 0 24 24" 
  width="24" 
  height="24" 
  class={className} 
  id={id}
  style={style}
  fill="currentColor" 
  role={role || (ariaLabel ? 'img' : undefined)}
  aria-label={ariaLabel}
  aria-hidden={computedAriaHidden}
  set:html={content || ''} 
/>
