---
import Icon from '../Icon.astro';
---
<!-- TIENDA -->
<div class="tab-content" id="tab-tienda">
  <div class="t-card">
    <div class="t-title">☁️ Cloudinary — Subida de imágenes</div>
    <div class="t-sub">Configura tu cuenta para subir fotos directamente desde el admin.</div>
    <div class="cloudinary-config">
      <div class="cc-title"><Icon name="settings-3"  /> Credenciales de Cloudinary</div>
      <div class="cc-grid">
        <div class="cc-field"><label>Cloud Name</label><input type="text" id="ccCloudName" placeholder="mi-cuenta"></div>
        <div class="cc-field"><label>Upload Preset</label><input type="text" id="ccPreset" placeholder="nuditos_unsigned"></div>
      </div>
      <button class="cc-save" onclick="saveCloudinaryConfig()"><Icon name="save"  /> Guardar configuración</button>
    </div>
  </div>

  <div class="t-card">
    <div class="t-title">📦 Skydropx — Integración de Envíos Reales</div>
    <div class="t-sub">Ingresa tu API Key y API Secret de Skydropx para generar guías reales en tu panel.</div>
    <div class="cloudinary-config">
      <div class="cc-title"><Icon name="settings-3"  /> Credenciales de Skydropx</div>
      <div class="cc-grid" style="display:grid; grid-template-columns:1fr 1fr; gap:0.8rem; margin-top:0.5rem">
        <div class="cc-field">
          <label>API Key (Token)</label>
          <input type="password" id="skydropxApiKey" placeholder="Pega tu API Key aquí">
        </div>
        <div class="cc-field">
          <label>API Secret (Opcional)</label>
          <input type="password" id="skydropxApiSecret" placeholder="Pega tu API Secret aquí">
        </div>
      </div>
      <button class="cc-save" style="margin-top:0.8rem" onclick="saveSkydropxConfig()"><Icon name="save"  /> Guardar Credenciales Skydropx</button>
    </div>
  </div>

  <div class="t-card">
    <div class="t-title">📧 Correos Electrónicos — Resend</div>
    <div class="t-sub">Configura el envío automático de confirmaciones, guías de envío y notificaciones al taller.</div>
    <div class="cloudinary-config">
      <div class="cc-title"><Icon name="mail" /> Credenciales y Remitente</div>
      <div class="cc-grid" style="display:grid; grid-template-columns:1fr 1fr; gap:0.8rem; margin-top:0.5rem">
        <div class="cc-field" style="grid-column: 1 / -1;">
          <label>API Key de Resend (resend.com)</label>
          <div style="display:flex;gap:0.4rem;">
            <input type="password" id="resendApiKey" placeholder="re_xxxxxxxxxxxxxxxxxxxx" style="flex:1;">
            <button type="button" class="btn-vis on" style="padding:0.4rem 0.8rem;font-size:0.75rem;" onclick="togglePasswordVisibility('resendApiKey', this)">👁 Ver</button>
          </div>
        </div>
        <div class="cc-field">
          <label>Correo del Administrador (Alertas de venta)</label>
          <input type="email" id="adminEmail" placeholder="jhona@nuditos.com.co">
        </div>
        <div class="cc-field">
          <label>Remitente Oficial</label>
          <input type="text" id="emailFrom" placeholder="Nuditos Tejidos &lt;hola@nuditos.com.co&gt;">
        </div>
      </div>
      <div style="margin-top:0.6rem;font-size:0.72rem;color:var(--text-soft);line-height:1.4;">
        💡 <strong>Tip:</strong> Si aún no has verificado tu dominio en Resend, puedes usar temporalmente <code>Nuditos Tejidos &lt;onboarding@resend.dev&gt;</code> para probar.
      </div>
      <div style="display:flex;gap:0.6rem;margin-top:0.9rem;flex-wrap:wrap;">
        <button class="cc-save" onclick="saveEmailConfig()"><Icon name="save" /> Guardar Configuración de Correos</button>
        <a href="/preview-emails" target="_blank" class="btn-vis on" style="display:inline-flex;align-items:center;gap:0.4rem;text-decoration:none;padding:0.6rem 1rem;font-size:0.8rem;">
          <Icon name="eye" style="width:14px;height:14px;" /> Ver Plantillas de Correo
        </a>
      </div>

      <!-- Herramienta de Diagnóstico y Prueba en Vivo -->
      <div style="margin-top:1.2rem;padding-top:1rem;border-top:1px dashed var(--border-color,#e5e7eb);">
        <div style="font-size:0.82rem;font-weight:700;color:var(--text-dark);margin-bottom:0.4rem;">🧪 Probar Envío de Correo en Vivo</div>
        <div style="display:flex;gap:0.5rem;align-items:center;max-width:550px;">
          <input type="email" id="testEmailRecipient" placeholder="tu-correo@gmail.com" style="flex:1;padding:0.55rem 0.8rem;border:1.5px solid var(--border-color,#e5e7eb);border-radius:10px;font-size:0.82rem;outline:none;">
          <button type="button" id="btnTestEmail" class="btn-save" style="margin:0;padding:0.55rem 1.1rem;font-size:0.8rem;white-space:nowrap;" onclick="testEmailConfig()">
            <Icon name="send-plane" style="width:14px;height:14px;" /> Probar Ahora
          </button>
        </div>
        <div id="testEmailStatus" style="display:none;margin-top:0.6rem;padding:0.6rem 0.8rem;border-radius:8px;font-size:0.78rem;line-height:1.4;"></div>
      </div>
    </div>
  </div>

  <div class="t-card">
    <div class="t-title">💳 Wompi — Pasarela de pago</div>
    <div class="t-sub">Activa el botón de pago con tarjeta y PSE en el carrito.</div>
    <div class="toggle-row">
      <div>
        <div class="toggle-label">Mostrar botón web</div>
        <div class="toggle-desc">Si está apagado no se podrán realizar pagos web</div>
      </div>
      <button class="toggle" id="toggleWompi" onclick="this.classList.toggle('on')"></button>
    </div>
    
    <div class="t-field" style="margin-top:.9rem">
      <label>Llave pública Wompi</label>
      <input type="text" id="wompiKey" placeholder="pub_prod_xxxxxxxxxxxx">
    </div>
    <div class="t-field" style="margin-top:.9rem">
      <label>Secret de Integridad (Opcional - para firmas)</label>
      <input type="password" id="wompiIntegrity" placeholder="prod_integrity_xxxxxxxxxxxx">
    </div>
    <div class="t-field" style="margin-top:.9rem">
      <label>Secret de Eventos (Para Webhooks)</label>
      <input type="password" id="wompiEvents" placeholder="ev_prod_xxxxxxxxxxxx">
    </div>
  </div>

  <div class="t-card">
    <div class="t-title">📊 Meta Pixel</div>
    <div class="t-sub">Activa el seguimiento para medir tus anuncios.</div>
    <div class="toggle-row">
      <div>
        <div class="toggle-label">Meta Pixel activo</div>
        <div class="toggle-desc">Registra visitas y eventos de compra</div>
      </div>
      <button class="toggle" id="toggleMetaPixel" onclick="this.classList.toggle('on')"></button>
    </div>
    <div class="t-field" style="margin-top:.9rem">
      <label>Pixel ID</label>
      <input type="text" id="metaPixelId" placeholder="123456789012345">
    </div>
  </div>

  <div class="t-card">
    <div class="t-title">🎵 TikTok Pixel</div>
    <div class="t-sub">Activa el seguimiento en TikTok Ads.</div>
    <div class="toggle-row">
      <div>
        <div class="toggle-label">TikTok Pixel activo</div>
        <div class="toggle-desc">Registra visitas y eventos de compra en TikTok</div>
      </div>
      <button class="toggle" id="toggleTikTokPixel" onclick="this.classList.toggle('on')"></button>
    </div>
    <div class="t-field" style="margin-top:.9rem">
      <label>TikTok Pixel ID</label>
      <input type="text" id="tiktokPixelId" placeholder="PCXXXXXXXXXXXXXXXXXXXX">
    </div>
  </div>

  <div class="t-card">
    <div class="t-title">🖼️ Vista por categoría</div>
    <div class="t-sub">Elige cómo se muestran los productos de cada categoría.</div>
    <div id="catViewsList"></div>
  </div>

  <div class="t-card">
    <div class="t-title">🗄️ Supabase</div>
    <div id="sbStatus" style="background:var(--mint-light);border-radius:10px;padding:.75rem 1rem;font-size:.78rem;color:#065f46;display:flex;align-items:center;gap:.5rem">
      <span style="font-size:1rem">✅</span>
      <span>Conectado · Los cambios se guardan automáticamente</span>
    </div>
  </div>

  <div class="t-card">
    <div class="t-title">📤 Exportar datos.js</div>
    <div class="t-sub">Descarga el archivo actualizado como respaldo.</div>
    <button class="btn-save" onclick="exportDatos()"><Icon name="download"  /> Descargar datos.js</button>
  </div>
</div>
