---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import ProductCard from '../../components/ProductCard.astro';
import TrustSignalsSection from '../../components/TrustSignalsSection.astro';
import { getLiveProducts, getPublicConfig, getLiveCategories } from '../../lib/supabase';
import { slugify } from '../../data/datos';
import TestimonialsSection from '../../components/TestimonialsSection.astro';
import CountdownBanner from '../../components/CountdownBanner.astro';

const liveProducts = await getLiveProducts();
const publicConfigRaw = await getPublicConfig();
const rawCategories = await getLiveCategories();

const { slug } = Astro.params;
const SB_URL = import.meta.env.PUBLIC_SUPABASE_URL;
const SB_ANON = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
let landingData = null;

try {
  const res = await fetch(`${SB_URL}/rest/v1/landings?slug=eq.${slug}&is_active=eq.true&limit=1`, {
    headers: {
      'apikey': SB_ANON,
      'Authorization': `Bearer ${SB_ANON}`
    }
  });
  const data = await res.json();
  if (data && data.length > 0) {
    landingData = data[0];
  }
} catch (e) {
  console.error("Error fetching landing", e);
}

if (!landingData) {
  return Astro.redirect('/404');
}

const content = landingData.content || {};

const safeProducts = liveProducts.map(p => ({
  id: p.id,
  name: p.name,
  price: p.price,
  emoji: p.emoji || '',
  img: p.img || '',
  cat: p.cat || '',
  desc: p.desc || ''
}));
const safeCategories = rawCategories || [];
const publicConfig = publicConfigRaw || {};

// 1. Filtramos por la categoría específica de la landing
const rawCatSlug = (content.categorySlug || '').toLowerCase().trim();

// Normalización de categorías para compatibilidad
const normalizeCat = (cat: string) => {
  if (cat === 'girasoles') return 'flores-amarillas';
  if (cat === 'tulipanes') return 'ramos-tulipanes';
  if (cat === 'rosas') return 'ramo-rosas';
  return cat;
};

const catSlug = normalizeCat(rawCatSlug);

// 1. Filtrado riguroso: solo productos con foto activa y pertenecientes a la colección
let landingProducts: any[] = liveProducts.filter(p => {
  // Debe tener al menos una imagen válida
  const hasImg = !!(p.img || (p.imgs && p.imgs.length > 0));
  if (!hasImg) return false;

  if (!catSlug || catSlug === 'todas' || catSlug === 'todos') return true;
  const cats: string[] = [p.cat, ...(p.cats || [])].map(
    (c: string | undefined) => (c ?? '').toLowerCase().trim()
  );

  if (catSlug === 'flores-amarillas') {
    return cats.includes('flores-amarillas') || 
           cats.includes('girasoles') || 
           (p.name || '').toLowerCase().includes('girasol') || 
           (p.name || '').toLowerCase().includes('amarill') ||
           (p.name || '').toLowerCase().includes('combo flores amarillas');
  }

  return cats.includes(catSlug) || cats.includes(rawCatSlug);
});

// Para la landing del mundial, mostramos únicamente los combos (excluimos productos individuales padres)
if (catSlug === 'mundial' || slug === 'mundial') {
  landingProducts = landingProducts.filter(p => p.name.toLowerCase().includes('combo'));
}

// 2. Ordenamos: Priorizamos productos con foto de alta calidad y precio accesible
landingProducts.sort((a, b) => a.price - b.price);

// 3. Lógica de Producto de Anuncio (?hero=) o Producto Destacado
const urlHeroSlug = Astro.url.searchParams.get('hero');
let adProduct = null;

if (urlHeroSlug) {
  const adIndex = landingProducts.findIndex(p => slugify(p.name) === urlHeroSlug);
  if (adIndex > -1) {
    [adProduct] = landingProducts.splice(adIndex, 1);
    landingProducts.unshift(adProduct);
  } else {
    adProduct = liveProducts.find(p => slugify(p.name) === urlHeroSlug);
  }
} else if (catSlug === 'flores-amarillas') {
  // Orden de prioridad para destacar los ramos amarillos más icónicos y el super combo estrella
  const featuredKeywords = ['super combo', 'dos ramos', 'abejita', 'flor y miel', 'trio de girasoles', 'flores amarillas'];
  
  landingProducts.sort((a, b) => {
    const aName = (a.name || '').toLowerCase();
    const bName = (b.name || '').toLowerCase();
    
    const aRank = featuredKeywords.findIndex(kw => aName.includes(kw));
    const bRank = featuredKeywords.findIndex(kw => bName.includes(kw));
    
    if (aRank !== -1 && bRank !== -1) return aRank - bRank;
    if (aRank !== -1) return -1;
    if (bRank !== -1) return 1;
    return a.price - b.price;
  });

  // Asignar badges atractivos a los destacados
  if (landingProducts[0] && !landingProducts[0].badge) landingProducts[0].badge = 'Más pedido';
  if (landingProducts[1] && !landingProducts[1].badge) landingProducts[1].badge = 'Favorito';
  if (landingProducts[2] && !landingProducts[2].badge) landingProducts[2].badge = 'Clásico';
  if (landingProducts[3] && !landingProducts[3].badge) landingProducts[3].badge = 'Edición especial';
}

const ordenados = landingProducts;
const INITIAL_LIMIT = 4; // Mostramos exactamente los 4 ramos grandes más destacados de la categoría

// Si hay un producto del anuncio (?hero=), su foto SIEMPRE es la del hero.
// Por defecto (sin ?hero=), seleccionamos el ramo clásico "Flores Amarillas"
const floresDefault = catSlug === 'flores-amarillas'
  ? ordenados.find(p => (p.name || '').toLowerCase() === 'flores amarillas') || ordenados.find(p => (p.name || '').toLowerCase().includes('flores amarillas'))
  : null;
// Precio mínimo para el sticky CTA
const minPrice = ordenados.length > 0
  ? Math.min(...ordenados.map(p => p.price).filter(Boolean))
  : 0;

const defaultSelectedProduct = adProduct || floresDefault || ordenados[0] || null;
const defaultHeroImg: string = defaultSelectedProduct?.img || ordenados[0]?.img || '';
const heroImg: string = defaultSelectedProduct?.img || content.heroImg || defaultHeroImg;
const heroProductName: string = defaultSelectedProduct?.name || landingData.title;
const heroProductPrice: number = defaultSelectedProduct?.price || minPrice;
const heroProductId: number = defaultSelectedProduct?.id || (ordenados[0]?.id || 0);
const unboxingVideo: string = content.unboxingVideo || 'https://res.cloudinary.com/dzxgu27wr/video/upload/q_auto:best,vc_auto/v1788554686/nuditos-products/iswxjie5xmwei8o1d8nn.mp4';
const unboxingPoster: string = content.unboxingPoster || 'https://res.cloudinary.com/dzxgu27wr/video/upload/so_1,q_auto:best,f_auto/v1788554686/nuditos-products/iswxjie5xmwei8o1d8nn.jpg';

// Enlace de WhatsApp personalizado según landing y ramo seleccionado
const waMessage = content.ctaWaText || `Hola Nuditos! Quiero comprar el ramo ${heroProductName} (${heroProductPrice > 0 ? '$' + heroProductPrice.toLocaleString('es-CO') + ' COP' : ''})`;
const waUrl = `https://wa.me/573144931525?text=${encodeURIComponent(waMessage)}`;
---
<Layout
  title={`${landingData.title} | Nuditos`}
  description={content.heroSubtitle || "Ramos de crochet tejidos a mano, que nunca se marchitan. Envíos a todo Colombia."}
>

  <!-- ════════ BANNER TOP con contador ════════ -->
  <CountdownBanner 
    targetDate={content.targetDate || (slug === 'flores-amarillas' ? '2026-09-21' : '')}
    title={slug === 'flores-amarillas' ? 'Día de las Flores Amarillas' : (landingData.title || 'Colección Especial')}
    badge={slug === 'flores-amarillas' ? '21 de Septiembre' : 'Edición Limitada'}
    slug={slug}
  />

  <!-- ════════ HERO ════════ -->
  <section class="bg-white pt-0 pb-4 sm:py-6 md:py-8 px-3 sm:px-4 md:px-6 overflow-hidden relative">
    <div class="max-w-[1200px] mx-auto grid lg:grid-cols-2 gap-3 sm:gap-6 lg:gap-10 items-center">

      <!-- Imagen Hero con transición dinámica -->
      <div class="relative order-1 lg:order-2" id="heroMediaBox">
        {heroImg ? (
          <div class="aspect-[3/4] md:aspect-[4/5] rounded-2xl md:rounded-3xl overflow-hidden bg-stone-50 border border-stone-100 shadow-lg sm:shadow-xl relative">
            <img 
              id="heroMainImg"
              src={heroImg} 
              alt={heroProductName} 
              class="w-full h-full object-cover transition-opacity duration-300" 
              loading="eager" 
              fetchpriority="high" 
            />
          </div>
        ) : (
          <div class="aspect-[3/4] md:aspect-[4/5] rounded-2xl md:rounded-3xl bg-stone-50 border border-stone-100 flex items-center justify-center">
            <Icon name="plant" class="w-16 h-16 text-stone-300" />
          </div>
        )}
        <!-- Badge de estado -->
        <div class="absolute top-3.5 left-3.5 sm:top-4 sm:left-4 bg-white/95 backdrop-blur-md px-3.5 py-1.5 sm:px-4 sm:py-2 rounded-full shadow-md border border-stone-200/80">
          <span class="text-xs sm:text-sm font-bold text-stone-800 tracking-wide">Disponible</span>
        </div>
      </div>

      <!-- Texto y Confianza (Optimizado para Móvil e Impulso) -->
      <div class="order-2 lg:order-1 text-left">
        <h1 class="font-serif text-[1.65rem] sm:text-3xl md:text-5xl lg:text-6xl font-light text-slate-800 leading-[1.18] mb-2" set:html={content.heroTitle || landingData.title}></h1>

        <p class="text-slate-500 text-xs sm:text-sm md:text-base leading-relaxed mb-3 sm:mb-4 max-w-lg">
          {content.heroSubtitle || "Ramos de flores tejidas a mano en crochet que nunca se marchitan. El detalle perfecto para regalar y conservar para siempre."}
        </p>

        <!-- Pills de Confianza y Valor (Información Anterior) -->
        <div class="flex items-center gap-1.5 sm:gap-2 mb-3.5 sm:mb-4 flex-wrap">
          <span class="inline-flex items-center gap-1.5 bg-emerald-50 text-emerald-800 px-2.5 py-1 rounded-full text-[10px] sm:text-[11px] font-bold border border-emerald-200/60">
            <Icon name="truck" class="w-3.5 h-3.5 text-emerald-600" /> Envío gratis
          </span>
          <span class="inline-flex items-center gap-1.5 bg-amber-50 text-amber-900 px-2.5 py-1 rounded-full text-[10px] sm:text-[11px] font-bold border border-amber-200/60">
            <Icon name="hand-heart" class="w-3.5 h-3.5 text-amber-600" /> Hecho a mano
          </span>
          <span class="inline-flex items-center gap-1.5 bg-stone-100 text-stone-700 px-2.5 py-1 rounded-full text-[10px] sm:text-[11px] font-bold border border-stone-200">
            <Icon name="checkbox-circle" class="w-3.5 h-3.5 text-stone-600" /> Desde 2022
          </span>
        </div>

        <!-- Card Compacta del Ramo Seleccionado -->
        <div class="bg-amber-50/70 border border-amber-200/80 rounded-2xl px-3.5 py-2.5 mb-3.5 flex items-center justify-between gap-3 shadow-2xs">
          <div class="min-w-0">
            <span class="text-[9px] sm:text-[10px] font-bold text-amber-800 uppercase tracking-wider block">Ramo Destacado</span>
            <span id="heroSelectedProductName" class="font-bold text-xs sm:text-sm text-stone-900 truncate block">
              {heroProductName}
            </span>
          </div>
          <div class="text-right flex-shrink-0 flex flex-col items-end">
            <span class="inline-flex items-center gap-1 text-[9px] sm:text-[10px] font-extrabold text-amber-900 bg-amber-100/90 border border-amber-300/80 px-2.5 py-0.5 rounded-full uppercase tracking-wider mb-0.5">
              <Icon name="award" class="w-3 h-3 text-amber-700" />
              <span>Favorito • Mejor precio</span>
            </span>
            <span id="heroSelectedProductPrice" class="font-black text-xs sm:text-sm text-stone-900">
              ${heroProductPrice.toLocaleString('es-CO')}
            </span>
          </div>
        </div>

        <!-- Botones de Acción: Comprar ramo y WhatsApp -->
        <div class="flex gap-2 sm:gap-3">
          <button 
            id="btnHeroBuy" 
            type="button" 
            data-product-id={heroProductId}
            onclick="handleHeroBuy(this)"
            class="flex-1 inline-flex items-center justify-center gap-2 bg-[#1a1220] hover:bg-black text-white px-5 sm:px-7 py-3.5 sm:py-4 rounded-xl sm:rounded-2xl text-xs sm:text-sm font-bold tracking-wide transition-all shadow-lg active:scale-95 cursor-pointer relative overflow-hidden group"
          >
            <Icon name="shopping-bag-3" class="w-4 h-4 text-amber-400 group-hover:scale-110 transition-transform" />
            <span id="btnHeroBuyText">Agregar al carrito</span>
          </button>
          <a 
            id="heroWaBtn"
            href={waUrl} 
            target="_blank" 
            class="inline-flex items-center justify-center gap-1.5 sm:gap-2 bg-emerald-600 hover:bg-emerald-700 text-white px-4 sm:px-6 py-3.5 sm:py-4 rounded-xl sm:rounded-2xl text-xs sm:text-sm font-bold tracking-wide transition-all shadow-md active:scale-95 whitespace-nowrap"
          >
            <Icon name="whatsapp" class="w-4 h-4" />
            <span>WhatsApp</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════ VIDEO DE EMPAQUE & CAJAS (Cara al producto y empaque) ════════ -->
  <section class="bg-white py-6 sm:py-8 md:py-12 px-3 sm:px-4 md:px-6 border-b border-stone-100" id="section-why">
    <div class="max-w-[1200px] mx-auto">
      <div class="text-center max-w-lg mx-auto mb-5 sm:mb-7">
        <span class="inline-flex items-center bg-emerald-50 border border-emerald-200 text-emerald-800 px-3 py-1 rounded-full text-[10px] sm:text-xs font-bold uppercase tracking-wider mb-2">
          Empaque & Envíos
        </span>
        <h2 class="font-serif text-2xl sm:text-3xl md:text-4xl font-light text-slate-800 leading-tight">
          Así viaja <em class="italic text-amber-600 font-normal">tu ramo</em>
        </h2>
        <p class="text-slate-500 text-xs sm:text-sm mt-1.5 max-w-sm mx-auto">
          Cajas rígidas reforzadas y empaque premium listo para regalar en cualquier rincón de Colombia.
        </p>
      </div>

      <!-- Video y Foto de Cajas Centrado -->
      <div class="flex flex-col gap-3 max-w-[440px] md:max-w-[480px] mx-auto w-full">
        <div class="aspect-[4/5] rounded-2xl sm:rounded-3xl bg-stone-950 border border-stone-200/80 overflow-hidden shadow-lg relative group select-none" id="whyCarousel">
          
          <!-- Barra de progreso superior estilo Reel/Story -->
          <div class="absolute top-0 inset-x-0 h-1 bg-white/25 z-30 overflow-hidden">
            <div id="videoProgressBar" class="h-full bg-amber-400 transition-all duration-100 ease-linear" style="width: 0%;"></div>
          </div>

          <!-- Slide 0: Video de Empaque -->
          <div class="w-full h-full absolute inset-0 why-slide why-slide-active bg-stone-950 flex items-center justify-center overflow-hidden" data-slide-type="video">
            <video
              id="unboxingVideo"
              class="w-full h-full object-cover"
              autoplay
              loop
              muted
              playsinline
              preload="metadata"
              poster={unboxingPoster}
            >
              <source src={unboxingVideo} type="video/mp4" />
            </video>

            <!-- Botón flotante para Activar / Silenciar Sonido -->
            <button
              type="button"
              id="btnToggleAudio"
              class="absolute bottom-3 left-3 sm:bottom-4 sm:left-4 z-20 flex items-center gap-2 px-3.5 py-2 rounded-full bg-black/75 hover:bg-black/90 backdrop-blur-md text-white text-xs font-semibold tracking-wide border border-white/25 shadow-lg transition-all active:scale-95 cursor-pointer"
              title="Activar o desactivar sonido"
            >
              <span id="audioIcon" class="flex items-center justify-center">
                <Icon name="volume-up" class="w-4 h-4 text-amber-300" />
              </span>
              <span id="audioLabel">Activar sonido</span>
            </button>

            <!-- Insignia "Así empacamos tu ramo" -->
            <div class="absolute top-3 left-3 sm:top-4 sm:left-4 z-20 flex items-center gap-2 px-3 py-1.5 rounded-full bg-black/60 backdrop-blur-md text-white/95 text-[11px] font-bold tracking-wider uppercase border border-white/15 pointer-events-none shadow-sm">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
              <span class="w-2 h-2 rounded-full bg-emerald-400 -ml-4"></span>
              <span>Así empacamos tu ramo</span>
            </div>
          </div>

          <!-- Slide 1: Foto - Cajas listas para despacho -->
          <div class="w-full h-full absolute inset-0 why-slide bg-stone-950 flex items-center justify-center overflow-hidden" data-slide-type="image">
            <img
              src="https://res.cloudinary.com/dzxgu27wr/image/upload/q_auto,f_auto/v1788508133/nuditos-products/cajas-envios-nuditos-2.jpg"
              class="w-full h-full object-cover"
              alt="Envíos Nuditos - Ramos empacados en cajas rígidas"
            />
            <div class="absolute bottom-3 left-3 sm:bottom-4 sm:left-4 z-20 flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-black/75 backdrop-blur-md text-white text-xs font-medium border border-white/20 pointer-events-none shadow-md">
              <Icon name="package" class="w-3.5 h-3.5 text-amber-300 flex-shrink-0" />
              <span>Cajas rígidas listas para despacho</span>
            </div>
          </div>
        </div>

        <!-- Selector interactivo de contenido (Solo 2 pestañas: Video empaque y Cajas listas) -->
        <div class="flex items-center justify-center gap-2" id="whyTabs">
          <button
            type="button"
            class="why-tab active flex items-center gap-2 px-4 py-2 rounded-full text-xs font-bold transition-all cursor-pointer select-none"
            data-slide-index="0"
          >
            <Icon name="video" class="w-3.5 h-3.5" />
            <span>Video empaque</span>
          </button>
          <button
            type="button"
            class="why-tab flex items-center gap-2 px-4 py-2 rounded-full text-xs font-medium text-stone-600 bg-stone-100 hover:bg-stone-200/80 border border-stone-200 transition-all cursor-pointer select-none"
            data-slide-index="1"
          >
            <Icon name="package" class="w-3.5 h-3.5" />
            <span>Cajas listas</span>
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════ CATÁLOGO ════════ -->
  <section id="catalogo" class="bg-stone-50 py-6 sm:py-8 md:py-14 px-2.5 sm:px-4 md:px-6 border-t border-stone-100">
    <div class="max-w-[1400px] mx-auto">

      <!-- Encabezado de la Colección -->
      <div class="text-center max-w-lg mx-auto mb-6 sm:mb-8">
        <span class="inline-flex items-center bg-amber-100/70 border border-amber-300/60 text-amber-900 px-3 py-1 rounded-full text-[10px] sm:text-xs font-bold uppercase tracking-wider mb-2">
          {slug === 'flores-amarillas' ? 'Edición 21 de Septiembre' : 'Colección Destacada'}
        </span>
        <h2 class="font-serif text-2xl sm:text-3xl md:text-4xl font-light text-slate-800 leading-tight">
          Ramos <em class="italic text-amber-600 font-normal">más pedidos</em>
        </h2>
        <p class="text-slate-500 text-xs sm:text-sm mt-1.5 max-w-sm mx-auto">
          Tejidos a mano con amor. Elige tu favorito para regalar un detalle que dura para siempre.
        </p>
      </div>

      {ordenados.length > 0 ? (
        <>
          <div id="catalogGrid" class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6 md:gap-8 max-w-[480px] md:max-w-[960px] mx-auto">
            {ordenados.map((p, i) => (
              <div class:list={["product-col-item", { "hidden-card": i >= INITIAL_LIMIT }]}>
                <ProductCard p={p} idScope="madre-boutique" parentView="grid" eager={i < 4} showScarcity={true} />
              </div>
            ))}
          </div>

          {ordenados.length > INITIAL_LIMIT && (
            <div class="text-center mt-6 sm:mt-8" id="loadMoreContainer">
              <button 
                id="btnLoadMore" 
                type="button"
                class="inline-flex items-center gap-2 bg-white hover:bg-stone-50 text-slate-800 border border-stone-300 font-bold px-6 py-3 rounded-2xl text-xs tracking-wide shadow-sm hover:shadow transition-all active:scale-95 cursor-pointer"
              >
                <Icon name="grid" class="w-3.5 h-3.5 text-amber-600" />
                <span>Ver más ramos ({ordenados.length - INITIAL_LIMIT} más)</span>
              </button>
              <div class="mt-2 text-[10px] text-stone-400 font-medium">
                Mostrando {INITIAL_LIMIT} de {ordenados.length} ramos
              </div>
            </div>
          )}
        </>
      ) : (
        <div class="text-center py-12 sm:py-16">
          <Icon name="plant" class="w-10 h-10 sm:w-12 sm:h-12 text-stone-300 mx-auto mb-3" />
          <p class="text-stone-400 text-xs sm:text-sm mb-4 sm:mb-6">Próximamente disponibles</p>
          <a href="https://wa.me/573144931525" target="_blank" class="inline-flex items-center gap-2 bg-green-500 text-white px-6 sm:px-8 py-3.5 sm:py-4 rounded-xl sm:rounded-2xl text-[11px] sm:text-xs font-bold tracking-wide hover:bg-green-600 transition shadow-md">
            <Icon name="whatsapp" class="w-4 h-4" /> Consultar disponibilidad
          </a>
        </div>
      )}
    </div>
  </section>

  <!-- ════════ CLIENTES FELICES (Testimonios Dinámicos) ════════ -->
  <TestimonialsSection />

  <!-- ════════ POR QUÉ ELEGIR NUDITOS (Beneficios del Producto) ════════ -->
  <section class="bg-stone-50/70 py-8 sm:py-10 md:py-14 px-3 sm:px-4 md:px-6 border-t border-stone-100" id="section-beneficios">
    <div class="max-w-[1000px] mx-auto">
      <!-- Header -->
      <div class="text-center max-w-lg mx-auto mb-6 sm:mb-8">
        <span class="inline-flex items-center bg-emerald-50 border border-emerald-200 text-emerald-800 px-3 py-1 rounded-full text-[10px] sm:text-xs font-bold uppercase tracking-wider mb-2">
          ¿Por qué elegir Nuditos?
        </span>
        <h2 class="font-serif text-2xl sm:text-3xl md:text-4xl font-light text-slate-800 leading-tight">
          Flores que <em class="italic text-amber-600 font-normal">nunca mueren</em>
        </h2>
        <p class="text-slate-500 text-xs sm:text-sm mt-1.5 max-w-sm mx-auto">
          Elaboradas en crochet de alta calidad para conservar tus momentos especiales para siempre.
        </p>
      </div>

      <!-- Beneficios en tarjetas limpias estilo screenshot -->
      <div class="grid md:grid-cols-2 gap-3 sm:gap-4 max-w-[880px] mx-auto">
        <div class="flex items-start gap-3.5 sm:gap-4 p-4 sm:p-5 bg-white rounded-2xl border border-stone-200/70 shadow-xs hover:border-amber-200 hover:shadow-sm transition-all">
          <div class="w-10 h-10 sm:w-11 sm:h-11 rounded-2xl bg-amber-100/70 flex items-center justify-center flex-shrink-0">
            <Icon name="star" class="w-5 h-5 text-amber-500" />
          </div>
          <div class="min-w-0">
            <div class="text-[13px] sm:text-sm font-bold text-slate-800 mb-1">Durabilidad infinita</div>
