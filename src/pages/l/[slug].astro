  <!-- ════════ STICKY CTA BAR (Mobile/Desktop) ════════ -->
  <div
    id="stickyCTA"
    class="fixed bottom-[68px] md:bottom-8 left-0 md:left-1/2 md:-translate-x-1/2 w-full md:w-[94%] md:max-w-[500px] z-[1600] bg-white/90 md:bg-white/95 backdrop-blur-xl md:backdrop-blur-2xl border-t md:border border-stone-100 shadow-[0_-10px_30px_rgba(0,0,0,0.05)] md:shadow-[0_20px_50px_rgba(0,0,0,0.2)] p-4 md:p-2.5 md:rounded-[2.5rem] transition-all duration-700 ease-[cubic-bezier(0.23,1,0.32,1)] translate-y-[150%] opacity-0 pointer-events-none"
  >
    <div class="flex items-center gap-4 md:gap-3 max-w-[500px] mx-auto md:mx-0">
