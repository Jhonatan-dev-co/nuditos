      <div class="flex-1 min-w-0">
        <div class="text-[10px] font-bold text-stone-400 uppercase tracking-[0.2em] truncate mb-0.5">
          {slug === 'mundial' ? 'Mes del Mundial ⚽' : (content.heroBadge || 'Nuditos')}
        </div>
        <div class="text-sm md:text-base font-bold text-violet-600">
          Desde <span class="font-sans">${new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', maximumFractionDigits: 0 }).format(minPrice)}</span>
        </div>
      </div>

      <!-- Botón -->
      <a
        href="#catalogo"
        class="bg-[#1a1220] text-white px-6 md:px-8 py-3.5 rounded-xl md:rounded-full text-[10px] font-bold uppercase tracking-widest hover:bg-black active:scale-95 transition-all shadow-lg flex items-center gap-2"
      >
        <Icon name="grid" class="text-sm" /> Elegir ramo
      </a>
    </div>
  </div>

  <style>
    html { scroll-behavior: smooth; }
    
    #stickyCTA {
      will-change: transform, opacity;
    }

    /* Clase activa para mostrar el CTA */
    #stickyCTA.is-visible {
      transform: translate(0, 0);
      opacity: 1;
      pointer-events: auto;
    }

    @media (min-width: 768px) {
      #stickyCTA.is-visible {
        transform: translate(-50%, 0);
      }
    }

    /* Ocultar el WA flotante global en móvil cuando este CTA es visible */
    @media (max-width: 768px) {
      :global(body:has(#stickyCTA.is-visible) .wa-float) {
        opacity: 0 !important;
        transform: scale(0) !important;
        pointer-events: none !important;
      }
    }

    /* ─── Countdown Clock Styles ─── */
    .cd-unit {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1px;
    }

    .cd-digit {
      background: rgba(255, 255, 255, 0.1);
      backdrop-filter: blur(4px);
      color: #fff;
      font-family: 'SF Mono', 'Cascadia Code', 'Consolas', monospace;
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 0.05em;
      padding: 2px 6px;
      border-radius: 4px;
      min-width: 28px;
      text-align: center;
      font-variant-numeric: tabular-nums;
      border: 1px solid rgba(167, 139, 250, 0.2);
    }

    .cd-label {
      font-size: 7px;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: rgba(196, 181, 253, 0.6);
      font-weight: 500;
    }

    #cdSecs {
      animation: cdPulse 1s ease-in-out infinite;
    }

    @keyframes cdPulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.7; }
    }

    /* ─── Why Nuditos Carousel ─── */
    .why-slide {
      opacity: 0;
      transition: opacity 1.2s ease-in-out;
    }

    .why-slide-active {
      opacity: 1;
    }
  </style>

  <script is:inline set:html={`
    window.NUDITOS_LIVE_PRODUCTS = ${JSON.stringify(safeProducts)}; 
    window.NUDITOS_CATEGORIES = ${JSON.stringify(safeCategories)}; 
    window.NUDITOS_LIVE_CONFIG = ${JSON.stringify(publicConfig)};
    window.LANDING_DATA = {
      targetDate: "${content.targetDate || ''}",
      heroBadge: "${content.heroBadge || ''}",
      title: "${landingData.title || ''}"
    };
  `} />

  <script is:inline>
    (function() {
      // 1. Countdown Logic
      var targetDateStr = window.LANDING_DATA.targetDate;
      if (!targetDateStr) return;
      
      var target = new Date(targetDateStr + 'T23:59:59-05:00').getTime();
      function updateCountdown() {
        var now = Date.now();
        var diff = target - now;
        var dEl = document.getElementById('cdDays');
        var hEl = document.getElementById('cdHours');
        var mEl = document.getElementById('cdMins');
        var sEl = document.getElementById('cdSecs');
        if (!dEl) return;
        if (diff <= 0) {
          var banner = document.getElementById('madreCountdown');
          if (banner) banner.parentElement.innerHTML = '<span class="text-rose-800 font-bold">' + (window.LANDING_DATA.heroBadge || window.LANDING_DATA.title) + ' — ¡Aprovecha ahora!</span>';
          return;
        }
        var days  = Math.floor(diff / (1000 * 60 * 60 * 24));
        var hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        var mins  = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
        var secs  = Math.floor((diff % (1000 * 60)) / 1000);
        
        dEl.textContent = String(days).padStart(2, '0');
        hEl.textContent = String(hours).padStart(2, '0');
        mEl.textContent = String(mins).padStart(2, '0');
        if (sEl) {
          sEl.textContent = String(secs).padStart(2, '0');
        }
      }
      updateCountdown();
      var intervalTime = document.getElementById('cdSecs') ? 1000 : 60000;
      setInterval(updateCountdown, intervalTime);

      // 2. Sticky CTA visibility logic
      const stickyCTA = document.getElementById('stickyCTA');
      const showThreshold = 600; // Pixeles de scroll para mostrar
      
      window.addEventListener('scroll', () => {
        if (window.scrollY > showThreshold) {
          stickyCTA.classList.add('is-visible');
        } else {
          stickyCTA.classList.remove('is-visible');
        }
      }, { passive: true });
      // 3. Why Nuditos carousel
      var slides = document.querySelectorAll('.why-slide');
      if (slides.length > 1) {
        var current = 0;
        setInterval(function() {
          slides[current].classList.remove('why-slide-active');
          current = (current + 1) % slides.length;
          slides[current].classList.add('why-slide-active');
        }, 4000);
      }
    })();
  </script>
</Layout>
