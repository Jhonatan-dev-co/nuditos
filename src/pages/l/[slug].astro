      <!-- Botón Comprar en Sticky -->
      <button 
        id="btnStickyBuy"
        type="button" 
        data-product-id={heroProductId}
        onclick="handleHeroBuy(this)"
        class="bg-[#1a1220] hover:bg-black text-white px-4 sm:px-6 py-2.5 sm:py-3 rounded-xl sm:rounded-full text-xs font-bold tracking-wide active:scale-95 transition-all shadow-md flex items-center gap-1.5 flex-shrink-0 whitespace-nowrap cursor-pointer"
      >
        <Icon name="shopping-bag-3" class="w-3.5 h-3.5 text-amber-400" />
        <span id="btnStickyBuyText">Agregar al carrito</span>
      </button>
    </div>
  </div>

  <style>
    html { scroll-behavior: smooth; }
    
    /* Estilo base estándar para Android, Windows y otros navegadores */
    #stickyCTA { 
      will-change: transform, opacity; 
      background-color: #ffffff;
      border-color: rgba(231, 229, 228, 0.95);
      box-shadow: 0 -8px 24px rgba(0, 0, 0, 0.08), 0 2px 8px rgba(0, 0, 0, 0.04);
      z-index: 50 !important;
    }
    #stickyCTA.is-visible { transform: translate(0, 0); opacity: 1; pointer-events: auto; }
    @media (min-width: 768px) { 
      #stickyCTA.is-visible { transform: translate(-50%, 0); } 
      #stickyCTA {
        box-shadow: 0 16px 45px rgba(0, 0, 0, 0.14);
      }
    }

    /* Ocultar y enviar al fondo cuando el carrito esté abierto */
    :global(body.scroll-lock) #stickyCTA,
    :global(body:has(#cartPanel.open)) #stickyCTA,
    :global(body:has(#cartOverlay.open)) #stickyCTA {
      opacity: 0 !important;
      pointer-events: none !important;
      transform: translateY(150%) !important;
      z-index: -1 !important;
      display: none !important;
    }

    /* Efecto Glassmorphism exclusivo para iPhone, iPad y Mac */
    :global(html.is-apple) #stickyCTA {
      background-color: rgba(255, 255, 255, 0.82) !important;
      -webkit-backdrop-filter: blur(20px) saturate(180%);
      backdrop-filter: blur(20px) saturate(180%);
      border-color: rgba(255, 255, 255, 0.6) !important;
      box-shadow: 0 -8px 28px rgba(0, 0, 0, 0.08), 0 1px 0 rgba(255, 255, 255, 0.7) inset !important;
    }
    @media (min-width: 768px) {
      :global(html.is-apple) #stickyCTA {
        background-color: rgba(255, 255, 255, 0.86) !important;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.16), 0 1px 0 rgba(255, 255, 255, 0.8) inset !important;
      }
    }

    @media (max-width: 768px) {
      :global(body:has(#stickyCTA.is-visible) .wa-float) {
        opacity: 0 !important; transform: scale(0) !important; pointer-events: none !important;
      }
    }

    /* Countdown */
    .cd-unit { display: flex; flex-direction: column; align-items: center; gap: 1px; }
    .cd-digit {
      background: rgba(255,255,255,0.1); backdrop-filter: blur(4px); color: #fff;
      font-family: 'SF Mono','Cascadia Code','Consolas',monospace; font-size: 13px; font-weight: 700;
      letter-spacing: .05em; padding: 2px 6px; border-radius: 4px; min-width: 28px;
      text-align: center; font-variant-numeric: tabular-nums; border: 1px solid rgba(167,139,250,.2);
    }
    .cd-label { font-size: 7px; text-transform: uppercase; letter-spacing: .12em; color: rgba(196,181,253,.6); font-weight: 500; }
    #cdSecs { animation: cdPulse 1s ease-in-out infinite; }
    @keyframes cdPulse { 0%,100%{opacity:1} 50%{opacity:.7} }

    /* Carousel & Video Unboxing */
    .why-slide { opacity: 0; transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1); pointer-events: none; }
    .why-slide-active { opacity: 1; pointer-events: auto; }
    .why-tab.active {
      background-color: #d97706 !important;
      color: #ffffff !important;
      border-color: #d97706 !important;
      box-shadow: 0 2px 6px rgba(217, 119, 6, 0.35);
    }

    /* FAQ Accordion */
    details summary { list-style: none; }
    details summary::-webkit-details-marker { display: none; }
    details[open] > summary { background-color: rgba(0,0,0,0.01); }
    details > p { animation: faqSlide 0.2s ease-out; }
    @keyframes faqSlide { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: translateY(0); } }

    /* Optimal Cards View */
    .hidden-card { display: none !important; }
    .fade-in { animation: fadeInCard 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
    @keyframes fadeInCard {
      from { opacity: 0; transform: translateY(12px); }
      to { opacity: 1; transform: translateY(0); }
    }
  </style>

  <script is:inline set:html={`
    window.NUDITOS_LIVE_PRODUCTS = ${JSON.stringify(safeProducts)}; 
    window.NUDITOS_CATEGORIES = ${JSON.stringify(safeCategories)}; 
    window.NUDITOS_LIVE_CONFIG = ${JSON.stringify(publicConfig)};
    window.LANDING_DATA = {
      targetDate: "${content.targetDate || (slug === 'flores-amarillas' ? '2026-09-21' : '')}",
      title: "${landingData.title || ''}",
      catSlug: "${catSlug || ''}"
    };
  `} />

  <script is:inline>
    // Detección de dispositivos Apple (iOS / macOS) para el efecto Glassmorphism
    (function() {
      var isApple = /iPad|iPhone|iPod|Macintosh/.test(navigator.userAgent) && !window.MSStream;
      if (isApple) {
        document.documentElement.classList.add('is-apple');
      }
    })();

    // Selector dinámico de producto para el Hero
    window.selectProductForHero = function(productId, scrollIntoView) {
      var prods = window.NUDITOS_LIVE_PRODUCTS || [];
      var p = prods.find(function(item) { return item.id === productId; });
      if (!p) return;

      // 1. Imagen con suave transición de opacidad
      var heroImg = document.getElementById('heroMainImg');
      if (heroImg && p.img) {
        heroImg.style.opacity = '0.2';
        setTimeout(function() {
          heroImg.src = p.img;
          heroImg.alt = p.name;
          heroImg.style.opacity = '1';
        }, 120);
      }

      // 2. Nombre del producto
      var nameEl = document.getElementById('heroSelectedProductName');
      if (nameEl) nameEl.textContent = p.name;

      // 3. Precio
      var priceEl = document.getElementById('heroSelectedProductPrice');
      if (priceEl && p.price) {
        priceEl.textContent = '$' + p.price.toLocaleString('es-CO');
      }

      // 4. Botón Comprar
      var buyBtn = document.getElementById('btnHeroBuy');
      if (buyBtn) {
        buyBtn.setAttribute('data-product-id', String(p.id));
      }

      // 5. Botón WhatsApp
      var waBtn = document.getElementById('heroWaBtn');
      if (waBtn) {
        var msg = 'Hola Nuditos! Quiero comprar el ramo ' + p.name + ' ($' + p.price.toLocaleString('es-CO') + ' COP)';
        waBtn.href = 'https://wa.me/573144931525?text=' + encodeURIComponent(msg);
      }

      // 6. Resaltar botón en el mini selector del Hero
      document.querySelectorAll('.hero-thumb-btn').forEach(function(btn) {
        var pid = Number(btn.getAttribute('data-product-id'));
        if (pid === p.id) {
          btn.classList.add('border-amber-500', 'bg-white', 'shadow-sm', 'ring-2', 'ring-amber-400/50');
          btn.classList.remove('border-stone-200/80', 'bg-white/70');
        } else {
          btn.classList.remove('border-amber-500', 'bg-white', 'shadow-sm', 'ring-2', 'ring-amber-400/50');
          btn.classList.add('border-stone-200/80', 'bg-white/70');
        }
      });

      // 7. Sincronizar barra Sticky CTA para móvil
      var stickyImg = document.getElementById('stickyProductImg');
      if (stickyImg && p.img) stickyImg.src = p.img;
      var stickyName = document.getElementById('stickyProductName');
      if (stickyName) stickyName.textContent = p.name;
      var stickyPrice = document.getElementById('stickyProductPrice');
      if (stickyPrice && p.price) stickyPrice.textContent = '$' + p.price.toLocaleString('es-CO');
      var stickyBuy = document.getElementById('btnStickyBuy');
      if (stickyBuy) stickyBuy.setAttribute('data-product-id', String(p.id));

      if (scrollIntoView) {
        var heroBox = document.getElementById('heroMediaBox');
        if (heroBox) heroBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    };

    // Manejador del botón Agregar al Carrito con apertura garantizada del panel
    window.handleHeroBuy = function(btn) {
      var id = Number(btn.getAttribute('data-product-id')) || 138;

      // 1. Feedback visual inmediato en el botón pulsado
      var textSpan = btn.querySelector('#btnHeroBuyText, #btnStickyBuyText');
      if (!textSpan) textSpan = btn.querySelector('span:last-of-type');
      var originalText = textSpan ? textSpan.textContent : 'Agregar al carrito';
      btn.classList.add('bg-emerald-600', 'scale-[1.02]');
      btn.classList.remove('bg-[#1a1220]', 'hover:bg-black');
      if (textSpan) textSpan.textContent = '¡Agregado!';

      setTimeout(function() {
        btn.classList.remove('bg-emerald-600', 'scale-[1.02]');
        btn.classList.add('bg-[#1a1220]', 'hover:bg-black');
        if (textSpan) textSpan.textContent = originalText;
      }, 1200);

      // 2. Localizar producto en los datos live o construir fallback confiable
      var prods = window.NUDITOS_LIVE_PRODUCTS || [];
      var p = prods.find(function(item) { return Number(item.id) === id; });
      
      if (!p) {
        // Fallback: construir producto desde el DOM
        var nameEl = document.getElementById('heroSelectedProductName');
        var priceEl = document.getElementById('heroSelectedProductPrice');
        var imgEl = document.getElementById('heroMainImg');
        var priceNum = priceEl ? Number(priceEl.textContent.replace(/[^\d]/g, '')) : 81000;
        p = {
          id: id,
          name: (nameEl && nameEl.textContent) ? nameEl.textContent.trim() : 'Flores amarillas',
          price: priceNum || 81000,
          img: imgEl ? imgEl.src : '',
          emoji: '🌸'
        };
      }

      // 3. Ejecutar agregar al carrito (addToCart se encarga de abrir el panel)
      function doAdd() {
        if (typeof window.addToCart === 'function') {
          window.addToCart(p);
        } else {
          setTimeout(doAdd, 50);
        }
      }
      doAdd();
    };

    (function() {
      // 1. Sticky CTA
      var stickyCTA = document.getElementById('stickyCTA');
      window.addEventListener('scroll', function() {
        if (window.scrollY > 500) stickyCTA.classList.add('is-visible');
        else stickyCTA.classList.remove('is-visible');
      }, { passive: true });

      // 2. Click en tarjetas del catálogo para cambiar el ramo en el hero
      document.querySelectorAll('.product-col-item').forEach(function(item) {
        var card = item.querySelector('.product-card');
        if (!card) return;
        var idMatch = (card.getAttribute('id') || '').match(/pcard-(\d+)/);
        if (idMatch && idMatch[1]) {
          var productId = Number(idMatch[1]);
          card.addEventListener('click', function(e) {
            if (e.target.closest('.quick-add') || e.target.closest('.pcard-nav')) return;
            window.selectProductForHero(productId, false);
          });
        }
      });

      // 3. Why Nuditos carousel + Interactive Video (Opción 1)
      var whyCarousel = document.getElementById('whyCarousel');
      var whySection = document.getElementById('section-why');
      var unboxingVideo = document.getElementById('unboxingVideo');
      var btnToggleAudio = document.getElementById('btnToggleAudio');
      var audioIcon = document.getElementById('audioIcon');
      var audioLabel = document.getElementById('audioLabel');
      var slides = document.querySelectorAll('.why-slide');
      var tabs = document.querySelectorAll('.why-tab');

      var currentIndex = 0;
      var slideTimeout = null;
      var isHoveringOrWatching = false;
      var isAudioActive = false;

      function updateTabs(index) {
        tabs.forEach(function(tab, i) {
          if (i === index) {
            tab.classList.add('active');
            tab.classList.remove('bg-stone-100', 'text-stone-600', 'border-stone-200');
          } else {
            tab.classList.remove('active');
            tab.classList.add('bg-stone-100', 'text-stone-600', 'border-stone-200');
          }
        });
      }

      function goToSlide(index, manualClick) {
        if (index < 0 || index >= slides.length) return;
        clearTimeout(slideTimeout);

        slides.forEach(function(s, i) {
          if (i === index) {
            s.classList.add('why-slide-active');
          } else {
            s.classList.remove('why-slide-active');
          }
        });

        currentIndex = index;
        updateTabs(index);

        if (index === 0) {
          // Slide de video
          if (unboxingVideo) {
            var playPromise = unboxingVideo.play();
            if (playPromise !== undefined) {
              playPromise.catch(function() {});
            }
          }
          // Si el usuario activó sonido, dio clic manual al tab o está interactuando fijamente, NO rotar
          if (isAudioActive || (manualClick && index === 0) || isHoveringOrWatching) {
            return;
          }
          // Rotación normal: dura 6.5s en el video antes de pasar a la foto
          slideTimeout = setTimeout(function() {
            if (!isHoveringOrWatching && !isAudioActive) {
              goToSlide(1);
            }
          }, 6500);
        } else {
          // Slide de foto: pausamos el video para liberar CPU
          if (unboxingVideo && !unboxingVideo.paused) {
            unboxingVideo.pause();
          }
          // Cada foto dura 4.2s
          slideTimeout = setTimeout(function() {
            if (!isHoveringOrWatching && !isAudioActive) {
              var next = (currentIndex + 1) % slides.length;
              goToSlide(next);
            }
          }, 4200);
        }
      }

      // Toggle Sonido con Iconos SVG
      var svgVolumeUp = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" fill="currentColor" class="w-4 h-4 text-amber-300"><path d="M13 3.00005L6.41421 9.00005H2V15H6.41421L13 21V3.00005ZM16.5 12C16.5 10.23 15.48 8.71 14 7.97V16.02C15.48 15.29 16.5 13.77 16.5 12ZM14 3.23V5.29C16.89 6.15 19 8.83 19 12C19 15.17 16.89 17.85 14 18.71V20.77C18.01 19.86 21 16.28 21 12C21 7.72 18.01 4.14 14 3.23Z"></path></svg>';
      var svgVolumeMute = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" fill="currentColor" class="w-4 h-4 text-stone-300"><path d="M13 3.00005L6.41421 9.00005H2V15H6.41421L13 21V3.00005ZM17.7782 12L19.8995 9.87873L18.4853 8.46452L16.364 10.5858L14.2426 8.46452L12.8284 9.87873L14.9497 12L12.8284 14.1214L14.2426 15.5356L16.364 13.4143L18.4853 15.5356L19.8995 14.1214L17.7782 12Z"></path></svg>';

      if (btnToggleAudio && unboxingVideo) {
        btnToggleAudio.addEventListener('click', function(e) {
          e.stopPropagation();
          if (unboxingVideo.muted) {
            unboxingVideo.muted = false;
            isAudioActive = true;
            if (audioIcon) audioIcon.innerHTML = svgVolumeMute;
            if (audioLabel) audioLabel.textContent = 'Silenciar';
            // Al activar sonido, detenemos la rotación para que escuche y vea el video completo
            clearTimeout(slideTimeout);
            unboxingVideo.play().catch(function() {});
          } else {
            unboxingVideo.muted = true;
            isAudioActive = false;
            if (audioIcon) audioIcon.innerHTML = svgVolumeUp;
            if (audioLabel) audioLabel.textContent = 'Activar sonido';
          }
        });
      }

      // Barra de progreso superior del video unboxing
      if (unboxingVideo) {
        var videoProgressBar = document.getElementById('videoProgressBar');
        unboxingVideo.addEventListener('timeupdate', function() {
          if (videoProgressBar && unboxingVideo.duration) {
            videoProgressBar.style.width = (unboxingVideo.currentTime / unboxingVideo.duration * 100) + '%';
          }
        });
      }

      // Si termina el video
      if (unboxingVideo) {
        unboxingVideo.addEventListener('ended', function() {
          if (!isHoveringOrWatching && !isAudioActive) {
            goToSlide(1);
          }
        });
      }

      // Detección cuando el cliente mira fijamente (hover en PC o toque en móvil)
      if (whyCarousel) {
        whyCarousel.addEventListener('mouseenter', function() {
          if (currentIndex === 0) {
            isHoveringOrWatching = true;
            clearTimeout(slideTimeout);
          }
        });
        whyCarousel.addEventListener('mouseleave', function() {
          if (currentIndex === 0) {
            isHoveringOrWatching = false;
            if (!isAudioActive) {
              slideTimeout = setTimeout(function() {
                if (!isHoveringOrWatching && !isAudioActive) {
                  goToSlide(1);
                }
              }, 3000);
            }
          }
        });
        whyCarousel.addEventListener('touchstart', function() {
          if (currentIndex === 0) {
            isHoveringOrWatching = true;
            clearTimeout(slideTimeout);
          }
        }, { passive: true });
      }

      // Click en pestañas
      tabs.forEach(function(tab) {
        tab.addEventListener('click', function() {
          var targetIndex = Number(tab.getAttribute('data-slide-index') || '0');
          goToSlide(targetIndex, true);
        });
      });

      // IntersectionObserver: Cada vez que el usuario vuelve a la sección,
      // actualiza automáticamente al video (Slide 0) para intentar que el cliente vea el video
      if (whySection && 'IntersectionObserver' in window) {
        var observer = new IntersectionObserver(function(entries) {
          entries.forEach(function(entry) {
            if (entry.isIntersecting) {
              goToSlide(0);
            } else {
              if (unboxingVideo && !unboxingVideo.paused) {
                unboxingVideo.pause();
              }
            }
          });
        }, { threshold: 0.25 });
        observer.observe(whySection);
      } else {
        goToSlide(0);
      }

      // 4. Load More cards expander
      var btnLoadMore = document.getElementById('btnLoadMore');
      if (btnLoadMore) {
        btnLoadMore.addEventListener('click', function() {
          var hiddenCards = document.querySelectorAll('.hidden-card');
          hiddenCards.forEach(function(card) {
            card.classList.remove('hidden-card');
            card.classList.add('fade-in');
          });
          var container = document.getElementById('loadMoreContainer');
          if (container) {
            container.innerHTML = '<a href="/catalogo?categoria=' + encodeURIComponent(window.LANDING_DATA.catSlug || '') + '" class="inline-flex items-center gap-1.5 text-xs font-bold text-stone-600 hover:text-stone-900 border border-stone-200 bg-white px-5 py-2.5 rounded-xl shadow-xs transition-colors">Explorar todo el catálogo &rarr;</a>';
          }
        });
      }
    })();
  </script>
</Layout>

