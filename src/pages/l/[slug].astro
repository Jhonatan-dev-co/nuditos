---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import ProductCard from '../../components/ProductCard.astro';
import TrustSignalsSection from '../../components/TrustSignalsSection.astro';
import { getLiveProducts, getPublicConfig, getLiveCategories } from '../../lib/supabase';
import { slugify } from '../../data/datos';
import TestimonialsSection from '../../components/TestimonialsSection.astro';
import CountdownBanner from '../../components/CountdownBanner.astro';

const liveProducts = await getLiveProducts();
const publicConfigRaw = await getPublicConfig();
const rawCategories = await getLiveCategories();

const { slug } = Astro.params;
const SB_URL = import.meta.env.PUBLIC_SUPABASE_URL;
const SB_ANON = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
let landingData = null;

try {
  const res = await fetch(`${SB_URL}/rest/v1/landings?slug=eq.${slug}&is_active=eq.true&limit=1`, {
    headers: {
      'apikey': SB_ANON,
      'Authorization': `Bearer ${SB_ANON}`
    }
  });
  const data = await res.json();
  if (data && data.length > 0) {
    landingData = data[0];
  }
} catch (e) {
  console.error("Error fetching landing", e);
}

if (!landingData) {
  return Astro.redirect('/404');
}

const content = landingData.content || {};

const safeProducts = liveProducts.map(p => ({
  id: p.id,
  name: p.name,
  price: p.price,
  emoji: p.emoji || '',
  img: p.img || '',
  cat: p.cat || '',
  desc: p.desc || ''
}));
const safeCategories = rawCategories || [];
const publicConfig = publicConfigRaw || {};

// 1. Filtramos por la categoría específica de la landing
const rawCatSlug = (content.categorySlug || '').toLowerCase().trim();

// Normalización de categorías para compatibilidad
const normalizeCat = (cat: string) => {
  if (cat === 'girasoles') return 'flores-amarillas';
  if (cat === 'tulipanes') return 'ramos-tulipanes';
  if (cat === 'rosas') return 'ramo-rosas';
  return cat;
};

const catSlug = normalizeCat(rawCatSlug);

// 1. Filtrado riguroso: solo productos con foto activa y pertenecientes a la colección
let landingProducts: any[] = liveProducts.filter(p => {
  // Debe tener al menos una imagen válida
  const hasImg = !!(p.img || (p.imgs && p.imgs.length > 0));
  if (!hasImg) return false;

  if (!catSlug || catSlug === 'todas' || catSlug === 'todos') return true;
  const cats: string[] = [p.cat, ...(p.cats || [])].map(
    (c: string | undefined) => (c ?? '').toLowerCase().trim()
  );

  if (catSlug === 'flores-amarillas') {
    return cats.includes('flores-amarillas') || 
           cats.includes('girasoles') || 
           (p.name || '').toLowerCase().includes('girasol') || 
           (p.name || '').toLowerCase().includes('amarill') ||
           (p.name || '').toLowerCase().includes('combo flores amarillas');
  }

  return cats.includes(catSlug) || cats.includes(rawCatSlug);
});

// Para la landing del mundial, mostramos únicamente los combos (excluimos productos individuales padres)
if (catSlug === 'mundial' || slug === 'mundial') {
  landingProducts = landingProducts.filter(p => p.name.toLowerCase().includes('combo'));
}

// 2. Ordenamos: Priorizamos productos con foto de alta calidad y precio accesible
landingProducts.sort((a, b) => a.price - b.price);

// 3. Lógica de Producto de Anuncio (?hero=) o Producto Destacado
const urlHeroSlug = Astro.url.searchParams.get('hero');
let adProduct = null;

if (urlHeroSlug) {
  const adIndex = landingProducts.findIndex(p => slugify(p.name) === urlHeroSlug);
  if (adIndex > -1) {
    [adProduct] = landingProducts.splice(adIndex, 1);
    landingProducts.unshift(adProduct);
  } else {
    adProduct = liveProducts.find(p => slugify(p.name) === urlHeroSlug);
  }
} else if (catSlug === 'flores-amarillas') {
  // Orden de prioridad para destacar los 4 ramos amarillos más icónicos y vendidos
  const featuredKeywords = ['abejita', 'flor y miel', 'trio de girasoles', 'flores amarillas'];
  
  landingProducts.sort((a, b) => {
    const aName = (a.name || '').toLowerCase();
    const bName = (b.name || '').toLowerCase();
    
    const aRank = featuredKeywords.findIndex(kw => aName.includes(kw));
    const bRank = featuredKeywords.findIndex(kw => bName.includes(kw));
    
    if (aRank !== -1 && bRank !== -1) return aRank - bRank;
    if (aRank !== -1) return -1;
    if (bRank !== -1) return 1;
    return a.price - b.price;
  });

  // Asignar badges atractivos a los destacados
  if (landingProducts[0] && !landingProducts[0].badge) landingProducts[0].badge = 'Más pedido';
  if (landingProducts[1] && !landingProducts[1].badge) landingProducts[1].badge = 'Favorito';
  if (landingProducts[2] && !landingProducts[2].badge) landingProducts[2].badge = 'Clásico';
  if (landingProducts[3] && !landingProducts[3].badge) landingProducts[3].badge = 'Edición especial';
}

const ordenados = landingProducts;
const INITIAL_LIMIT = 4; // Mostramos exactamente los 4 ramos grandes más destacados de la categoría

// Si hay un producto del anuncio (?hero=), su foto SIEMPRE es la del hero.
// Por defecto (sin ?hero=), seleccionamos el ramo clásico "Flores Amarillas"
const floresDefault = catSlug === 'flores-amarillas'
  ? ordenados.find(p => (p.name || '').toLowerCase() === 'flores amarillas') || ordenados.find(p => (p.name || '').toLowerCase().includes('flores amarillas'))
  : null;
// Precio mínimo para el sticky CTA
const minPrice = ordenados.length > 0
  ? Math.min(...ordenados.map(p => p.price).filter(Boolean))
  : 0;

const defaultSelectedProduct = adProduct || floresDefault || ordenados[0] || null;
const defaultHeroImg: string = defaultSelectedProduct?.img || ordenados[0]?.img || '';
const heroImg: string = defaultSelectedProduct?.img || content.heroImg || defaultHeroImg;
const heroProductName: string = defaultSelectedProduct?.name || landingData.title;
const heroProductPrice: number = defaultSelectedProduct?.price || minPrice;
const heroProductId: number = defaultSelectedProduct?.id || (ordenados[0]?.id || 0);
const unboxingImg: string = content.unboxingImg || ordenados[1]?.img || ordenados[0]?.img || '';

// Enlace de WhatsApp personalizado según landing y ramo seleccionado
const waMessage = content.ctaWaText || `Hola Nuditos! Quiero comprar el ramo ${heroProductName} (${heroProductPrice > 0 ? '$' + heroProductPrice.toLocaleString('es-CO') + ' COP' : ''})`;
const waUrl = `https://wa.me/573144931525?text=${encodeURIComponent(waMessage)}`;
---
<Layout
  title={`${landingData.title} | Nuditos`}
  description={content.heroSubtitle || "Ramos de crochet tejidos a mano, que nunca se marchitan. Envíos a todo Colombia."}
>

  <!-- ════════ BANNER TOP con contador ════════ -->
  <CountdownBanner 
    targetDate={content.targetDate || (slug === 'flores-amarillas' ? '2026-09-21' : '')}
    title={slug === 'flores-amarillas' ? 'Día de las Flores Amarillas' : (landingData.title || 'Colección Especial')}
    badge={slug === 'flores-amarillas' ? '21 de Septiembre' : 'Edición Limitada'}
    slug={slug}
  />

  <!-- ════════ HERO ════════ -->
  <section class="bg-white pt-0 pb-4 sm:py-6 md:py-8 px-3 sm:px-4 md:px-6 overflow-hidden relative">
    <div class="max-w-[1200px] mx-auto grid lg:grid-cols-2 gap-3 sm:gap-6 lg:gap-10 items-center">

      <!-- Imagen Hero con transición dinámica -->
      <div class="relative order-1 lg:order-2" id="heroMediaBox">
        {heroImg ? (
          <div class="aspect-[3/4] md:aspect-[4/5] rounded-2xl md:rounded-3xl overflow-hidden bg-stone-50 border border-stone-100 shadow-lg sm:shadow-xl relative">
            <img 
              id="heroMainImg"
              src={heroImg} 
              alt={heroProductName} 
              class="w-full h-full object-cover transition-opacity duration-300" 
              loading="eager" 
              fetchpriority="high" 
            />
          </div>
        ) : (
          <div class="aspect-[3/4] md:aspect-[4/5] rounded-2xl md:rounded-3xl bg-stone-50 border border-stone-100 flex items-center justify-center">
            <Icon name="plant" class="w-16 h-16 text-stone-300" />
          </div>
        )}
        <!-- Badge de estado -->
        <div class="absolute top-3.5 left-3.5 sm:top-4 sm:left-4 bg-white/95 backdrop-blur-md px-3.5 py-1.5 sm:px-4 sm:py-2 rounded-full shadow-md border border-stone-200/80">
          <span class="text-xs sm:text-sm font-bold text-stone-800 tracking-wide">Disponible</span>
        </div>
      </div>

      <!-- Texto y Confianza (Optimizado para Móvil e Impulso) -->
      <div class="order-2 lg:order-1 text-left">
        <h1 class="font-serif text-[1.65rem] sm:text-3xl md:text-5xl lg:text-6xl font-light text-slate-800 leading-[1.18] mb-2" set:html={content.heroTitle || landingData.title}></h1>

        <p class="text-slate-500 text-xs sm:text-sm md:text-base leading-relaxed mb-3 sm:mb-4 max-w-lg">
          {content.heroSubtitle || "Ramos de flores tejidas a mano en crochet que nunca se marchitan. El detalle perfecto para regalar y conservar para siempre."}
        </p>

        <!-- Pills de Confianza y Valor (Información Anterior) -->
        <div class="flex items-center gap-1.5 sm:gap-2 mb-3.5 sm:mb-4 flex-wrap">
          <span class="inline-flex items-center gap-1.5 bg-emerald-50 text-emerald-800 px-2.5 py-1 rounded-full text-[10px] sm:text-[11px] font-bold border border-emerald-200/60">
            <Icon name="truck" class="w-3.5 h-3.5 text-emerald-600" /> Envío gratis
          </span>
          <span class="inline-flex items-center gap-1.5 bg-amber-50 text-amber-900 px-2.5 py-1 rounded-full text-[10px] sm:text-[11px] font-bold border border-amber-200/60">
            <Icon name="hand-heart" class="w-3.5 h-3.5 text-amber-600" /> Hecho a mano
          </span>
          <span class="inline-flex items-center gap-1.5 bg-stone-100 text-stone-700 px-2.5 py-1 rounded-full text-[10px] sm:text-[11px] font-bold border border-stone-200">
            <Icon name="checkbox-circle" class="w-3.5 h-3.5 text-stone-600" /> Desde 2022
          </span>
        </div>

        <!-- Card Compacta del Ramo Seleccionado -->
        <div class="bg-amber-50/60 border border-amber-200/70 rounded-2xl px-3.5 py-2.5 mb-3.5 flex items-center justify-between gap-3">
          <div class="min-w-0">
            <span class="text-[9px] sm:text-[10px] font-bold text-amber-800 uppercase tracking-wider block">Ramo Destacado</span>
            <span id="heroSelectedProductName" class="font-bold text-xs sm:text-sm text-stone-900 truncate block">
              {heroProductName}
            </span>
          </div>
          <div class="text-right flex-shrink-0">
            <span class="text-[9px] text-stone-400 block">Precio</span>
            <span id="heroSelectedProductPrice" class="font-extrabold text-xs sm:text-sm text-stone-900">
              ${heroProductPrice.toLocaleString('es-CO')}
            </span>
          </div>
        </div>

        <!-- Botones de Acción: Comprar ramo y WhatsApp -->
        <div class="flex gap-2 sm:gap-3">
          <button 
            id="btnHeroBuy" 
            type="button" 
            data-product-id={heroProductId}
            onclick="handleHeroBuy(this)"
            class="flex-1 inline-flex items-center justify-center gap-2 bg-[#1a1220] hover:bg-black text-white px-5 sm:px-7 py-3.5 sm:py-4 rounded-xl sm:rounded-2xl text-xs sm:text-sm font-bold tracking-wide transition-all shadow-lg active:scale-95 cursor-pointer relative overflow-hidden group"
          >
            <Icon name="shopping-bag-3" class="w-4 h-4 text-amber-400 group-hover:scale-110 transition-transform" />
            <span id="btnHeroBuyText">Comprar ramo</span>
          </button>
          <a 
            id="heroWaBtn"
            href={waUrl} 
            target="_blank" 
            class="inline-flex items-center justify-center gap-1.5 sm:gap-2 bg-emerald-600 hover:bg-emerald-700 text-white px-4 sm:px-6 py-3.5 sm:py-4 rounded-xl sm:rounded-2xl text-xs sm:text-sm font-bold tracking-wide transition-all shadow-md active:scale-95 whitespace-nowrap"
          >
            <Icon name="whatsapp" class="w-4 h-4" />
            <span>WhatsApp</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════ TESTIMONIOS DINÁMICOS ════════ -->
  <TestimonialsSection />

  <!-- ════════ CATÁLOGO ════════ -->
  <section id="catalogo" class="bg-stone-50 py-6 sm:py-8 md:py-14 px-2.5 sm:px-4 md:px-6 border-t border-stone-100">
    <div class="max-w-[1400px] mx-auto">

      <!-- Encabezado de la Colección -->
      <div class="text-center max-w-lg mx-auto mb-6 sm:mb-8">
        <span class="inline-flex items-center bg-amber-100/70 border border-amber-300/60 text-amber-900 px-3 py-1 rounded-full text-[10px] sm:text-xs font-bold uppercase tracking-wider mb-2">
          {slug === 'flores-amarillas' ? 'Edición 21 de Septiembre' : 'Colección Destacada'}
        </span>
        <h2 class="font-serif text-2xl sm:text-3xl md:text-4xl font-light text-slate-800 leading-tight">
          Ramos <em class="italic text-amber-600 font-normal">más pedidos</em>
        </h2>
        <p class="text-slate-500 text-xs sm:text-sm mt-1.5 max-w-sm mx-auto">
          Tejidos a mano con amor. Elige tu favorito para regalar un detalle que dura para siempre.
        </p>
      </div>

      {ordenados.length > 0 ? (
        <>
          <div id="catalogGrid" class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6 md:gap-8 max-w-[480px] md:max-w-[960px] mx-auto">
            {ordenados.map((p, i) => (
              <div class:list={["product-col-item", { "hidden-card": i >= INITIAL_LIMIT }]}>
                <ProductCard p={p} idScope="madre-boutique" parentView="grid" eager={i < 4} showScarcity={true} />
              </div>
            ))}
          </div>

          {ordenados.length > INITIAL_LIMIT && (
            <div class="text-center mt-6 sm:mt-8" id="loadMoreContainer">
              <button 
                id="btnLoadMore" 
                type="button"
                class="inline-flex items-center gap-2 bg-white hover:bg-stone-50 text-slate-800 border border-stone-300 font-bold px-6 py-3 rounded-2xl text-xs tracking-wide shadow-sm hover:shadow transition-all active:scale-95 cursor-pointer"
              >
                <Icon name="grid" class="w-3.5 h-3.5 text-amber-600" />
                <span>Ver más ramos ({ordenados.length - INITIAL_LIMIT} más)</span>
              </button>
              <div class="mt-2 text-[10px] text-stone-400 font-medium">
                Mostrando {INITIAL_LIMIT} de {ordenados.length} ramos
              </div>
            </div>
          )}
        </>
      ) : (
        <div class="text-center py-12 sm:py-16">
          <Icon name="plant" class="w-10 h-10 sm:w-12 sm:h-12 text-stone-300 mx-auto mb-3" />
          <p class="text-stone-400 text-xs sm:text-sm mb-4 sm:mb-6">Próximamente disponibles</p>
          <a href="https://wa.me/573144931525" target="_blank" class="inline-flex items-center gap-2 bg-green-500 text-white px-6 sm:px-8 py-3.5 sm:py-4 rounded-xl sm:rounded-2xl text-[11px] sm:text-xs font-bold tracking-wide hover:bg-green-600 transition shadow-md">
            <Icon name="whatsapp" class="w-4 h-4" /> Consultar disponibilidad
          </a>
        </div>
      )}
    </div>
  </section>

  <!-- ════════ POR QUÉ NUDITOS ════════ -->
  <section class="bg-white py-6 sm:py-8 md:py-14 px-3 sm:px-4 md:px-6 border-y border-stone-100">
    <div class="max-w-[1200px] mx-auto">

      <!-- Header homogenizado -->
      <div class="text-center max-w-lg mx-auto mb-6 sm:mb-8">
        <span class="inline-flex items-center bg-emerald-50 border border-emerald-200 text-emerald-800 px-3 py-1 rounded-full text-[10px] sm:text-xs font-bold uppercase tracking-wider mb-2">
          ¿Por qué elegir Nuditos?
        </span>
        <h2 class="font-serif text-2xl sm:text-3xl md:text-4xl font-light text-slate-800 leading-tight">
          Flores que <em class="italic text-amber-600 font-normal">nunca mueren</em>
        </h2>
        <p class="text-slate-500 text-xs sm:text-sm mt-1.5 max-w-sm mx-auto">
          Elaboradas en crochet de alta calidad para conservar tus momentos especiales para siempre.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-4 sm:gap-6 md:gap-12 items-center">
        <!-- Imagen envíos - Carrusel crossfade -->
        <div class="aspect-[4/3] md:aspect-square rounded-2xl md:rounded-3xl bg-stone-100 border border-stone-100 overflow-hidden shadow-md relative" id="whyCarousel">
          <img src="/img/envios-nuditos-1.jpg" class="w-full h-full object-cover absolute inset-0 why-slide why-slide-active" alt="Envíos Nuditos - Cajas listas para despacho" loading="lazy" />
          <img src="/img/envios-nuditos-2.jpg" class="w-full h-full object-cover absolute inset-0 why-slide" alt="Envíos Nuditos - Pedidos empacados" loading="lazy" />
        </div>

        <!-- Beneficios -->
        <div class="space-y-2.5 sm:space-y-3">
          <div class="flex items-start gap-2.5 sm:gap-3 p-3 sm:p-3.5 bg-stone-50 rounded-xl sm:rounded-2xl border border-stone-100">
            <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-lg bg-amber-100 flex items-center justify-center flex-shrink-0">
              <Icon name="magic" class="w-4 h-4 sm:w-4.5 sm:h-4.5 text-amber-600" />
            </div>
            <div class="min-w-0">
              <div class="text-xs sm:text-[13px] font-bold text-slate-800 mb-0.5">Durabilidad infinita</div>
              <p class="text-slate-500 leading-relaxed text-[11px] sm:text-xs">Las flores de florería duran 5–7 días. Los ramos Nuditos duran para siempre.</p>
            </div>
          </div>
          <div class="flex items-start gap-2.5 sm:gap-3 p-3 sm:p-3.5 bg-stone-50 rounded-xl sm:rounded-2xl border border-stone-100">
            <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-lg bg-rose-100 flex items-center justify-center flex-shrink-0">
              <Icon name="hand-heart" class="w-4 h-4 sm:w-4.5 sm:h-4.5 text-rose-500" />
            </div>
            <div class="min-w-0">
              <div class="text-xs sm:text-[13px] font-bold text-slate-800 mb-0.5">Pieza única</div>
              <p class="text-slate-500 leading-relaxed text-[11px] sm:text-xs">Cada ramo es tejido a mano con dedicación. No hay dos iguales.</p>
            </div>
          </div>
          <div class="flex items-start gap-2.5 sm:gap-3 p-3 sm:p-3.5 bg-stone-50 rounded-xl sm:rounded-2xl border border-stone-100">
            <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-lg bg-blue-100 flex items-center justify-center flex-shrink-0">
              <Icon name="truck" class="w-4 h-4 sm:w-4.5 sm:h-4.5 text-blue-500" />
            </div>
            <div class="min-w-0">
              <div class="text-xs sm:text-[13px] font-bold text-slate-800 mb-0.5">Empaque seguro + dedicatoria</div>
              <p class="text-slate-500 leading-relaxed text-[11px] sm:text-xs">Caja rígida reforzada, listo para regalar con tarjeta escrita a mano.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════ TRUST SIGNALS ════════ -->
  <TrustSignalsSection />

  <!-- ════════ PREGUNTAS FRECUENTES ════════ -->
  <section class="bg-stone-50 py-6 sm:py-8 md:py-14 px-3 sm:px-4 md:px-6 border-t border-stone-100">
    <div class="max-w-[800px] mx-auto">
      <div class="text-center max-w-lg mx-auto mb-6 sm:mb-8">
        <span class="inline-flex items-center bg-stone-100 border border-stone-200 text-stone-700 px-3 py-1 rounded-full text-[10px] sm:text-xs font-bold uppercase tracking-wider mb-2">
          Dudas frecuentes
        </span>
        <h2 class="font-serif text-2xl sm:text-3xl md:text-4xl font-light text-slate-800 leading-tight">
          Preguntas <em class="italic text-amber-600 font-normal">frecuentes</em>
        </h2>
        <p class="text-slate-500 text-xs sm:text-sm mt-1.5 max-w-sm mx-auto">
          Resolvemos tus dudas antes de ordenar tu ramo tejido.
        </p>
      </div>
      <div class="space-y-0 rounded-xl sm:rounded-2xl overflow-hidden border border-stone-200 bg-white shadow-xs">
        <details class="group" open>
          <summary class="flex items-center gap-2.5 sm:gap-3 px-3.5 sm:px-4 py-3 sm:py-3.5 cursor-pointer select-none hover:bg-stone-50 transition-colors border-b border-stone-100 list-none [&::-webkit-details-marker]:hidden">
            <div class="w-6 h-6 sm:w-7 sm:h-7 rounded-lg bg-rose-50 flex items-center justify-center flex-shrink-0">
              <Icon name="shopping-bag" class="w-3 h-3 sm:w-3.5 sm:h-3.5 text-rose-500" />
            </div>
            <span class="flex-1 text-xs sm:text-[13px] font-bold text-slate-800">¿Viene empacado para regalo?</span>
            <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-stone-400 transition-transform group-open:rotate-180 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
          </summary>
          <p class="text-slate-500 text-[11px] sm:text-xs leading-relaxed px-3.5 pb-3.5 pt-1 pl-11 sm:px-4 sm:pb-4 sm:pl-14">¡Sí! Caja rígida resistente con moño y tarjeta con tu dedicatoria escrita a mano. Listo para sorprender.</p>
        </details>
        <details class="group">
          <summary class="flex items-center gap-2.5 sm:gap-3 px-3.5 sm:px-4 py-3 sm:py-3.5 cursor-pointer select-none hover:bg-stone-50 transition-colors border-b border-stone-100 list-none [&::-webkit-details-marker]:hidden">
            <div class="w-6 h-6 sm:w-7 sm:h-7 rounded-lg bg-blue-50 flex items-center justify-center flex-shrink-0">
              <Icon name="truck" class="w-3 h-3 sm:w-3.5 sm:h-3.5 text-blue-500" />
            </div>
            <span class="flex-1 text-xs sm:text-[13px] font-bold text-slate-800">¿Cuánto tarda el envío?</span>
            <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-stone-400 transition-transform group-open:rotate-180 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
          </summary>
          <p class="text-slate-500 text-[11px] sm:text-xs leading-relaxed px-3.5 pb-3.5 pt-1 pl-11 sm:px-4 sm:pb-4 sm:pl-14">Envíos a toda Colombia con Servientrega o Inter Rapidísimo. Llega en 2 a 4 días hábiles.</p>
        </details>
        <details class="group">
          <summary class="flex items-center gap-2.5 sm:gap-3 px-3.5 sm:px-4 py-3 sm:py-3.5 cursor-pointer select-none hover:bg-stone-50 transition-colors border-b border-stone-100 list-none [&::-webkit-details-marker]:hidden">
            <div class="w-6 h-6 sm:w-7 sm:h-7 rounded-lg bg-emerald-50 flex items-center justify-center flex-shrink-0">
              <Icon name="leaf" class="w-3 h-3 sm:w-3.5 sm:h-3.5 text-emerald-500" />
            </div>
            <span class="flex-1 text-xs sm:text-[13px] font-bold text-slate-800">¿Se dañan con el tiempo?</span>
            <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-stone-400 transition-transform group-open:rotate-180 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
          </summary>
          <p class="text-slate-500 text-[11px] sm:text-xs leading-relaxed px-3.5 pb-3.5 pt-1 pl-11 sm:px-4 sm:pb-4 sm:pl-14">No. Hilos premium de alta resistencia. Nunca se marchitan ni pierden color. Un recuerdo eterno.</p>
        </details>
        <details class="group">
          <summary class="flex items-center gap-2.5 sm:gap-3 px-3.5 sm:px-4 py-3 sm:py-3.5 cursor-pointer select-none hover:bg-stone-50 transition-colors list-none [&::-webkit-details-marker]:hidden">
            <div class="w-6 h-6 sm:w-7 sm:h-7 rounded-lg bg-violet-50 flex items-center justify-center flex-shrink-0">
              <Icon name="bank-card" class="w-3 h-3 sm:w-3.5 sm:h-3.5 text-violet-500" />
            </div>
            <span class="flex-1 text-xs sm:text-[13px] font-bold text-slate-800">¿Medios de pago?</span>
            <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-stone-400 transition-transform group-open:rotate-180 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
          </summary>
          <p class="text-slate-500 text-[11px] sm:text-xs leading-relaxed px-3.5 pb-3.5 pt-1 pl-11 sm:px-4 sm:pb-4 sm:pl-14">Nequi, Daviplata, Bancolombia, PSE, tarjetas crédito/débito (Wompi) y contra entrega en algunas ciudades.</p>
        </details>
      </div>
    </div>
  </section>

  <!-- ════════ CTA FINAL ════════ -->
  <section class="bg-[#1a1220] py-8 sm:py-10 md:py-14 px-3 sm:px-4 md:px-6 relative overflow-hidden" id="personalizado">
    <div class="max-w-lg mx-auto text-center relative z-10">
      <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-2xl bg-green-500/20 flex items-center justify-center mx-auto mb-3 sm:mb-4">
        <Icon name="whatsapp" class="w-6 h-6 sm:w-7 sm:h-7 text-green-400" />
      </div>
      <h2 class="font-serif text-2xl sm:text-3xl md:text-4xl font-light text-white mb-2 leading-tight">
        ¿Tienes alguna <em class="italic text-green-400 font-normal">duda?</em>
      </h2>
      <p class="text-stone-400 leading-relaxed mb-5 sm:mb-6 text-xs sm:text-[13px] max-w-sm mx-auto">
        {content.ctaFinalCopy || "Escríbenos por WhatsApp y te ayudamos a elegir el ramo perfecto. También hacemos ramos personalizados."}
      </p>
      <a href={waUrl} target="_blank" class="inline-flex items-center gap-2 bg-green-500 text-white px-6 sm:px-8 py-3.5 sm:py-4 rounded-xl sm:rounded-2xl font-bold shadow-lg shadow-green-500/20 hover:bg-green-400 transition-all text-xs sm:text-sm tracking-wide active:scale-[0.97]">
        <Icon name="whatsapp" class="w-4 h-4" /> <span>Escribir por WhatsApp</span>
      </a>
    </div>
    <div class="absolute -top-20 -right-20 w-48 h-48 bg-violet-500/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-20 -left-20 w-48 h-48 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>
  </section>

  <!-- ════════ STICKY CTA BAR (Mobile/Desktop) ════════ -->
  <div
    id="stickyCTA"
    class="fixed bottom-[68px] md:bottom-8 left-0 md:left-1/2 md:-translate-x-1/2 w-full md:w-[94%] md:max-w-[520px] z-[1600] border-t md:border px-3.5 py-2.5 md:p-2.5 md:rounded-[2.5rem] transition-all duration-700 ease-[cubic-bezier(0.23,1,0.32,1)] translate-y-[150%] opacity-0 pointer-events-none"
  >
    <div class="flex items-center gap-2.5 sm:gap-3 max-w-[520px] mx-auto md:mx-0">
      <!-- Miniatura -->
      <div class="w-11 h-11 sm:w-12 sm:h-12 rounded-xl overflow-hidden bg-stone-50 border border-stone-200 flex-shrink-0">
        <img id="stickyProductImg" src={heroImg.toLowerCase().endsWith('.mp4') ? defaultHeroImg : heroImg} alt={heroProductName} class="w-full h-full object-cover" />
      </div>

      <!-- Texto del Ramo Seleccionado -->
      <div class="flex-1 min-w-0">
        <div id="stickyProductName" class="text-xs sm:text-[13px] font-bold text-stone-900 leading-tight truncate">
          {heroProductName}
        </div>
        <div class="text-[11px] sm:text-xs font-black text-amber-700 flex items-center gap-1.5 mt-0.5">
          <span id="stickyProductPrice">${heroProductPrice.toLocaleString('es-CO')}</span>
          <span class="text-[9px] text-emerald-600 font-bold bg-emerald-50 px-1.5 py-0.2 rounded border border-emerald-100/80">Envío gratis</span>
        </div>
      </div>

      <!-- Botón Comprar en Sticky -->
      <button 
        id="btnStickyBuy"
        type="button" 
        data-product-id={heroProductId}
        onclick="handleHeroBuy(this)"
        class="bg-[#1a1220] hover:bg-black text-white px-4 sm:px-6 py-2.5 sm:py-3 rounded-xl sm:rounded-full text-xs font-bold tracking-wide active:scale-95 transition-all shadow-md flex items-center gap-1.5 flex-shrink-0 whitespace-nowrap cursor-pointer"
      >
        <Icon name="shopping-bag-3" class="w-3.5 h-3.5 text-amber-400" />
        <span id="btnStickyBuyText">Comprar</span>
      </button>
    </div>
  </div>

  <style>
    html { scroll-behavior: smooth; }
    
    /* Estilo base estándar para Android, Windows y otros navegadores (Igual a la barra superior) */
    #stickyCTA { 
      will-change: transform, opacity; 
      background-color: #ffffff;
      border-color: rgba(231, 229, 228, 0.95);
      box-shadow: 0 -8px 24px rgba(0, 0, 0, 0.08), 0 2px 8px rgba(0, 0, 0, 0.04);
    }
    #stickyCTA.is-visible { transform: translate(0, 0); opacity: 1; pointer-events: auto; }
    @media (min-width: 768px) { 
      #stickyCTA.is-visible { transform: translate(-50%, 0); } 
      #stickyCTA {
        box-shadow: 0 16px 45px rgba(0, 0, 0, 0.14);
      }
    }

    /* Efecto Glassmorphism exclusivo para iPhone, iPad y Mac */
    :global(html.is-apple) #stickyCTA {
      background-color: rgba(255, 255, 255, 0.82) !important;
      -webkit-backdrop-filter: blur(20px) saturate(180%);
      backdrop-filter: blur(20px) saturate(180%);
      border-color: rgba(255, 255, 255, 0.6) !important;
      box-shadow: 0 -8px 28px rgba(0, 0, 0, 0.08), 0 1px 0 rgba(255, 255, 255, 0.7) inset !important;
    }
    @media (min-width: 768px) {
      :global(html.is-apple) #stickyCTA {
        background-color: rgba(255, 255, 255, 0.86) !important;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.16), 0 1px 0 rgba(255, 255, 255, 0.8) inset !important;
      }
    }

    @media (max-width: 768px) {
      :global(body:has(#stickyCTA.is-visible) .wa-float) {
        opacity: 0 !important; transform: scale(0) !important; pointer-events: none !important;
      }
    }

    /* Countdown */
    .cd-unit { display: flex; flex-direction: column; align-items: center; gap: 1px; }
    .cd-digit {
      background: rgba(255,255,255,0.1); backdrop-filter: blur(4px); color: #fff;
      font-family: 'SF Mono','Cascadia Code','Consolas',monospace; font-size: 13px; font-weight: 700;
      letter-spacing: .05em; padding: 2px 6px; border-radius: 4px; min-width: 28px;
      text-align: center; font-variant-numeric: tabular-nums; border: 1px solid rgba(167,139,250,.2);
    }
    .cd-label { font-size: 7px; text-transform: uppercase; letter-spacing: .12em; color: rgba(196,181,253,.6); font-weight: 500; }
    #cdSecs { animation: cdPulse 1s ease-in-out infinite; }
    @keyframes cdPulse { 0%,100%{opacity:1} 50%{opacity:.7} }

    /* Carousel */
    .why-slide { opacity: 0; transition: opacity 1.2s ease-in-out; }
    .why-slide-active { opacity: 1; }

    /* FAQ Accordion */
    details summary { list-style: none; }
    details summary::-webkit-details-marker { display: none; }
    details[open] > summary { background-color: rgba(0,0,0,0.01); }
    details > p { animation: faqSlide 0.2s ease-out; }
    @keyframes faqSlide { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: translateY(0); } }

    /* Optimal Cards View */
    .hidden-card { display: none !important; }
    .fade-in { animation: fadeInCard 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
    @keyframes fadeInCard {
      from { opacity: 0; transform: translateY(12px); }
      to { opacity: 1; transform: translateY(0); }
    }
  </style>

  <script is:inline set:html={`
    window.NUDITOS_LIVE_PRODUCTS = ${JSON.stringify(safeProducts)}; 
    window.NUDITOS_CATEGORIES = ${JSON.stringify(safeCategories)}; 
    window.NUDITOS_LIVE_CONFIG = ${JSON.stringify(publicConfig)};
    window.LANDING_DATA = {
      targetDate: "${content.targetDate || (slug === 'flores-amarillas' ? '2026-09-21' : '')}",
      title: "${landingData.title || ''}",
      catSlug: "${catSlug || ''}"
    };
  `} />

  <script is:inline>
    // Detección de dispositivos Apple (iOS / macOS) para el efecto Glassmorphism
    (function() {
      var isApple = /iPad|iPhone|iPod|Macintosh/.test(navigator.userAgent) && !window.MSStream;
      if (isApple) {
        document.documentElement.classList.add('is-apple');
      }
    })();

    // Selector dinámico de producto para el Hero
    window.selectProductForHero = function(productId, scrollIntoView) {
      var prods = window.NUDITOS_LIVE_PRODUCTS || [];
      var p = prods.find(function(item) { return item.id === productId; });
      if (!p) return;

      // 1. Imagen con suave transición de opacidad
      var heroImg = document.getElementById('heroMainImg');
      if (heroImg && p.img) {
        heroImg.style.opacity = '0.2';
        setTimeout(function() {
          heroImg.src = p.img;
          heroImg.alt = p.name;
          heroImg.style.opacity = '1';
        }, 120);
      }

      // 2. Nombre del producto
      var nameEl = document.getElementById('heroSelectedProductName');
      if (nameEl) nameEl.textContent = p.name;

      // 3. Precio
      var priceEl = document.getElementById('heroSelectedProductPrice');
      if (priceEl && p.price) {
        priceEl.textContent = '$' + p.price.toLocaleString('es-CO');
      }

      // 4. Botón Comprar
      var buyBtn = document.getElementById('btnHeroBuy');
      if (buyBtn) {
        buyBtn.setAttribute('data-product-id', String(p.id));
      }

      // 5. Botón WhatsApp
      var waBtn = document.getElementById('heroWaBtn');
      if (waBtn) {
        var msg = 'Hola Nuditos! Quiero comprar el ramo ' + p.name + ' ($' + p.price.toLocaleString('es-CO') + ' COP)';
        waBtn.href = 'https://wa.me/573144931525?text=' + encodeURIComponent(msg);
      }

      // 6. Resaltar botón en el mini selector del Hero
      document.querySelectorAll('.hero-thumb-btn').forEach(function(btn) {
        var pid = Number(btn.getAttribute('data-product-id'));
        if (pid === p.id) {
          btn.classList.add('border-amber-500', 'bg-white', 'shadow-sm', 'ring-2', 'ring-amber-400/50');
          btn.classList.remove('border-stone-200/80', 'bg-white/70');
        } else {
          btn.classList.remove('border-amber-500', 'bg-white', 'shadow-sm', 'ring-2', 'ring-amber-400/50');
          btn.classList.add('border-stone-200/80', 'bg-white/70');
        }
      });

      // 7. Sincronizar barra Sticky CTA para móvil
      var stickyImg = document.getElementById('stickyProductImg');
      if (stickyImg && p.img) stickyImg.src = p.img;
      var stickyName = document.getElementById('stickyProductName');
      if (stickyName) stickyName.textContent = p.name;
      var stickyPrice = document.getElementById('stickyProductPrice');
      if (stickyPrice && p.price) stickyPrice.textContent = '$' + p.price.toLocaleString('es-CO');
      var stickyBuy = document.getElementById('btnStickyBuy');
      if (stickyBuy) stickyBuy.setAttribute('data-product-id', String(p.id));

      if (scrollIntoView) {
        var heroBox = document.getElementById('heroMediaBox');
        if (heroBox) heroBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    };

    // Manejador del botón Comprar con animación visual y apertura del carrito
    window.handleHeroBuy = function(btn) {
      var id = Number(btn.getAttribute('data-product-id'));
      if (!id) return;

      // 1. Agregar al carrito
      if (typeof window.addToCart === 'function') {
        window.addToCart(id);
      }

      // 2. Animación de feedback en el botón
      var btnText = document.getElementById('btnHeroBuyText');
      var originalText = btnText ? btnText.textContent : 'Comprar ramo';

      btn.classList.add('bg-emerald-600', 'hover:bg-emerald-700', 'scale-[1.02]');
      btn.classList.remove('bg-[#1a1220]', 'hover:bg-black');
      if (btnText) btnText.textContent = '¡Ramo agregado!';

      setTimeout(function() {
        btn.classList.remove('bg-emerald-600', 'hover:bg-emerald-700', 'scale-[1.02]');
        btn.classList.add('bg-[#1a1220]', 'hover:bg-black');
        if (btnText) btnText.textContent = originalText;

        // 3. Abrir la bolsa para que el cliente vea el ramo agregado
        if (typeof toggleCart === 'function') {
          toggleCart();
        }
      }, 700);
    };

    (function() {
      // 1. Sticky CTA
      var stickyCTA = document.getElementById('stickyCTA');
      window.addEventListener('scroll', function() {
        if (window.scrollY > 500) stickyCTA.classList.add('is-visible');
        else stickyCTA.classList.remove('is-visible');
      }, { passive: true });

      // 2. Click en tarjetas del catálogo para cambiar el ramo en el hero
      document.querySelectorAll('.product-col-item').forEach(function(item) {
        var card = item.querySelector('.product-card');
        if (!card) return;
        var idMatch = (card.getAttribute('id') || '').match(/pcard-(\d+)/);
        if (idMatch && idMatch[1]) {
          var productId = Number(idMatch[1]);
          card.addEventListener('click', function(e) {
            if (e.target.closest('.quick-add') || e.target.closest('.pcard-nav')) return;
            window.selectProductForHero(productId, false);
          });
        }
      });

      // 3. Why Nuditos carousel
      var slides = document.querySelectorAll('.why-slide');
      if (slides.length > 1) {
        var current = 0;
        setInterval(function() {
          slides[current].classList.remove('why-slide-active');
          current = (current + 1) % slides.length;
          slides[current].classList.add('why-slide-active');
        }, 4000);
      }

      // 4. Load More cards expander
      var btnLoadMore = document.getElementById('btnLoadMore');
      if (btnLoadMore) {
        btnLoadMore.addEventListener('click', function() {
          var hiddenCards = document.querySelectorAll('.hidden-card');
          hiddenCards.forEach(function(card) {
            card.classList.remove('hidden-card');
            card.classList.add('fade-in');
          });
          var container = document.getElementById('loadMoreContainer');
          if (container) {
            container.innerHTML = '<a href="/catalogo?categoria=' + encodeURIComponent(window.LANDING_DATA.catSlug || '') + '" class="inline-flex items-center gap-1.5 text-xs font-bold text-stone-600 hover:text-stone-900 border border-stone-200 bg-white px-5 py-2.5 rounded-xl shadow-xs transition-colors">Explorar todo el catálogo &rarr;</a>';
          }
        });
      }
    })();
  </script>
</Layout>

