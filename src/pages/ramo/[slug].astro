---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import ProductCard from '../../components/ProductCard.astro';
import TestimonialsSection from '../../components/TestimonialsSection.astro';
import CountdownBanner from '../../components/CountdownBanner.astro';
import { getLiveProductBySlug, getLiveProducts, getLiveCategories } from '../../lib/supabase';
import { slugify, clUrl, categories as FALLBACK_CATEGORIES } from '../../data/datos';
import { getIconSvg } from '../../lib/icons';

const checkIconSvg = getIconSvg('check');

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/');

const fromSource = Astro.url.searchParams.get('from') || 'default-grid';

Astro.response.headers.set('Cache-Control', 'public, max-age=120, stale-while-revalidate=600');

const WA_NUMBER = '573144931525';
const SITE_URL  = Astro.site?.toString().replace(/\/$/, '') || Astro.url.origin;

// Cargar Datos
const product = await getLiveProductBySlug(slug);
if (!product) return Astro.redirect('/');

const [allProducts, rawCategories] = await Promise.all([
  getLiveProducts(),
  getLiveCategories()
]);

const categories = rawCategories && rawCategories.length > 0 ? rawCategories : FALLBACK_CATEGORIES;

// Related Products
const sameCat = allProducts.filter(p => ((p.cats || []).some(cid => (product.cats || []).includes(cid)) || p.cat === product.cat) && p.id !== product.id).slice(0, 4);
const others  = allProducts.filter(p => !((p.cats || []).some(cid => (product.cats || []).includes(cid)) || p.cat === product.cat) && p.id !== product.id).slice(0, 4 - sameCat.length);
const related = [...sameCat, ...others].slice(0, 4);

// UI Helpers
const cat = categories.find(c => c.id === product.cat) || { name: product.cat || 'Ramos', nombre: product.cat || 'Ramos', icon: '🌸' };
const catDisplayName = cat.nombre || cat.name || 'Ramos';
const allImgs = [product.img, ...(product.imgs || []).filter((u: string) => u && u !== product.img)].filter(Boolean);
const mainImg = allImgs[0] || '';
const showPrice = product.oferta && product.precioOferta > 0 ? product.precioOferta : product.price;
const origPrice = product.oferta && product.precioOriginal > 0 ? product.precioOriginal : null;
const inStock   = product.stock === undefined || product.stock === null || product.stock > 0;
const pageUrl   = `${SITE_URL}/ramo/${slug}`;
const discount  = origPrice && origPrice > showPrice ? Math.round((1 - showPrice / origPrice) * 100) : 0;

const waMessage = `Hola Nuditos! 🌸 Quiero comprar el ramo *${product.name}* (${showPrice > 0 ? '$' + showPrice.toLocaleString('es-CO') + ' COP' : ''})\n\n${pageUrl}`;
const waUrl = `https://wa.me/${WA_NUMBER}?text=${encodeURIComponent(waMessage)}`;

// Campañas especiales
const isYellow = (product.cats || []).some(c => (c || '').toLowerCase().includes('amarill') || (c || '').toLowerCase().includes('girasol')) || (product.cat || '').toLowerCase().includes('amarill') || (product.cat || '').toLowerCase().includes('girasol') || (product.name || '').toLowerCase().includes('girasol') || (product.name || '').toLowerCase().includes('amarill');
const isMadre = (product.cats || []).some(c => (c || '').toLowerCase().includes('madre')) || (product.cat || '').toLowerCase().includes('madre');

// SEO
const seoTitle = product.metaTitle || `${product.name} | Ramo Tejido a Crochet | Nuditos`;
const seoDesc  = product.metaDescription || (product.desc
  ? `${product.desc} · Flores eternas tejidas a mano en Colombia.`
  : `Ramo ${product.name} tejido a mano en crochet. Un detalle eterno que nunca se marchita. Envíos a todo Colombia.`);

const mainAltText = product.altText || `${product.name} - Ramo tejido a crochet que nunca se marchita`;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Inicio", "item": SITE_URL },
    { "@type": "ListItem", "position": 2, "name": "Catálogo", "item": `${SITE_URL}/catalogo` },
    { "@type": "ListItem", "position": 3, "name": catDisplayName, "item": `${SITE_URL}/catalogo/${product.cat}` },
    { "@type": "ListItem", "position": 4, "name": product.name, "item": pageUrl }
  ]
};

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  description: product.desc || seoDesc,
  image: allImgs.map(img => img.startsWith('http') ? img : `${SITE_URL}${img}`),
  brand: { '@type': 'Brand', name: 'Nuditos Tejidos' },
  sku: `NUD-${product.id}`,
  category: catDisplayName,
  offers: {
    '@type': 'Offer',
    priceCurrency: 'COP',
    price: showPrice || 0,
    availability: inStock ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock',
    url: pageUrl,
    seller: { '@type': 'Organization', name: 'Nuditos Tejidos' },
  }
};

const currentProduct = {
  id: Number(product.id),
  name: product.name,
  price: Number(showPrice),
  img: mainImg,
  emoji: product.emoji || '🌸',
  cat: product.cat || '',
  desc: product.desc || ''
};
---

<Layout
  title={seoTitle}
  description={seoDesc}
  ogImage={mainImg.startsWith('http') ? mainImg : `${SITE_URL}${mainImg}`}
  ogType="product"
  canonical={pageUrl}
>

  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(productSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />
    {showPrice > 0 && <meta property="product:price:amount"   content={String(showPrice)} />}
    {showPrice > 0 && <meta property="product:price:currency" content="COP" />}
    {product.seoKeywords && <meta name="keywords" content={product.seoKeywords} />}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/Swiper/11.0.5/swiper-bundle.min.css" />
  </Fragment>

  <!-- ════════ BANNER TOP CON CONTADOR ════════ -->
  {isYellow ? (
    <CountdownBanner 
      targetDate="2026-09-21"
      title="Día de las Flores Amarillas"
      badge="21 de Septiembre"
      slug="flores-amarillas"
    />
  ) : isMadre ? (
    <div class="bg-rose-50 text-rose-950 border-b border-rose-100/50 py-2.5 px-4">
      <div class="max-w-[1200px] mx-auto flex flex-wrap items-center justify-center gap-2 text-center text-[10px] md:text-xs tracking-widest uppercase font-medium">
        <span class="font-bold text-rose-800">Día de la Madre — 10 de mayo</span>
        <span class="hidden sm:inline text-rose-300">|</span>
        <div class="flex items-center gap-1.5" id="madreCountdown">
          <span class="text-rose-600">Faltan</span>
          <span id="cdDays" class="font-bold">00</span><span>D</span>
          <span id="cdHours" class="font-bold">00</span><span>H</span>
          <span id="cdMins" class="font-bold">00</span><span>M</span>
        </div>
      </div>
    </div>
  ) : (
    <div class="bg-emerald-50 text-emerald-900 border-b border-emerald-100/50 py-2 px-4">
      <div class="max-w-[1200px] mx-auto flex items-center justify-center gap-2 text-[10px] tracking-widest uppercase font-bold">
        <Icon name="truck" class="w-3.5 h-3.5 text-emerald-600" /> Envío Gratis Nacional — Tejiendo momentos desde 2022
      </div>
    </div>
  )}

  <!-- ════════ BREADCRUMB (Desktop) ════════ -->
  <nav class="hidden md:flex max-w-[1200px] mx-auto px-4 sm:px-6 pt-3 pb-1 md:py-3 items-center gap-2 text-[10px] uppercase tracking-[0.25em] text-stone-400 font-medium" aria-label="Breadcrumb">
    <a href="/" class="hover:text-stone-800 transition-colors">Inicio</a>
    <span class="opacity-30">/</span>
    <a href="/catalogo" class="hover:text-stone-800 transition-colors">Catálogo</a>
    <span class="opacity-30">/</span>
    <a href={`/catalogo/${product.cat}`} class="hover:text-stone-800 transition-colors">{catDisplayName}</a>
    <span class="opacity-30">/</span>
    <span class="text-stone-700 font-bold tracking-normal normal-case text-[11px]">{product.name}</span>
  </nav>

  <!-- ════════ SECCIÓN DE PRODUCTO ════════ -->
  <section class="max-w-[1200px] mx-auto px-3 sm:px-4 md:px-6 grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-16 items-start pt-0 pb-6 sm:py-6 md:py-8 overflow-hidden relative">

    <!-- GALERÍA -->
    <div class="relative w-full">
      <div 
        class="swiper product-gallery-swiper relative w-full aspect-[4/5] rounded-2xl md:rounded-3xl overflow-hidden bg-stone-50 shadow-md sm:shadow-lg border border-stone-100"
        id="ramoMainWrap"
      >
        <div class="swiper-wrapper">
          {allImgs.map((img: string, i: number) => (
            <div class="swiper-slide cursor-zoom-in" onclick={`openLightbox(${i})`}>
              <img
                src={clUrl(img, 800)} 
                srcset={`${clUrl(img, 500)} 500w, ${clUrl(img, 800)} 800w, ${clUrl(img, 1200)} 1200w`}
                sizes="(max-width: 768px) 100vw, 50vw"
                alt={i === 0 ? mainAltText : `${product.name} - Imagen ${i + 1}`}
                width="800"
                height="1000"
                class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
                loading={i === 0 ? "eager" : "lazy"}
                decoding={i === 0 ? "sync" : "async"}
                fetchpriority={i === 0 ? "high" : "low"}
                id={i === 0 ? "ramoMainImg" : undefined}
                style={i === 0 ? `view-transition-name: p-img-${product.id}-${fromSource}` : undefined}
              />
            </div>
          ))}
        </div>

        <div class="swiper-pagination !bottom-4"></div>

        {product.badge && (
          <div class="absolute top-4 left-4 z-10 bg-white/95 backdrop-blur-md border border-stone-200/80 px-3.5 py-1.5 rounded-full text-[10px] sm:text-xs font-bold uppercase tracking-wider flex items-center gap-1.5 shadow-sm">
             {product.badge === 'Nuevo'    && <Icon name="sparkling" class="text-emerald-500 w-3.5 h-3.5" />}
             {product.badge === 'Popular'  && <Icon name="fire" class="text-rose-500 w-3.5 h-3.5" />}
             {product.badge === 'Especial' && <Icon name="award" class="text-amber-500 w-3.5 h-3.5" />}
             {(product.badge.includes('Vendido') || product.badge.includes('Precio')) && <Icon name="award" class="text-amber-500 w-3.5 h-3.5" />}
             <span>{product.badge}</span>
          </div>
        )}
        
        {!inStock && (
          <div class="absolute inset-0 bg-white/60 backdrop-blur-[2px] flex items-center justify-center font-serif text-2xl uppercase tracking-widest text-stone-800 z-10">
            Agotado
          </div>
        )}
      </div>

      <!-- Miniaturas en Desktop -->
      {allImgs.length > 1 && (
        <div class="hidden md:flex gap-3 overflow-x-auto pb-2 scrollbar-none mt-3.5">
          {allImgs.map((url: string, i: number) => (
            <button 
              class={`ramo-thumb w-18 aspect-[4/5] rounded-xl overflow-hidden border-2 transition-all flex-shrink-0 cursor-pointer ${i === 0 ? 'border-amber-500 opacity-100 shadow-sm ring-2 ring-amber-400/30' : 'border-transparent opacity-60 hover:opacity-100'}`}
              onclick={`if(window.gallerySwiper) window.gallerySwiper.slideTo(${i})`}
              data-thumb={i}
            >
              <img src={clUrl(url, 200)} alt={`${product.name} mini`} width="80" height="100" loading="lazy" decoding="async" class="w-full h-full object-cover" />
            </button>
          ))}
        </div>
      )}
    </div>

    <!-- INFORMACIÓN DE COMPRA -->
    <div class="text-left">
      <div class="text-[10px] font-bold tracking-[0.25em] uppercase text-amber-800 bg-amber-50/80 border border-amber-200/60 px-3 py-1 rounded-full w-fit mb-2 flex items-center gap-1.5">
         {cat.icon || '🌸'} Colección {catDisplayName}
      </div>
      
      <h1 class="font-serif text-[1.85rem] sm:text-3xl md:text-5xl font-light text-slate-800 leading-[1.18] mb-2">
        {product.name}
      </h1>

      <!-- Pills de Confianza y Valor -->
      <div class="flex items-center gap-1.5 sm:gap-2 mb-4 flex-wrap">
        <span class="inline-flex items-center gap-1.5 bg-emerald-50 text-emerald-800 px-2.5 py-1 rounded-full text-[10px] sm:text-[11px] font-bold border border-emerald-200/60">
          <Icon name="truck" class="w-3.5 h-3.5 text-emerald-600" /> Envío gratis
        </span>
        <span class="inline-flex items-center gap-1.5 bg-amber-50 text-amber-900 px-2.5 py-1 rounded-full text-[10px] sm:text-[11px] font-bold border border-amber-200/60">
          <Icon name="hand-heart" class="w-3.5 h-3.5 text-amber-600" /> Hecho a mano
        </span>
        <span class="inline-flex items-center gap-1.5 bg-stone-100 text-stone-700 px-2.5 py-1 rounded-full text-[10px] sm:text-[11px] font-bold border border-stone-200">
          <Icon name="checkbox-circle" class="w-3.5 h-3.5 text-stone-600" /> Desde 2022
        </span>
      </div>

      <!-- Precio -->
      <div class="flex items-baseline gap-3 mb-5">
        {showPrice > 0 ? (
          <>
            <span class="font-sans text-2xl md:text-[2.2rem] font-extrabold text-stone-900 tracking-tight">
              ${showPrice.toLocaleString('es-CO')} <span class="text-[11px] font-sans text-stone-400 font-medium tracking-normal ml-0.5 relative -top-1">COP</span>
            </span>
            {origPrice && origPrice > showPrice && (
              <span class="text-sm md:text-lg text-stone-400 line-through font-light decoration-stone-300">
                ${origPrice.toLocaleString('es-CO')}
              </span>
            )}
            {discount > 0 && (
              <span class="bg-amber-100 text-amber-800 text-[10px] font-bold px-2 py-0.5 rounded-md">
                -{discount}%
              </span>
            )}
          </>
        ) : (
           <span class="text-amber-600 font-bold uppercase tracking-widest text-xs italic">Precio a consultar</span>
        )}
      </div>

      <!-- Botones de Acción (Comprar Ramo + WhatsApp) -->
      {inStock && showPrice > 0 && (
        <div class="flex gap-2 sm:gap-3 mb-6">
          <button 
            id="ramoCartBtn" 
            type="button" 
            data-product-id={product.id}
            onclick={`addToCartFromPage(${product.id})`}
            class="flex-1 inline-flex items-center justify-center gap-2 bg-[#1a1220] hover:bg-black text-white px-5 sm:px-7 py-3.5 sm:py-4 rounded-xl sm:rounded-2xl text-xs sm:text-sm font-bold tracking-wide transition-all shadow-lg active:scale-95 cursor-pointer relative overflow-hidden group"
          >
            <Icon name="shopping-bag-3" class="w-4 h-4 text-amber-400 group-hover:scale-110 transition-transform" />
            <span id="ramoCartBtnText">Comprar ramo</span>
          </button>
          <a 
            id="heroWaBtn"
            href={waUrl} 
            target="_blank" 
            class="inline-flex items-center justify-center gap-1.5 sm:gap-2 bg-emerald-600 hover:bg-emerald-700 text-white px-4 sm:px-6 py-3.5 sm:py-4 rounded-xl sm:rounded-2xl text-xs sm:text-sm font-bold tracking-wide transition-all shadow-md active:scale-95 whitespace-nowrap"
          >
            <Icon name="whatsapp" class="w-4 h-4" />
            <span>WhatsApp</span>
          </a>
        </div>
      )}

      <!-- Descripción & Beneficios del Ramo -->
      {product.desc && (
        <div class="pt-5 border-t border-stone-100/80">
           <div class="text-[9px] font-bold text-stone-400 uppercase tracking-[0.25em] mb-2.5">Por qué elegir este ramo</div>
           <p class="text-stone-600 leading-relaxed text-[13px] md:text-[14px] font-light max-w-[480px] mb-4">
             {product.desc}
           </p>
           <div class="space-y-2.5">
             <div class="flex items-start gap-2.5">
               <span class="w-4.5 h-4.5 rounded-full bg-amber-50 border border-amber-200 text-amber-700 flex items-center justify-center flex-shrink-0 mt-0.5" set:html={checkIconSvg}></span>
               <span class="text-slate-600 text-xs sm:text-[13px] leading-snug"><strong class="text-slate-800">No se marchita</strong> — Dura años, no días como las flores naturales</span>
             </div>
             <div class="flex items-start gap-2.5">
               <span class="w-4.5 h-4.5 rounded-full bg-amber-50 border border-amber-200 text-amber-700 flex items-center justify-center flex-shrink-0 mt-0.5" set:html={checkIconSvg}></span>
               <span class="text-slate-600 text-xs sm:text-[13px] leading-snug"><strong class="text-slate-800">100% artesanal</strong> — Cada pétalo tejido a mano con hilos premium</span>
             </div>
             <div class="flex items-start gap-2.5">
               <span class="w-4.5 h-4.5 rounded-full bg-amber-50 border border-amber-200 text-amber-700 flex items-center justify-center flex-shrink-0 mt-0.5" set:html={checkIconSvg}></span>
               <span class="text-slate-600 text-xs sm:text-[13px] leading-snug"><strong class="text-slate-800">Hipoalergénico</strong> — Sin polen, apto para cualquier persona</span>
             </div>
             <div class="flex items-start gap-2.5">
               <span class="w-4.5 h-4.5 rounded-full bg-amber-50 border border-amber-200 text-amber-700 flex items-center justify-center flex-shrink-0 mt-0.5" set:html={checkIconSvg}></span>
               <span class="text-slate-600 text-xs sm:text-[13px] leading-snug"><strong class="text-slate-800">Envío nacional seguro</strong> — Empaque rígido protector listo para regalar</span>
             </div>
           </div>
        </div>
      )}

    </div>
  </section>

  <!-- ════════ SECCIÓN: RESEÑAS / TESTIMONIOS (Clientes Felices) ════════ -->
  <TestimonialsSection />

  <!-- ════════ SECCIÓN: PREGUNTAS FRECUENTES (Objeciones) ════════ -->
  <section class="bg-white py-8 sm:py-12 border-t border-stone-100">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6">
      <div class="text-center max-w-lg mx-auto mb-6 sm:mb-8">
        <span class="inline-flex items-center bg-stone-100 border border-stone-200 text-stone-700 px-3 py-1 rounded-full text-[10px] sm:text-xs font-bold uppercase tracking-wider mb-2">
          Dudas comunes
        </span>
        <h2 class="font-serif text-2xl sm:text-3xl md:text-4xl font-light text-slate-800 leading-tight">
          Preguntas <em class="italic text-amber-600 font-normal">frecuentes</em>
        </h2>
      </div>
      
      <div class="grid md:grid-cols-2 gap-4 max-w-4xl mx-auto">
        <div class="bg-stone-50 p-5 rounded-2xl border border-stone-200/80 shadow-xs">
          <div class="font-bold text-slate-800 text-xs sm:text-[13px] mb-1.5 flex items-center gap-2">
            <Icon name="question-line" class="text-amber-600 w-4 h-4" /> ¿Llegan bien a otras ciudades?
          </div>
          <p class="text-slate-500 text-[11px] sm:text-xs leading-relaxed">Sí. El tejido a crochet es flexible pero resistente, y lo empacamos en una caja rígida reforzada que evita cualquier daño durante el transporte nacional.</p>
        </div>
        <div class="bg-stone-50 p-5 rounded-2xl border border-stone-200/80 shadow-xs">
          <div class="font-bold text-slate-800 text-xs sm:text-[13px] mb-1.5 flex items-center gap-2">
            <Icon name="question-line" class="text-amber-600 w-4 h-4" /> ¿Es seguro pagar por la web?
          </div>
          <p class="text-slate-500 text-[11px] sm:text-xs leading-relaxed">Usamos Wompi, la pasarela de pagos oficial de Bancolombia. Tu dinero está protegido y aceptamos Nequi, Daviplata, PSE y tarjetas.</p>
        </div>
        <div class="bg-stone-50 p-5 rounded-2xl border border-stone-200/80 shadow-xs">
          <div class="font-bold text-slate-800 text-xs sm:text-[13px] mb-1.5 flex items-center gap-2">
            <Icon name="question-line" class="text-amber-600 w-4 h-4" /> ¿Cuánto tiempo dura el ramo?
          </div>
          <p class="text-slate-500 text-[11px] sm:text-xs leading-relaxed">Es una flor eterna. No se marchita, no necesita agua y mantiene su color por años si se cuida del polvo y la humedad directa.</p>
        </div>
        <div class="bg-stone-50 p-5 rounded-2xl border border-stone-200/80 shadow-xs">
          <div class="font-bold text-slate-800 text-xs sm:text-[13px] mb-1.5 flex items-center gap-2">
            <Icon name="question-line" class="text-amber-600 w-4 h-4" /> ¿Tienen atención por WhatsApp?
          </div>
          <p class="text-slate-500 text-[11px] sm:text-xs leading-relaxed">¡Claro! Puedes escribirnos al 573144931525 en cualquier momento si prefieres asesoría directa o personalizar tu pedido.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════ SECCIÓN DE DETALLES ADICIONALES (Ficha Técnica & Materiales) ════════ -->
  {product.desc && (
    <section class="bg-stone-50/70 pt-6 pb-12 sm:pb-16 border-t border-stone-100">
      <div class="max-w-[1200px] mx-auto px-4 sm:px-6">
        <div class="bg-white rounded-2xl md:rounded-3xl border border-stone-200/80 shadow-xs px-5 sm:px-8 md:px-10 overflow-hidden">
          <button 
            onclick="document.getElementById('seoDetails').classList.toggle('hidden'); this.querySelector('.icon-unfold').classList.toggle('-rotate-180');"
            class="w-full flex items-center justify-between py-6 sm:py-8 group cursor-pointer"
          >
            <div class="flex items-center gap-4 sm:gap-6">
              <div class="hidden md:flex w-12 h-12 rounded-2xl border border-stone-200 bg-stone-50 items-center justify-center text-amber-600">
                <Icon name="plant" class="w-6 h-6" />
              </div>
              <div class="text-left">
                <span class="inline-flex items-center bg-amber-100/70 border border-amber-300/60 text-amber-900 px-2.5 py-0.5 rounded-full text-[9px] sm:text-[10px] font-bold uppercase tracking-wider mb-1.5">
                  Ficha Técnica
                </span>
                <h2 class="font-serif text-xl sm:text-2xl md:text-3xl font-light text-slate-800 group-hover:text-amber-600 transition-colors">
                  Materiales y <em class="italic text-amber-600 font-normal">cuidados</em> artesanos
                </h2>
              </div>
            </div>
            <div class="icon-unfold transition-transform duration-300 w-9 h-9 sm:w-10 sm:h-10 rounded-full border border-stone-200 flex items-center justify-center shadow-xs text-stone-600 bg-stone-50 group-hover:bg-amber-50 group-hover:text-amber-600 group-hover:border-amber-200">
              <Icon name="arrow-down-s" class="text-lg sm:text-xl" />
            </div>
          </button>

          <div id="seoDetails" class="hidden pt-2 pb-8 sm:pb-10 border-t border-stone-100">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-12 pt-4">
              <div class="md:col-span-2 space-y-6">
                <div>
                  <h3 class="font-bold text-[10px] sm:text-xs uppercase tracking-wider text-slate-700 mb-2">Sobre este ramo</h3>
                  <div class="text-slate-600 text-xs sm:text-[13px] leading-relaxed space-y-3 font-light">
                    <p>{product.desc}</p>
                    <p>Cada ramo de <strong>Nuditos Tejidos</strong> es una obra de arte única. Diseñado para perdurar, combina la calidez de lo artesanal con la belleza eterna de las flores que no se marchitan.</p>
                  </div>
                </div>
                
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 pt-6 border-t border-stone-100">
                  <div>
                    <h3 class="font-bold text-xs uppercase tracking-wider text-slate-800 mb-2 flex items-center gap-1.5">
                      <Icon name="plant" class="text-amber-600 w-4 h-4" /> Materiales Premium
                    </h3>
                    <p class="text-[11px] sm:text-xs text-slate-500 leading-relaxed">
                      Tejido con hilos de algodón premium de alta resistencia. Utilizamos rellenos hipoalergénicos y estructuras internas que mantienen la forma perfecta de cada pétalo y hoja.
                    </p>
                  </div>
                  <div>
                    <h3 class="font-bold text-xs uppercase tracking-wider text-slate-800 mb-2 flex items-center gap-1.5">
                      <Icon name="history" class="text-amber-600 w-4 h-4" /> Cuidados de tu Ramo
                    </h3>
                    <ul class="text-[11px] sm:text-xs text-slate-500 leading-relaxed space-y-1.5">
                      <li>• Mantener alejado de la humedad directa.</li>
                      <li>• Limpiar el polvo con un cepillo de cerdas suaves.</li>
                      <li>• Evitar la exposición solar prolongada continua.</li>
                    </ul>
                  </div>
                </div>
              </div>
              
              <div class="bg-stone-50 p-6 rounded-2xl border border-stone-200/80 h-fit">
                <h3 class="font-serif text-lg font-light text-slate-800 border-b border-stone-200 pb-3 mb-3">Envío Seguro</h3>
                <p class="text-[11px] sm:text-xs text-slate-500 leading-relaxed mb-4">
                  Empacamos cada pedido con protección rígida especial para que llegue impecable a su destino.
                </p>
                <div class="space-y-2.5 text-xs text-slate-700 font-medium">
                  <div class="flex items-center gap-2">
                    <Icon name="truck" class="text-amber-600 w-4 h-4" /> Envíos a toda Colombia
                  </div>
                  <div class="flex items-center gap-2">
                    <Icon name="checkbox-circle" class="text-emerald-600 w-4 h-4" /> Garantía de Entrega
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- ════════ SECCIÓN: PRODUCTOS RELACIONADOS ════════ -->
  {related.length > 0 && (
    <section class="bg-white border-t border-stone-100 py-8 sm:py-12 px-4 sm:px-6">
      <div class="max-w-[1200px] mx-auto">
        <div class="text-center max-w-lg mx-auto mb-6 sm:mb-8">
          <span class="inline-flex items-center bg-amber-100/70 border border-amber-300/60 text-amber-900 px-3 py-1 rounded-full text-[10px] sm:text-xs font-bold uppercase tracking-wider mb-2">
            Colección {catDisplayName}
          </span>
          <h2 class="font-serif text-2xl sm:text-3xl font-light text-slate-800 leading-tight">
            Más ramos para <em class="italic text-amber-600 font-normal">enamorar</em>
          </h2>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4 md:gap-6">
          {related.map((p: any) => <ProductCard p={p} idScope="related" />)}
        </div>
      </div>
    </section>
  )}

  <!-- ════════ LIGHTBOX PREMIUM CON ZOOM ════════ -->
  <div class="fixed inset-0 bg-stone-950/98 z-[2000] opacity-0 pointer-events-none transition-all duration-500 backdrop-blur-2xl flex flex-col" id="ramoLightbox">
    <div class="flex justify-between items-center p-4 sm:p-6 z-10">
      <div class="text-white/60 text-[10px] font-bold uppercase tracking-[0.2em]">Galería Nuditos</div>
      <button class="text-white/60 hover:text-white transition-colors p-2 cursor-pointer" onclick="closeLightbox()">
        <Icon name="close" class="text-2xl sm:text-3xl" />
      </button>
    </div>
    
    <div class="flex-1 overflow-hidden">
      <div class="swiper lightbox-swiper w-full h-full">
        <div class="swiper-wrapper">
          {allImgs.map((img: string, i: number) => (
            <div class="swiper-slide !flex items-center justify-center">
              <div class="swiper-zoom-container">
                <img 
                  src={clUrl(img, 1600)} 
                  alt={`Zoom ${product.name} ${i + 1}`} 
                  class="max-w-full max-h-screen object-contain"
                />
              </div>
            </div>
          ))}
        </div>
        <div class="swiper-pagination-lb absolute bottom-8 left-0 right-0 z-10 flex justify-center gap-2"></div>
      </div>
    </div>
    
    <div class="p-6 text-center text-white/40 text-[10px] uppercase tracking-widest pointer-events-none">
      Pellizca para hacer zoom · Desliza para navegar
    </div>
  </div>

  <!-- ════════ STICKY CTA BAR (Mobile & Desktop con Apple Glassmorphism) ════════ -->
  <div
    id="stickyCTA"
    class="fixed bottom-[68px] md:bottom-8 left-0 md:left-1/2 md:-translate-x-1/2 w-full md:w-[94%] md:max-w-[520px] z-[90] border-t md:border px-3.5 py-2.5 md:p-2.5 md:rounded-[2.5rem] transition-all duration-700 ease-[cubic-bezier(0.23,1,0.32,1)] translate-y-[150%] opacity-0 pointer-events-none"
  >
    <div class="flex items-center gap-2.5 sm:gap-3 max-w-[520px] mx-auto md:mx-0">
      <!-- Miniatura -->
      <div class="w-11 h-11 sm:w-12 sm:h-12 rounded-xl overflow-hidden bg-stone-50 border border-stone-200 flex-shrink-0">
        <img id="stickyProductImg" src={clUrl(mainImg, 120)} alt={product.name} class="w-full h-full object-cover" />
      </div>

      <!-- Texto del Ramo -->
      <div class="flex-1 min-w-0">
        <div id="stickyProductName" class="text-xs sm:text-[13px] font-bold text-stone-900 leading-tight truncate">
          {product.name}
        </div>
        <div class="text-[11px] sm:text-xs font-black text-amber-700 flex items-center gap-1.5 mt-0.5">
          <span id="stickyProductPrice">{showPrice > 0 ? `$${showPrice.toLocaleString('es-CO')}` : 'Consultar'}</span>
          <span class="text-[9px] text-emerald-600 font-bold bg-emerald-50 px-1.5 py-0.2 rounded border border-emerald-100/80">Envío gratis</span>
        </div>
      </div>

      <!-- Botón Comprar en Sticky -->
      <button 
        id="btnStickyBuy"
        type="button" 
        data-product-id={product.id}
        onclick={`addToCartFromPage(${product.id})`}
        class="bg-[#1a1220] hover:bg-black text-white px-4 sm:px-6 py-2.5 sm:py-3 rounded-xl sm:rounded-full text-xs font-bold tracking-wide active:scale-95 transition-all shadow-md flex items-center gap-1.5 flex-shrink-0 whitespace-nowrap cursor-pointer"
      >
        <Icon name="shopping-bag-3" class="w-3.5 h-3.5 text-amber-400" />
        <span id="btnStickyBuyText">Comprar</span>
      </button>
    </div>
  </div>

  <style>
    html { scroll-behavior: smooth; }

    /* Estilo base estándar para Android, Windows y otros navegadores */
    #stickyCTA { 
      will-change: transform, opacity; 
      background-color: #ffffff;
      border-color: rgba(231, 229, 228, 0.95);
      box-shadow: 0 -8px 24px rgba(0, 0, 0, 0.08), 0 2px 8px rgba(0, 0, 0, 0.04);
      z-index: 90 !important;
    }
    #stickyCTA.is-visible { transform: translate(0, 0); opacity: 1; pointer-events: auto; }
    @media (min-width: 768px) { 
      #stickyCTA.is-visible { transform: translate(-50%, 0); } 
      #stickyCTA {
        box-shadow: 0 16px 45px rgba(0, 0, 0, 0.14);
      }
    }

    /* Ocultar y enviar al fondo cuando el carrito esté abierto */
    :global(body.scroll-lock) #stickyCTA,
    :global(body:has(#cartPanel.open)) #stickyCTA {
      opacity: 0 !important;
      pointer-events: none !important;
      transform: translateY(150%) !important;
      z-index: 10 !important;
    }

    /* Efecto Glassmorphism exclusivo para iPhone, iPad y Mac */
    :global(html.is-apple) #stickyCTA {
      background-color: rgba(255, 255, 255, 0.82) !important;
      -webkit-backdrop-filter: blur(20px) saturate(180%);
      backdrop-filter: blur(20px) saturate(180%);
      border-color: rgba(255, 255, 255, 0.6) !important;
      box-shadow: 0 -8px 28px rgba(0, 0, 0, 0.08), 0 1px 0 rgba(255, 255, 255, 0.7) inset !important;
    }
    @media (min-width: 768px) {
      :global(html.is-apple) #stickyCTA {
        background-color: rgba(255, 255, 255, 0.86) !important;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.16), 0 1px 0 rgba(255, 255, 255, 0.8) inset !important;
      }
    }

    @media (max-width: 768px) {
      :global(body:has(#stickyCTA.is-visible) .wa-float) {
        opacity: 0 !important; transform: scale(0) !important; pointer-events: none !important;
      }
    }

    /* Lightbox */
    #ramoLightbox.open { opacity: 1; pointer-events: auto; }
    #ramoLightbox.open img { transform: scale(1); }
    #ramoLightbox img { transform: scale(0.95); transition: transform 0.4s cubic-bezier(0.165, 0.84, 0.44, 1); }
  </style>

  <script is:inline set:html={`
    window.NUDITOS_LIVE_PRODUCTS = [${JSON.stringify(currentProduct)}, ...(window.NUDITOS_LIVE_PRODUCTS || [])];
  `} />

  <script is:inline>
    // Detección de dispositivos Apple (iOS / macOS) para el efecto Glassmorphism
    (function() {
      var isApple = /iPad|iPhone|iPod|Macintosh/.test(navigator.userAgent) && !window.MSStream;
      if (isApple) {
        document.documentElement.classList.add('is-apple');
      }
    })();

    // Manejador del botón Comprar
    window.addToCartFromPage = function(id) {
      if (typeof addToCart !== 'function') return;
      addToCart(id);

      // Feedback visual en botón Hero
      var btn = document.getElementById('ramoCartBtn');
      if (btn) {
        var btnText = document.getElementById('ramoCartBtnText');
        var orig = btnText ? btnText.textContent : 'Comprar ramo';
        btn.classList.add('bg-emerald-600', 'hover:bg-emerald-700', 'scale-[1.02]');
        btn.classList.remove('bg-[#1a1220]', 'hover:bg-black');
        if (btnText) btnText.textContent = '¡Ramo agregado!';
        setTimeout(function() {
          btn.classList.remove('bg-emerald-600', 'hover:bg-emerald-700', 'scale-[1.02]');
          btn.classList.add('bg-[#1a1220]', 'hover:bg-black');
          if (btnText) btnText.textContent = orig;

          // Abrir carrito
          if (typeof openCart === 'function') {
            openCart();
          } else if (typeof toggleCart === 'function') {
            toggleCart();
          }
        }, 700);
      }

      // Feedback visual en botón Sticky
      var stickyBtn = document.getElementById('btnStickyBuy');
      if (stickyBtn) {
        var stickyBtnText = document.getElementById('btnStickyBuyText');
        var origSticky = stickyBtnText ? stickyBtnText.textContent : 'Comprar';
        stickyBtn.classList.add('bg-emerald-600', 'hover:bg-emerald-700');
        stickyBtn.classList.remove('bg-[#1a1220]', 'hover:bg-black');
        if (stickyBtnText) stickyBtnText.textContent = '¡Listo!';
        setTimeout(function() {
          stickyBtn.classList.remove('bg-emerald-600', 'hover:bg-emerald-700');
          stickyBtn.classList.add('bg-[#1a1220]', 'hover:bg-black');
          if (stickyBtnText) stickyBtnText.textContent = origSticky;
        }, 700);
      }

      // Tracking Pixel
      var prods = window.NUDITOS_LIVE_PRODUCTS || [];
      var cur = prods.find(function(p) { return p.id === id; });
      if (cur) {
        if (typeof window.fbq === 'function') {
          window.fbq('track', 'AddToCart', {
            content_ids: [cur.id.toString()],
            content_name: cur.name,
            content_type: 'product',
            value: Number(cur.price || 0),
            currency: 'COP'
          });
        }
        if (typeof window.ttq === 'object') {
          window.ttq.track('AddToCart', {
            contents: [{
              content_id: cur.id.toString(),
              content_name: cur.name,
              content_type: 'product',
              price: Number(cur.price || 0),
              quantity: 1
            }],
            value: Number(cur.price || 0),
            currency: 'COP'
          });
        }
      }
    };

    window.gallerySwiper = null;
    window.lightboxSwiper = null;

    function initSwipers() {
      if (!window.Swiper) return;

      var galleryEl = document.querySelector('.product-gallery-swiper');
      if (galleryEl && !window.gallerySwiper) {
        var slidesCount = galleryEl.querySelectorAll('.swiper-slide').length;
        window.gallerySwiper = new window.Swiper('.product-gallery-swiper', {
          slidesPerView: 1,
          spaceBetween: 0,
          speed: 800,
          loop: slidesCount > 1,
          pagination: { 
            el: '.swiper-pagination', 
            clickable: true, 
            dynamicBullets: true 
          },
          on: { 
            slideChange: function() { 
              updateThumbs(this.realIndex); 
            } 
          }
        });
      }

      var lightboxEl = document.querySelector('.lightbox-swiper');
      if (lightboxEl && !window.lightboxSwiper) {
        window.lightboxSwiper = new window.Swiper('.lightbox-swiper', {
          slidesPerView: 1,
          spaceBetween: 40,
          speed: 800,
          zoom: {
            maxRatio: 3,
            minRatio: 1,
          },
          grabCursor: true,
          keyboard: { enabled: true },
          on: {
            slideChange: function() {
              if (window.gallerySwiper) window.gallerySwiper.slideToLoop(this.activeIndex);
            }
          }
        });
      }
    }

    function updateThumbs(idx) {
      document.querySelectorAll('.ramo-thumb').forEach(function(t, i) {
        var isActive = (i === idx);
        if (isActive) {
          t.classList.add('border-amber-500', 'opacity-100', 'shadow-sm', 'ring-2', 'ring-amber-400/30');
          t.classList.remove('border-transparent', 'opacity-60');
        } else {
          t.classList.remove('border-amber-500', 'opacity-100', 'shadow-sm', 'ring-2', 'ring-amber-400/30');
          t.classList.add('border-transparent', 'opacity-60');
        }
      });
    }

    window.openLightbox = function(idx) {
      var box = document.getElementById('ramoLightbox');
      if (box) { 
        box.classList.add('open'); 
        document.body.style.overflow = 'hidden';
        if (window.lightboxSwiper) {
          window.lightboxSwiper.slideTo(idx, 0);
          window.lightboxSwiper.update();
        }
      }
    };

    window.closeLightbox = function() {
      var box = document.getElementById('ramoLightbox');
      if (box) box.classList.remove('open');
      document.body.style.overflow = '';
    };

    (function() {
      // 1. Sticky CTA Observer
      var stickyCTA = document.getElementById('stickyCTA');
      if (stickyCTA) {
        window.addEventListener('scroll', function() {
          if (window.scrollY > 450) stickyCTA.classList.add('is-visible');
          else stickyCTA.classList.remove('is-visible');
        }, { passive: true });
      }

      // 2. Madre countdown si aplica
      if (document.getElementById('madreCountdown')) {
        var target = new Date('2026-05-10T23:59:59-05:00').getTime();
        function updateCd() {
          var now = Date.now();
          var diff = target - now;
          if (diff <= 0) return;
          var d = Math.floor(diff / (1000 * 60 * 60 * 24));
          var h = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
          var m = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
          var dEl = document.getElementById('cdDays');
          var hEl = document.getElementById('cdHours');
          var mEl = document.getElementById('cdMins');
          if (dEl) dEl.textContent = String(d).padStart(2, '0');
          if (hEl) hEl.textContent = String(h).padStart(2, '0');
          if (mEl) mEl.textContent = String(m).padStart(2, '0');
        }
        updateCd();
        setInterval(updateCd, 60000);
      }
    })();

    document.addEventListener('astro:page-load', function() {
      initSwipers();
    });

    if (document.readyState === 'complete' || document.readyState === 'interactive') {
      initSwipers();
    }
  </script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/Swiper/11.0.5/swiper-bundle.min.js" defer is:inline onload="window.initSwipers ? window.initSwipers() : null"></script>
</Layout>
