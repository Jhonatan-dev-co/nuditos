    async function sendModalEmailAction(tipo) {
      const menu = document.getElementById('mpEmailActionsMenu');
      if (menu) menu.style.display = 'none';

      if (!currentModalPedidoId) {
        showToast('⚠️ No hay pedido abierto en el modal');
        return;
      }

      const p = pedidos.find(x => String(x.id) === String(currentModalPedidoId));
      if (!p) {
        showToast('⚠️ No se encontró la información del pedido');
        return;
      }

      // Si el admin escribió una guía o transportadora en el formulario, sincronizarla
      const gInput = document.getElementById('pGuia')?.value?.trim();
      if (gInput) p.guia = gInput;
      const tInput = document.getElementById('pTrans')?.value?.trim();
      if (tInput) p.transportadora = tInput;
      const eInput = document.getElementById('pEmail')?.value?.trim();
      if (eInput) p.clienteEmail = eInput;

      if ((tipo === 'pedido_enviado' || tipo === 'envio_encamino' || tipo === 'envio_reparto') && !p.guia) {
        showToast('⚠️ Primero ingresa o genera un número de guía');
        return;
      }

      await triggerEnvioEmail(p, tipo);
    }

