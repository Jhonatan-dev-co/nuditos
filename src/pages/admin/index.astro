    async function testEmailConfig() {
      const recipientEl = document.getElementById('testEmailRecipient');
      const statusEl = document.getElementById('testEmailStatus');
      const btnEl = document.getElementById('btnTestEmail');
      const recipient = (recipientEl?.value || '').trim() || (document.getElementById('adminEmail')?.value || '').trim();

      if (!recipient || !recipient.includes('@')) {
        showToast('⚠️ Ingresa un correo válido para realizar la prueba');
        if (recipientEl) recipientEl.focus();
        return;
      }

      if (btnEl) { btnEl.disabled = true; btnEl.innerHTML = '⏳ Enviando...'; }
      if (statusEl) {
        statusEl.style.display = 'block';
        statusEl.style.background = '#f3f4f6';
        statusEl.style.color = '#374151';
        statusEl.innerHTML = '⏳ Conectando con la API de Resend y despachando correo de prueba...';
      }

      try {
        const res = await sbAdminSendEmail('test_email', { to: recipient });
        if (res.ok) {
          if (statusEl) {
            statusEl.style.background = '#ecfdf5';
            statusEl.style.color = '#065f46';
            statusEl.innerHTML = `✅ <strong>¡Correo enviado con éxito!</strong> Revisa la bandeja de entrada (o spam) de <strong>${recipient}</strong>. (ID: ${res.messageId || 'ok'})`;
          }
          showToast('✓ Correo de prueba enviado');
        } else {
          if (statusEl) {
            statusEl.style.background = '#fef2f2';
            statusEl.style.color = '#991b1b';
            statusEl.innerHTML = `❌ <strong>Error al enviar:</strong> ${res.error || 'Resend rechazó la solicitud'}.<br><small style="color:#b91c1c;">${res.detail?.message || res.detail?.error || 'Asegúrate de que la API Key sea correcta y que el dominio remitente esté configurado'}</small>`;
          }
          showToast('❌ Falla en la prueba de correo');
        }
      } catch (e) {
        if (statusEl) {
          statusEl.style.background = '#fef2f2';
          statusEl.style.color = '#991b1b';
          statusEl.innerHTML = `❌ Error de red: ${e.message}`;
        }
      } finally {
        if (btnEl) { btnEl.disabled = false; btnEl.innerHTML = '🧪 Probar Ahora'; }
      }
    }

