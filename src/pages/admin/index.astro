    async function savePedido() {
      const editId = document.getElementById('pedidoEditId').value;
      const data = {
        cliente: document.getElementById('pCliente').value.trim(),
        clienteEmail: document.getElementById('pEmail').value.trim(),
        tel: document.getElementById('pTel').value.trim(),
        items: document.getElementById('pItems').value.trim(),
        total: parseInt(document.getElementById('pTotal').value) || 0,
        estado: document.getElementById('pEstado').value,
        notas: document.getElementById('pNotas').value.trim(),
        transportadora: document.getElementById('pTrans').value.trim(),
        guia: document.getElementById('pGuia').value.trim()
      };

      const dirEl = document.getElementById('pDireccion');
      if (dirEl && dirEl.value.trim()) data.direccion = dirEl.value.trim();

      const ciudadEl = document.getElementById('pCiudad');
      if (ciudadEl && ciudadEl.value.trim()) {
        const parts = ciudadEl.value.trim().split(',');
        data.ciudad = parts[0]?.trim() || '';
        if (parts[1]) data.departamento = parts[1]?.trim();
      }

      const barrioEl = document.getElementById('pBarrio');
      if (barrioEl && barrioEl.value.trim()) data.barrio = barrioEl.value.trim();

      const fotoEl = document.getElementById('pCustomFoto');
      if (fotoEl && fotoEl.value.trim()) data.foto = fotoEl.value.trim();

      if (!data.cliente) {
        showToast('⚠️ Ingresa el nombre del cliente');
        return;
      }

      const oldPedido = editId ? pedidos.find(x => String(x.id) === String(editId)) : null;
      try {
        if (editId) {
          await sbAdminSavePedido({ ...data, id: parseInt(editId), _isNew: false });
          const idx = pedidos.findIndex(p => String(p.id) === String(editId));
          if (idx !== -1) pedidos[idx] = { ...pedidos[idx], ...data, id: parseInt(editId) };

          if (data.estado === 'entregado' && data.guia && oldPedido?.estado !== 'entregado') {
            triggerEnvioEmail(pedidos[idx], 'envio_entregado');
          } else if (data.guia && !oldPedido?.guia && data.estado !== 'pendiente') {
            triggerEnvioEmail(pedidos[idx], 'pedido_enviado');
          }
          showToast('✓ Pedido actualizado con éxito');
        } else {
          const saved = await sbAdminSavePedido({ ...data, _isNew: true });
          if (saved) pedidos.unshift(saved);
          showToast('✓ Nuevo pedido registrado');
        }
        closePedidoModal();
        renderPedidosList();
      } catch (err) {
        console.error(err);
        showToast('❌ Error al guardar pedido');
      }
    }

