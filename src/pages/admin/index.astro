    function openMiPedido(id) {
      const p = pedidos.find(x => String(x.id) === String(id));
      if (!p) return;
      currentModalPedidoId = p.id;
      currentModalProducts = resolveOrderProducts(p);
      currentModalSelectedProductIndex = 0;

      const eLabels = { 
        pendiente: SVG_ADMIN.time + ' Pendiente', 
        pagado: SVG_ADMIN.card + ' Pagado', 
        proceso: SVG_ADMIN.refresh + ' En proceso', 
        entregado: SVG_ADMIN.check + ' Entregado', 
        cancelado: SVG_ADMIN.close + ' Cancelado' 
      };
      const eCls = { pendiente:'estado-pendiente', pagado:'estado-pagado', proceso:'estado-proceso', entregado:'estado-entregado', cancelado:'estado-cancelado' };

      // Encabezado
      const titleEl = document.getElementById('mpHeaderTitle');
      if (titleEl) titleEl.textContent = 'Mi Pedido';
      const idEl = document.getElementById('mpHeaderId');
      if (idEl) idEl.textContent = '#' + String(p.id).slice(-6);
      const clientNameEl = document.getElementById('mpHeaderClientName');
      if (clientNameEl) clientNameEl.textContent = p.cliente || 'Cliente sin nombre';
      const dateEl = document.getElementById('mpHeaderDate');
      if (dateEl) dateEl.textContent = p.fecha ? 'Registrado: ' + p.fecha : 'Hoy';
      const statusEl = document.getElementById('mpHeaderStatus');
      if (statusEl) {
        statusEl.innerHTML = eLabels[p.estado] || p.estado;
        statusEl.className = 'pedido-estado ' + (eCls[p.estado] || 'estado-pendiente');
      }

      // Avatar con iniciales
      const avatarEl = document.getElementById('mpHeaderAvatar');
      if (avatarEl) {
        const initials = (p.cliente || '').trim().split(' ').filter(Boolean).map(w=>w[0]).join('').slice(0,2).toUpperCase();
        avatarEl.innerHTML = initials || SVG_ADMIN.plant;
      }

      // Botón WhatsApp en cabecera
      const headerWa = document.getElementById('mpHeaderWaBtn');
      const cleanWa = (p.tel || '').replace(/\D/g, '');
      if (headerWa) {
        if (cleanWa) {
          const waNum = cleanWa.startsWith('57') ? cleanWa : (cleanWa.length === 10 ? '57' + cleanWa : cleanWa);
          headerWa.href = `https://wa.me/${waNum}?text=${encodeURIComponent('¡Hola ' + (p.cliente || '') + '! Te saludamos de Nuditos Tejidos sobre tu pedido #' + String(p.id).slice(-6) + ' 🌸')}`;
          headerWa.style.display = 'inline-flex';
        } else {
          headerWa.style.display = 'none';
        }
      }

      // Lado Izquierdo: Vista de Datos en Acordeones
      const vCliente = document.getElementById('mpViewCliente');
      if (vCliente) vCliente.textContent = p.cliente || '—';

      const vTel = document.getElementById('mpViewTel');
      if (vTel) vTel.textContent = p.tel || '—';

      const linkWa = document.getElementById('mpLinkWa');
      if (linkWa) {
        if (cleanWa) {
          const waNum = cleanWa.startsWith('57') ? cleanWa : (cleanWa.length === 10 ? '57' + cleanWa : cleanWa);
          linkWa.href = `https://wa.me/${waNum}?text=${encodeURIComponent('¡Hola ' + (p.cliente || '') + '! Te saludamos de Nuditos Tejidos sobre tu pedido #' + String(p.id).slice(-6) + ' 🌸')}`;
          linkWa.style.display = 'inline-flex';
        } else {
          linkWa.style.display = 'none';
        }
      }

      const vEmail = document.getElementById('mpViewEmail');
      if (vEmail) vEmail.textContent = p.clienteEmail || '—';

      const vDir = document.getElementById('mpViewDireccion');
      if (vDir) vDir.textContent = p.direccion || (p.notas ? p.notas.split('|')[0].trim() : '—');

      const vCiudad = document.getElementById('mpViewCiudad');
      if (vCiudad) vCiudad.textContent = [p.ciudad, p.departamento].filter(Boolean).join(', ') || '—';

      const vBarrio = document.getElementById('mpViewBarrio');
      if (vBarrio) vBarrio.textContent = [p.barrio ? 'Barrio ' + p.barrio : '', p.codigoPostal ? 'CP: ' + p.codigoPostal : ''].filter(Boolean).join(' · ') || '—';

      const vTrans = document.getElementById('mpViewTrans');
      if (vTrans) vTrans.textContent = p.transportadora || 'Skydropx / Por asignar';

      const vGuia = document.getElementById('mpViewGuia');
      if (vGuia) vGuia.textContent = p.guia || 'Sin guía asignada';

      const vDed = document.getElementById('mpViewDedicatoria');
      if (vDed) vDed.textContent = `«${extractDedicatoria(p)}»`;

      const vItemsList = document.getElementById('mpViewItemsList');
      if (vItemsList) {
        vItemsList.innerHTML = currentModalProducts.map(item => `
          <div style="display:flex; justify-content:space-between; align-items:center; background:#fff; padding:0.65rem 1rem; border-radius:12px; border:1px solid var(--border); box-shadow:0 1px 4px rgba(0,0,0,0.02);">
            <div style="display:flex; align-items:center; gap:0.75rem;">
              <span style="background:var(--lila-light); color:var(--lila-dark); font-weight:700; font-size:0.8rem; padding:3px 9px; border-radius:8px;">${item.qty}x</span>
              <span style="font-weight:600; font-size:0.92rem; color:var(--text);">${item.name}</span>
            </div>
            <span style="font-size:0.92rem; font-weight:700; color:var(--lila-dark); font-family:'Playfair Display',serif;">${item.price > 0 ? '$' + (item.price * item.qty).toLocaleString('es-CO') + ' COP' : ''}</span>
          </div>
        `).join('');
      }

      const vTotal = document.getElementById('mpViewTotal');
      if (vTotal) vTotal.textContent = p.total > 0 ? '$' + p.total.toLocaleString('es-CO') + ' COP' : '$0 COP';

      // Lado Derecho: Vitrina del Ramo en PC
      renderActiveBouquetPhoto();

      // Pre-llenar Formulario de Edición a Pantalla Completa
      document.getElementById('pedidoEditId').value = p.id;
      document.getElementById('pCliente').value = p.cliente || '';
      document.getElementById('pEmail').value = p.clienteEmail || '';
      document.getElementById('pTel').value = p.tel || '';
      document.getElementById('pItems').value = p.items || '';
      document.getElementById('pTotal').value = p.total || '';
      document.getElementById('pEstado').value = p.estado || 'pendiente';
      document.getElementById('pNotas').value = p.notas || '';
      document.getElementById('pTrans').value = p.transportadora || '';
      document.getElementById('pGuia').value = p.guia || '';
      if (document.getElementById('pDireccion')) document.getElementById('pDireccion').value = p.direccion || '';
      if (document.getElementById('pCiudad')) document.getElementById('pCiudad').value = [p.ciudad, p.departamento].filter(Boolean).join(', ');
      if (document.getElementById('pBarrio')) document.getElementById('pBarrio').value = p.barrio || '';
      if (document.getElementById('pCustomFoto')) document.getElementById('pCustomFoto').value = p.foto || '';

      populateCatalogSelect();
      syncModalFooterStatusPills(p.estado || 'pendiente');

      // Iniciar en Vista de Despacho (Lado a Lado)
      setPedidoViewMode(false);

      const delBtn = document.getElementById('mpBtnDeleteCurrent');
      if (delBtn) delBtn.style.display = 'inline-block';

      document.getElementById('pedidoModal').classList.add('open');
    }

    function openEditPedido(id) {
      openMiPedido(id);
      setPedidoViewMode(true);
    }

    function openNewPedido() {
      currentModalPedidoId = '';
      currentModalProducts = [];
      currentModalSelectedProductIndex = 0;

      document.getElementById('pedidoEditId').value = '';
      const fields = ['pCliente', 'pEmail', 'pTel', 'pItems', 'pTotal', 'pNotas', 'pTrans', 'pGuia', 'pDireccion', 'pCiudad', 'pBarrio', 'pCustomFoto'];
      fields.forEach(id => {
        const el = document.getElementById(id);
        if (el) el.value = '';
      });
      document.getElementById('pEstado').value = 'pendiente';

      const avatarEl = document.getElementById('mpHeaderAvatar');
      if (avatarEl) avatarEl.innerHTML = SVG_ADMIN.package;

