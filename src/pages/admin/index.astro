    function normStr(str) {
      return (str || '').toLowerCase()
        .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
        .replace(/[^a-z0-9]/g, ' ').replace(/\s+/g, ' ').trim();
    }

    function resolveOrderProducts(order) {
      const itemsStr = order.items || '';
      let lines = [];
      if (itemsStr.startsWith('[') || itemsStr.startsWith('{')) {
        try {
          const parsed = JSON.parse(itemsStr);
          if (Array.isArray(parsed)) lines = parsed.map(x => (x.qty ? x.qty + 'x ' : '') + (x.name || x.title || ''));
          else if (parsed.name) lines = [(parsed.qty ? parsed.qty + 'x ' : '') + parsed.name];
        } catch {}
      }
      if (!lines.length) {
        lines = itemsStr.split(/[\n,]+/).map(s => s.trim()).filter(Boolean);
      }
      if (!lines.length) lines = ['Ramo tejido'];

      const catalog = (adminProducts && adminProducts.length) ? adminProducts : (typeof products !== 'undefined' ? products : []);
      const results = [];

      for (const raw of lines) {
        const qtyMatch = raw.match(/^(\d+)\s*x\s*(.*)$/i);
        const qty = qtyMatch ? parseInt(qtyMatch[1]) || 1 : 1;
        const clean = qtyMatch ? qtyMatch[2].trim() : raw.trim();
        const cNorm = normStr(clean);

        // 1. Coincidencia exacta
        let match = catalog.find(x => normStr(x.name) === cNorm);
        
        // 2. Coincidencia por inclusión
        if (!match) {
          match = catalog.find(x => normStr(x.name).includes(cNorm) || cNorm.includes(normStr(x.name)));
        }

        // 3. Coincidencia por palabras clave / tokens
        if (!match) {
          const stopWords = new Set(['ramo', 'de', 'con', 'y', 'el', 'la', 'a', 'en', 'para']);
          const tokens = cNorm.split(' ').filter(t => t.length > 2 && !stopWords.has(t));
          let best = null, maxScore = 0;
          for (const prod of catalog) {
            const pTokens = normStr(prod.name).split(' ');
            let score = 0;
            for (const t of tokens) {
              if (pTokens.includes(t)) score += 2;
              else if (normStr(prod.name).includes(t)) score += 1;
            }
            if (score > maxScore) {
              maxScore = score;
              best = prod;
            }
          }
          if (maxScore >= 1) match = best;
        }

        let finalImg = (match && match.img) ? match.img : (order.foto || DEFAULT_RAMO_FALLBACK);
        if (finalImg && finalImg.includes('cloudinary.com') && !finalImg.includes('q_auto')) {
          finalImg = finalImg.replace('/upload/', '/upload/q_auto,f_auto,w_800/');
        }

        results.push({
          rawName: clean,
          qty,
          matched: !!match,
          name: match ? match.name : clean,
          price: match ? (match.precioOferta || match.price || 0) : 0,
          cat: match ? (match.cat || 'Ramo de crochet') : 'Ramo de crochet',
          slug: match ? (match.slug || '') : '',
          img: finalImg,
          id: match ? match.id : null
        });
      }
      return results;
    }

    function copyTextWithFeedback(text, label, btnEl) {
      if (!text || text === '—') {
        showToast('⚠️ Campo vacío');
        return;
      }
      const doSuccess = () => {
        showToast('📋 Copiado: ' + label);
        if (btnEl) {
          const origHtml = btnEl.innerHTML;
          btnEl.classList.add('copied');
          btnEl.innerHTML = '✓ ¡Copiado!';
          setTimeout(() => {
            btnEl.classList.remove('copied');
            btnEl.innerHTML = origHtml;
          }, 1600);
        }
      };

      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(doSuccess).catch(() => {
          fallbackCopyText(text, doSuccess);
        });
      } else {
        fallbackCopyText(text, doSuccess);
      }
    }

    function fallbackCopyText(text, cb) {
      try {
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
        if (cb) cb();
      } catch {
        showToast('❌ Error al copiar');
      }
    }

    function copyOrderField(fieldKey, label, btnEl) {
      const p = pedidos.find(x => String(x.id) === String(currentModalPedidoId));
      if (!p && fieldKey !== 'foto_url' && fieldKey !== 'ramo_nombre') return;

      let valueToCopy = '';
      if (fieldKey === 'id') valueToCopy = p ? String(p.id) : '';
      else if (fieldKey === 'cliente') valueToCopy = p?.cliente || '';
      else if (fieldKey === 'tel') valueToCopy = p?.tel || '';
      else if (fieldKey === 'email') valueToCopy = p?.clienteEmail || '';
      else if (fieldKey === 'direccion') valueToCopy = p?.direccion || p?.notas?.split('|')[0]?.trim() || '';
      else if (fieldKey === 'direccion_completa') {
        valueToCopy = [
          p?.direccion,
          p?.barrio ? 'Barrio ' + p.barrio : '',
          p?.ciudad,
          p?.departamento,
          p?.codigoPostal ? 'CP: ' + p.codigoPostal : ''
        ].filter(Boolean).join(', ') || p?.notas || '';
      }
      else if (fieldKey === 'ciudad') valueToCopy = [p?.ciudad, p?.departamento].filter(Boolean).join(', ') || '';
      else if (fieldKey === 'barrio') valueToCopy = p?.barrio || '';
      else if (fieldKey === 'guia') valueToCopy = p?.guia || '';
      else if (fieldKey === 'dedicatoria') {
        const ded = extractDedicatoria(p);
        valueToCopy = ded !== '«Sin dedicatoria especial»' ? ded : '';
      }
      else if (fieldKey === 'items') valueToCopy = p?.items || '';
      else if (fieldKey === 'total') valueToCopy = p?.total ? String(p.total) : '0';
      else if (fieldKey === 'ramo_nombre') {
        const prod = currentModalProducts[currentModalSelectedProductIndex] || currentModalProducts[0];
        valueToCopy = prod ? prod.name : (p?.items || '');
      }
      else if (fieldKey === 'foto_url') {
        const prod = currentModalProducts[currentModalSelectedProductIndex] || currentModalProducts[0];
        valueToCopy = prod ? prod.img : '';
      }

      copyTextWithFeedback(valueToCopy, label, btnEl);
    }

    function extractDedicatoria(p) {
      if (!p) return '«Sin dedicatoria especial»';
      let raw = p.notas || '';
      if (raw.includes('|')) {
        const parts = raw.split('|').map(s => s.trim());
        const notePart = parts.find(part => !part.toLowerCase().startsWith('wa username') && part.length > 5);
        if (notePart) raw = notePart;
      }
      if (!raw || raw.length < 2) return '«Sin dedicatoria especial»';
      return raw.replace(/^(nota|mensaje|dedicatoria):\s*/i, '').trim();
    }

