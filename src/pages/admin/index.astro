    async function cambiarEstadoPedido(id, nuevoEstado) {
      try {
        const p = pedidos.find(x => String(x.id) === String(id));
        const oldEstado = p?.estado;
        await sbAdminUpdateEstadoPedido(id, nuevoEstado);
        if (p) {
          p.estado = nuevoEstado;
          const idx = pedidos.findIndex(x => String(x.id) === String(id));
          if (idx !== -1) pedidos[idx].estado = nuevoEstado;
        }
        renderPedidosList();
        showToast(`✓ Pedido #${id} cambiado a [${nuevoEstado}]`);

        // Disparar correos automáticos si tiene email
        if (p && p.clienteEmail && p.clienteEmail.includes('@')) {
          if (nuevoEstado === 'entregado' && oldEstado !== 'entregado') {
            triggerEnvioEmail(p, 'envio_entregado');
          } else if (nuevoEstado === 'proceso' && p.guia && oldEstado === 'pendiente') {
            triggerEnvioEmail(p, 'pedido_enviado');
          }
        }
      } catch (err) {
        console.error(err);
        showToast('❌ Error al actualizar estado');
      }
    }

    async function triggerEnvioEmail(pedido, tipo = 'compra_confirmada') {
      if (!pedido) return;
      const email = pedido.clienteEmail || pedido.email || '';
      if (tipo !== 'notificacion_admin' && (!email || !email.includes('@'))) {
        showToast('⚠️ El pedido no tiene un correo válido registrado');
        return;
      }

      const nombres = {
        compra_confirmada: 'Confirmación de Compra',
        pedido_enviado: 'Guía de Envío',
        envio_encamino: 'Paquete en Camino',
        envio_reparto: 'Paquete en Reparto',
        envio_entregado: 'Pedido Entregado',
        notificacion_admin: 'Alerta a Administrador'
      };

      showToast(`📧 Enviando ${nombres[tipo] || tipo}...`);

      try {
        const payload = {
          pedidoId: pedido.id,
          clienteNombre: pedido.cliente || pedido.cliente_nombre || 'Cliente',
          clienteEmail: email,
          total: pedido.total || 0,
          items: pedido.items || '',
          tel: pedido.tel || pedido.cliente_telefono || '',
          notas: pedido.notas || pedido.direccion || '',
          guia: pedido.guia || '',
          transportadora: pedido.transportadora || 'Transportadora'
        };

        const res = await sbAdminSendEmail(tipo, payload);
        if (res.ok) {
          const dest = tipo === 'notificacion_admin' ? (adminCfg.adminEmail || 'taller') : email;
          showToast(`✅ ${nombres[tipo] || tipo} enviado con éxito a ${dest}`);
        } else {
          console.warn('[triggerEnvioEmail] Fallo de Resend:', res.error);
          showToast(`⚠️ Error al enviar: ${res.error || 'Resend rechazó el correo'}`);
        }
      } catch (err) {
        console.error('[triggerEnvioEmail] Error fatal:', err);
        showToast('❌ Error de conexión al enviar correo');
      }
    }

