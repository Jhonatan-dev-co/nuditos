    function renderPedidosList() {
      // 1. Actualizar KPIs y Contadores
      const totalCount = pedidos.length;
      const countPendiente = pedidos.filter(p => p.estado === 'pendiente').length;
      const countPagado = pedidos.filter(p => p.estado === 'pagado').length;
      const countProceso = pedidos.filter(p => p.estado === 'proceso').length;
      const countEntregado = pedidos.filter(p => p.estado === 'entregado').length;

      const kpiTotal = document.getElementById('kpiTotalPedidos');
      if (kpiTotal) kpiTotal.textContent = totalCount;
      const kpiPend = document.getElementById('kpiPendientes');
      if (kpiPend) kpiPend.textContent = countPendiente;
      const kpiPag = document.getElementById('kpiPagados');
      if (kpiPag) kpiPag.textContent = countPagado;
      const kpiProc = document.getElementById('kpiProceso');
      if (kpiProc) kpiProc.textContent = countProceso;
      const kpiEntr = document.getElementById('kpiEntregados');
      if (kpiEntr) kpiEntr.textContent = countEntregado;

      // Badges en botones de filtro
      const bTodos = document.getElementById('badgeCountTodos');
      if (bTodos) bTodos.textContent = totalCount;
      const bPend = document.getElementById('badgeCountPendiente');
      if (bPend) bPend.textContent = countPendiente;
      const bPag = document.getElementById('badgeCountPagado');
      if (bPag) bPag.textContent = countPagado;
      const bProc = document.getElementById('badgeCountProceso');
      if (bProc) bProc.textContent = countProceso;
      const bEntr = document.getElementById('badgeCountEntregado');
      if (bEntr) bEntr.textContent = countEntregado;

      // 2. Filtrar lista
      let list = pedidoFilter === 'todos' ? pedidos : pedidos.filter(p => p.estado === pedidoFilter);
      if (pedidoSearchQuery) {
        list = list.filter(p => {
          const idMatch = String(p.id).toLowerCase().includes(pedidoSearchQuery);
          const cliMatch = (p.cliente || '').toLowerCase().includes(pedidoSearchQuery);
          const telMatch = (p.tel || '').toLowerCase().includes(pedidoSearchQuery);
          const itemMatch = (p.items || '').toLowerCase().includes(pedidoSearchQuery);
          const guiaMatch = (p.guia || '').toLowerCase().includes(pedidoSearchQuery);
          return idMatch || cliMatch || telMatch || itemMatch || guiaMatch;
        });
      }

      const eLabels = { 
        pendiente: SVG_ADMIN.time + ' Pendiente', 
        pagado: SVG_ADMIN.card + ' Pagado', 
        proceso: SVG_ADMIN.refresh + ' En proceso', 
        entregado: SVG_ADMIN.check + ' Entregado', 
        cancelado: SVG_ADMIN.close + ' Cancelado' 
      };
      const eCls = { pendiente:'estado-pendiente', pagado:'estado-pagado', proceso:'estado-proceso', entregado:'estado-entregado', cancelado:'estado-cancelado' };
      const container = document.getElementById('pedidosList');
      if (!container) return;

      if (!list.length) {
        container.innerHTML = `<div style="text-align:center;padding:3.5rem 1rem;color:var(--soft);grid-column:1/-1;background:#fff;border-radius:20px;border:1.5px dashed var(--border);">
          <div style="font-size:2.4rem; margin-bottom:0.6rem; color:var(--lila); display:flex; justify-content:center;"><span style="width:48px;height:48px;display:flex;align-items:center;justify-content:center;background:var(--lila-xlight);border-radius:50%;">${SVG_ADMIN.plant}</span></div>
          <strong style="font-size:1.1rem; color:var(--text);">No se encontraron pedidos</strong>
          <div style="font-size:0.78rem; margin-top:0.35rem;">Intenta con otro filtro de búsqueda o registra un pedido manual con el botón "+ Nuevo pedido".</div>
        </div>`;
        return;
      }

      container.innerHTML = list.map(p => {
        const resolvedProds = resolveOrderProducts(p);
        const primaryProd = resolvedProds[0] || { name: 'Ramo tejido', img: DEFAULT_RAMO_FALLBACK, qty: 1 };
        const cleanWa = (p.tel || '').replace(/\D/g, '');
        const waLink = cleanWa ? `https://wa.me/${cleanWa.startsWith('57') ? cleanWa : (cleanWa.length === 10 ? '57' + cleanWa : cleanWa)}` : '';
        const fullAddr = [p.direccion, p.barrio ? 'Barrio ' + p.barrio : '', p.ciudad].filter(Boolean).join(', ') || p.notas?.split('|')[0]?.trim();

        return `
        <div class="pedido-card" onclick="if(!event.target.closest('button') && !event.target.closest('a')) openMiPedido('${p.id}')">
          <div class="pedido-card-split">
            
            <!-- Izquierda: Datos del Pedido -->
            <div class="pedido-card-left">
              <div class="pedido-top">
                <div class="pedido-id">
                  <span>${SVG_ADMIN.package}</span> <strong>#${String(p.id).slice(-6)}</strong>
                </div>
                <span class="pedido-estado ${eCls[p.estado] || 'estado-pendiente'}">${eLabels[p.estado] || p.estado}</span>
              </div>

              <div class="pedido-cliente">
                ${p.cliente || 'Cliente sin nombre'}
              </div>

              <div class="pedido-items" title="${p.items || ''}">
                ${SVG_ADMIN.plant} ${p.items || 'Ramo tejido a crochet'}
              </div>

              <div class="pedido-detalles-mini">
                ${p.tel ? `
                  <span class="pedido-chip">
                    ${SVG_ADMIN.phone} ${p.tel}
                    ${waLink ? `<a href="${waLink}" target="_blank" onclick="event.stopPropagation()" style="color:#25d366; text-decoration:none; font-weight:700; margin-left:3px; display:inline-flex; align-items:center;" title="Abrir WhatsApp">${SVG_ADMIN.whatsapp}</a>` : ''}
                  </span>
                ` : ''}
                ${fullAddr ? `<span class="pedido-chip" title="${fullAddr}">${SVG_ADMIN.mapPin} ${fullAddr.length > 28 ? fullAddr.slice(0, 26) + '...' : fullAddr}</span>` : ''}
                ${p.guia ? `<span class="pedido-chip" style="background:#f3e8ff; color:#7c3aed; font-weight:600;">${SVG_ADMIN.truck} Guía: ${p.guia}</span>` : ''}
              </div>

              <div class="pedido-bottom">
                <div class="pedido-total">${p.total > 0 ? '$' + p.total.toLocaleString('es-CO') : ''}</div>
                <div class="pedido-fecha">${p.fecha || ''}</div>
              </div>
            </div>

            <!-- Derecha: Foto del Ramo comprado (Optimizado en PC) -->
            <div class="pedido-card-right" title="Clic para ver detalle de Mi Pedido">
              <img src="${primaryProd.img || DEFAULT_RAMO_FALLBACK}" alt="${primaryProd.name}" class="pedido-card-img" onerror="onPhotoError(this)" loading="lazy" />
              <div class="pedido-card-qty-badge">${primaryProd.qty > 1 ? primaryProd.qty + 'x' : '1x'}</div>
            </div>

          </div>

          <!-- Acciones Rápidas -->
          <div class="pedido-actions" onclick="event.stopPropagation()">
            <button class="p-action-btn primary" onclick="openMiPedido('${p.id}')">
              ${SVG_ADMIN.eye} Mi Pedido
            </button>
            <button class="p-action-btn" onclick="openEditPedido('${p.id}')" title="Editar campos">
              ${SVG_ADMIN.edit} Editar
            </button>
            <button class="p-action-btn" onclick="currentModalPedidoId='${p.id}'; copyFullOrderManifest();" title="Copiar rótulo">
              ${SVG_ADMIN.clipboard} Rótulo
            </button>
            ${p.estado !== 'entregado' ? `
              <button class="p-action-btn" onclick="cambiarEstadoPedido('${p.id}','entregado')">
                ${SVG_ADMIN.check} Entregado
              </button>
            ` : ''}
            <button class="p-action-btn" style="background:var(--lila-xlight); color:var(--lila-dark); border:1px solid var(--lila-light);" onclick="crearGuiaSkydropx('${p.id}')">
              ${SVG_ADMIN.truck} Skydropx
            </button>
            <button class="p-action-btn" style="color:var(--red); border-color:#fca5a5;" onclick="deletePedido('${p.id}')" title="Eliminar">
              ${SVG_ADMIN.deleteBin}
            </button>
          </div>
        </div>
        `;
      }).join('');
    }
