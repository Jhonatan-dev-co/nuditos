      const customFoto = document.getElementById('pCustomFoto')?.value || '';
      const tempOrder = { items: itemsVal, foto: customFoto };
      const prods = resolveOrderProducts(tempOrder);
      if (prods && prods.length) {
        currentModalProducts = prods;
        currentModalSelectedProductIndex = 0;
        renderActiveBouquetPhoto();
      }
    }

    function onEditEstadoChanged(val) {
      syncModalFooterStatusPills(val);
      const eLabels = { pendiente:'⏳ Pendiente', pagado:'💰 Pagado', proceso:'🔄 En proceso', entregado:'✅ Entregado', cancelado:'❌ Cancelado' };
      const eCls = { pendiente:'estado-pendiente', pagado:'estado-pagado', proceso:'estado-proceso', entregado:'estado-entregado', cancelado:'estado-cancelado' };
      const statusEl = document.getElementById('mpHeaderStatus');
      if (statusEl) {
        statusEl.textContent = eLabels[val] || val;
        statusEl.className = 'pedido-estado ' + (eCls[val] || 'estado-pendiente');
      }
    }

    function setPedidoViewMode(isEdit) {
      isEditModePedido = isEdit;
      const vContainer = document.getElementById('mpViewContainer');
      const eContainer = document.getElementById('mpEditContainer');
      const btnView = document.getElementById('mpModeBtnView');
      const btnEdit = document.getElementById('mpModeBtnEdit');

      if (isEdit) {
        if (vContainer) vContainer.style.display = 'none';
        if (eContainer) eContainer.style.display = 'block';
        if (btnView) btnView.classList.remove('active');
        if (btnEdit) btnEdit.classList.add('active');
      } else {
        if (vContainer) vContainer.style.display = 'grid';
        if (eContainer) eContainer.style.display = 'none';
        if (btnView) btnView.classList.add('active');
        if (btnEdit) btnEdit.classList.remove('active');
      }
    }

    function toggleEditModePedido() {
      setPedidoViewMode(!isEditModePedido);
    }

    function toggleAccordion(accId) {
      const el = document.getElementById(accId);
      if (el) el.classList.toggle('open');
    }

    function syncModalFooterStatusPills(currentEstado) {
      document.querySelectorAll('.mp-status-btn').forEach(btn => {
        if (btn.getAttribute('data-status') === currentEstado) {
          btn.classList.add('active');
        } else {
          btn.classList.remove('active');
        }
      });
    }

