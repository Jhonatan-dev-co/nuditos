        </svg>
        Entrar con Google
      </button>

      <!-- Botón de GitHub OAuth -->
      <button class="login-oauth-btn login-github" onclick="sbSignInWithOAuth('github')">
        <svg viewBox="0 0 24 24" width="20" height="20" xmlns="http://www.w3.org/2000/svg" fill="currentColor">
