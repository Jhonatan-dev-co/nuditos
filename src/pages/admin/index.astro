       NUDITOS Admin Logic — Core JS
       ══════════════════════════════════════════ -->
  <script is:inline>
    let adminCfg={}, heroSelection=[], momentoSelection=null;
    let adminProducts=[], selectedId=null, pendingDeleteId=null;
    let editorialBannersAdmin=[], sideFilterCat='';
    let pedidos=[], pedidoFilter='todos';
    let adminCategories=[];
    let seleccionSelection=[]; // Nueva lista para sección superior
    let adminCampaigns=[]; // ← Nueva lista de campañas
    let uploadedImgs=[], currentEditingImgs=[];
    let changeHistory=[];
    let selectedProducts = new Set();
    let isDraftLoading = false;

    /* ── DRAFT SYSTEM (AUTOSAVE) ── */
    function saveProductDraft() {
      if (isDraftLoading) return;
      const editor = document.getElementById('tab-productos');
      if (!editor || !document.getElementById('fNombre')) return;

      const draft = {
        id: document.getElementById('editingId').value,
        name: document.getElementById('fNombre').value,
        price: document.getElementById('fPrecio').value,
        cat: document.getElementById('fCat').value,
        emoji: document.getElementById('fEmoji').value,
        desc: document.getElementById('fDesc').value,
        activo: document.getElementById('fActivo').value === 'true',
        stock: document.getElementById('fStock').value,
        stockUnlimited: document.getElementById('fStockUnlimited').checked,
        badge: getSelectedBadge(),
        oferta: document.getElementById('fTagOferta').checked,
        precioOriginal: document.getElementById('fPrecioOriginal').value,
        precioOferta: document.getElementById('fPrecioOferta').value,
        imgs: document.getElementById('fImgs').value.split('\n').filter(s=>s.trim()),
        img: document.getElementById('fImg').value,
        metaTitle: document.getElementById('fMetaTitle').value,
        seoKeywords: document.getElementById('fSeoKeywords').value,
        metaDescription: document.getElementById('fMetaDesc').value,
        altText: document.getElementById('fAltText').value,
        timestamp: Date.now()
      };

      localStorage.setItem('nuditos_product_draft', JSON.stringify(draft));
      const indicator = document.getElementById('draftIndicator');
      if (indicator) {
        indicator.textContent = '✓ Borrador guardado localmente';
        indicator.style.opacity = '1';
        setTimeout(() => { if (indicator) indicator.style.opacity = '0.5'; }, 2000);
      }
    }

    function getSelectedBadge() {
       if(document.getElementById('fTagNuevo')?.checked) return 'Nuevo';
       if(document.getElementById('fTagPopular')?.checked) return 'Popular';
       if(document.getElementById('fTagEspecial')?.checked) return 'Especial';
       return '';
    }

    function clearProductDraft() {
      localStorage.removeItem('nuditos_product_draft');
      const indicator = document.getElementById('draftIndicator');
      if (indicator) indicator.textContent = '';
    }

    function checkAndRestoreDraft() {
      const saved = localStorage.getItem('nuditos_product_draft');
      if (!saved) return;
      
      const draft = JSON.parse(saved);
      const diff = Date.now() - draft.timestamp;
      const minutes = Math.floor(diff / 60000);
      
      if (confirm(`📦 Se encontró un borrador de "${draft.name || 'Sin nombre'}" guardado hace ${minutes} min. ¿Deseas recuperarlo?`)) {
        isDraftLoading = true;
        
        // Si el draft tiene ID, seleccionamos ese producto primero
        if (draft.id) {
          selectProduct(parseInt(draft.id));
        } else {
          newProduct();
        }

        // Poblar campos (darle un pequeño delay para que el HTML se renderice si fue newProduct)
        setTimeout(() => {
          if (document.getElementById('fNombre')) document.getElementById('fNombre').value = draft.name || '';
          if (document.getElementById('fPrecio')) document.getElementById('fPrecio').value = draft.price || 0;
          if (document.getElementById('fCat')) document.getElementById('fCat').value = draft.cat || '';
          if (document.getElementById('fEmoji')) document.getElementById('fEmoji').value = draft.emoji || '🌸';
          if (document.getElementById('fDesc')) document.getElementById('fDesc').value = draft.desc || '';
          if (document.getElementById('fActivo')) document.getElementById('fActivo').value = draft.activo ? 'true' : 'false';
          if (document.getElementById('fStock')) document.getElementById('fStock').value = draft.stock || 99;
          if (document.getElementById('fStockUnlimited')) document.getElementById('fStockUnlimited').checked = draft.stockUnlimited;
          
          if (document.getElementById('fTagNuevo')) document.getElementById('fTagNuevo').checked = (draft.badge === 'Nuevo');
          if (document.getElementById('fTagPopular')) document.getElementById('fTagPopular').checked = (draft.badge === 'Popular');
          if (document.getElementById('fTagEspecial')) document.getElementById('fTagEspecial').checked = (draft.badge === 'Especial');
          
          if (document.getElementById('fTagOferta')) {
            document.getElementById('fTagOferta').checked = draft.oferta;
            toggleOfertaFields();
          }
          if (document.getElementById('fPrecioOriginal')) document.getElementById('fPrecioOriginal').value = draft.precioOriginal || 0;
          if (document.getElementById('fPrecioOferta')) document.getElementById('fPrecioOferta').value = draft.precioOferta || 0;
          
          if (document.getElementById('fImgs')) document.getElementById('fImgs').value = (draft.imgs || []).join('\n');
          if (document.getElementById('fImg')) document.getElementById('fImg').value = draft.img || '';
          
          if (document.getElementById('fMetaTitle')) document.getElementById('fMetaTitle').value = draft.metaTitle || '';
          if (document.getElementById('fSeoKeywords')) document.getElementById('fSeoKeywords').value = draft.seoKeywords || '';
          if (document.getElementById('fMetaDesc')) document.getElementById('fMetaDesc').value = draft.metaDescription || '';
          if (document.getElementById('fAltText')) document.getElementById('fAltText').value = draft.altText || '';
          
          isDraftLoading = false;
          updatePreview();
          showToast('✓ Borrador restaurado');
        }, 100);
      } else {
        clearProductDraft();
      }
    }

    /* ── AUTH / LOGIN ── */
    function toggleEmailLogin() {
      const container = document.getElementById('emailLoginContainer');
      const isHidden = window.getComputedStyle(container).display === 'none';
      container.style.display = isHidden ? 'flex' : 'none';
      const toggleBtn = document.querySelector('.login-toggle-email');
      toggleBtn.textContent = isHidden ? 'Ocultar acceso por correo' : 'Entrar con correo y contraseña';
    }

    async function doLogin(){
      const email=document.getElementById('loginEmail').value.trim();
      const pwd=document.getElementById('loginPwd').value;
      const errEl=document.getElementById('loginErr');
      errEl.style.display='none';
      if(!email||!pwd){errEl.textContent='Completa email y contraseña';errEl.style.display='block';return;}
      const btn=document.querySelector('.login-btn');
      btn.textContent='Entrando...';btn.disabled=true;
      try{
        await sbSignIn(email,pwd);
        document.getElementById('loginScreen').style.display='none';
        const p=document.getElementById('adminPanel');p.style.display='flex';
        loadAll();
      }catch(e){
        errEl.textContent='Email o contraseña incorrectos';errEl.style.display='block';
      }finally{btn.textContent='Entrar';btn.disabled=false;}
    }

    async function doLogout(){
      await sbSignOut();
      document.getElementById('loginScreen').style.display='flex';
      document.getElementById('adminPanel').style.display='none';
      document.getElementById('loginPwd').value='';
      document.getElementById('loginEmail').value='';
    }

    window.addEventListener('DOMContentLoaded',()=>{
      // Primero verificar si venimos de un callback de OAuth
      const hasOAuthSession = sbHandleOAuthCallback();
      
      if(hasOAuthSession || sbRestoreSession()){
        document.getElementById('loginScreen').style.display='none';
        const p=document.getElementById('adminPanel');p.style.display='flex';
