---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { getLiveConfig } from '../lib/supabase';

// Nuditos: Página de Agradecimiento
export const prerender = false;

const config = await getLiveConfig();
const ref = Astro.url.searchParams.get('ref') || '';
---

<Layout
  title="¡Gracias por tu compra! — Nuditos"
  description="Tu pedido ha sido procesado exitosamente."
  noIndex={true}
>
  <div class="max-w-[700px] mx-auto px-4 sm:px-6 py-16 sm:py-24 text-center flex flex-col items-center">
    <div class="w-20 h-20 bg-emerald-50 border border-emerald-200/60 text-emerald-600 rounded-3xl flex items-center justify-center mb-6 shadow-xs">
      <Icon name="checkbox-circle" class="text-4xl" />
    </div>
    
    <div class="inline-flex items-center gap-1.5 bg-emerald-50 border border-emerald-200/70 text-emerald-900 px-3.5 py-1 rounded-full text-[10px] sm:text-xs font-bold uppercase tracking-wider mb-4">
      Pedido Confirmado
    </div>

    <h1 class="font-serif text-3xl md:text-5xl font-light text-slate-800 mb-4 leading-tight">
      ¡Gracias por tu <em class="italic text-amber-600 font-normal">compra!</em>
    </h1>
    <p class="text-slate-500 mb-8 max-w-md text-xs sm:text-sm leading-relaxed">
      Hemos recibido tu orden correctamente. Nuestro taller artesano está tejiendo con todo el amor para ti. Te notificaremos cada avance de tu envío.
    </p>

    {ref && (
      <div class="bg-amber-50/70 border border-amber-200/70 py-3 px-6 rounded-2xl text-xs text-amber-900 font-medium mb-8 uppercase tracking-wider">
        Referencia de pago: <strong class="text-slate-900">{ref}</strong>
      </div>
    )}

    <div class="flex flex-col sm:flex-row gap-3">
      <a href="/" class="inline-flex items-center justify-center gap-2 bg-[#1a1220] hover:bg-black text-white font-bold uppercase tracking-wider text-xs px-8 py-4 rounded-2xl transition-all shadow-lg active:scale-95">
        <Icon name="shopping-bag-3" class="w-4 h-4 text-amber-400" />
        <span>Volver al Inicio</span>
      </a>
      <a href="https://wa.me/573144931525" target="_blank" class="inline-flex items-center justify-center gap-2 bg-emerald-600 hover:bg-emerald-700 text-white font-bold uppercase tracking-wider text-xs px-6 py-4 rounded-2xl transition-all shadow-md active:scale-95">
        <Icon name="whatsapp" class="w-4 h-4" />
        <span>Consultar por WhatsApp</span>
      </a>
    </div>
  </div>

  <script is:inline>
    document.addEventListener('astro:page-load', () => {
      // 1. Check local storage for cart
      let totalAmount = 0;
      let orderItems = [];
      try {
        const cartStr = localStorage.getItem('nuditos_cart');
        if (cartStr) {
          orderItems = JSON.parse(cartStr);
          if (Array.isArray(orderItems)) {
            const subtotal = orderItems.reduce((acc, i) => acc + (i.price * i.qty), 0);
            totalAmount = subtotal;
            try {
              const dStr = localStorage.getItem('nuditos_discount');
              if (dStr) {
                const discount = JSON.parse(dStr);
                if (discount && discount.pct) {
                  totalAmount = subtotal - Math.round(subtotal * discount.pct / 100);
                }
              }
            } catch(e){}
          }
        }
      } catch (e) {}

      // 2. Track Facebook & TikTok Pixel Purchase Events
      if (typeof window.fbq === 'function' && totalAmount > 0) {
        window.fbq('track', 'Purchase', {
          content_ids: orderItems.map(i => i.id ? i.id.toString() : ''),
          value: totalAmount,
          currency: 'COP',
          num_items: orderItems.reduce((acc, i) => acc + (i.qty || 1), 0),
          content_type: 'product'
        });
      }
      if (typeof window.ttq === 'object' && totalAmount > 0) {
        window.ttq.track('CompletePayment', {
          contents: orderItems.map(i => ({
            content_id: i.id ? i.id.toString() : '',
            content_name: i.name || '',
            content_type: 'product',
            price: Number(i.price),
            quantity: Number(i.qty || 1)
          })),
          value: totalAmount,
          currency: 'COP'
        });
      }

      // 3. Clear cart after successful purchase
      if (window.$cart && typeof window.$cart.set === 'function') {
        window.$cart.set([]);
      } else {
        localStorage.removeItem('nuditos_cart');
      }
      if (window.$discount && typeof window.$discount.set === 'function') {
        window.$discount.set(null);
      } else {
        localStorage.removeItem('nuditos_discount');
      }

      // 4. Limpiar datos de checkout persistentes
      localStorage.removeItem('nuditos_checkout_data_v2');
    });
  </script>
</Layout>
