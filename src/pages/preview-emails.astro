          <tr>
            <td style="vertical-align:middle;padding-right:6px;">${SVG_ICONS.flower}</td>
            <td style="font-size:26px;font-weight:300;color:${brandColor};letter-spacing:3px;font-family:Georgia,'Times New Roman',serif;">NUDITOS</td>
          </tr>
