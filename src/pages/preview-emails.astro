<Layout title="Vista Previa de Correos — Nuditos Tejidos" description="Vista previa interactiva de todas las plantillas de correo electrónico">
  <main style="min-height:100vh;background:#0f0b14;padding:2rem 1rem;">
    <div style="max-width:720px;margin:0 auto;">
      <div style="text-align:center;margin-bottom:2.5rem;">
        <h1 style="font-family:Georgia,serif;font-size:2rem;font-weight:400;color:#fff;margin:0 0 0.5rem;">Vista Previa de Correos (Íconos Vectoriales SVG)</h1>
        <p style="color:#9a8da3;font-size:0.95rem;margin:0;">Visualización profesional sin emojis con íconos limpios y fotos HD de Supabase</p>
      </div>

      <!-- Tabs -->
      <div id="email-tabs" style="display:flex;flex-wrap:wrap;gap:8px;justify-content:center;margin-bottom:2rem;">
        {emails.map((email, i) => (
          <button
            class="email-tab"
            data-target={email.id}
            style={`padding:8px 16px;border-radius:50px;border:1px solid ${i === 0 ? brandColor : '#2a2035'};background:${i === 0 ? brandColor : '#1a1225'};color:${i === 0 ? '#fff' : '#9a8da3'};font-size:13px;cursor:pointer;transition:all 0.3s;font-family:inherit;`}
          >
            {email.title}
          </button>
        ))}
      </div>

      <!-- Content -->
      {emails.map((email, i) => (
        <div
          class="email-panel"
          id={`panel-${email.id}`}
          style={`display:${i === 0 ? 'block' : 'none'};`}
        >
          <p style="text-align:center;color:#9a8da3;font-size:0.85rem;margin:0 0 1rem;font-style:italic;">
            {email.subtitle}
          </p>
          <div style="border-radius:16px;overflow:hidden;box-shadow:0 20px 60px rgba(0,0,0,0.3);">
            <Fragment set:html={email.html} />
          </div>
        </div>
      ))}
    </div>
  </main>

  <script>
    document.querySelectorAll('.email-tab').forEach(tab => {
      tab.addEventListener('click', () => {
        document.querySelectorAll('.email-panel').forEach(p => (p as HTMLElement).style.display = 'none');
        document.querySelectorAll('.email-tab').forEach(t => {
          (t as HTMLElement).style.background = '#1a1225';
          (t as HTMLElement).style.color = '#9a8da3';
          (t as HTMLElement).style.borderColor = '#2a2035';
        });
        const target = (tab as HTMLElement).dataset.target;
        const panel = document.getElementById(`panel-${target}`);
        if (panel) panel.style.display = 'block';
        (tab as HTMLElement).style.background = '#8c5fad';
        (tab as HTMLElement).style.color = '#fff';
        (tab as HTMLElement).style.borderColor = '#8c5fad';
      });
    });
  </script>
</Layout>
