          <a href="https://wa.me/573144931525" style="color:${textMuted};text-decoration:none;">WhatsApp</a> · 
          <a href="https://nuditos.com.co" style="color:${textMuted};text-decoration:none;">Tienda</a>
        </p>
        <p style="font-size:11px;color:${textMuted};margin:0;">Nuditos Tejidos — Flores eternas hechas con amor<br>Colombia · hola@nuditos.com.co</p>
      </div>
    </div>
  </div>`;
}

function productRow(p: {name: string, qty: number, img: string}): string {
  return `<div style="padding:12px 0;border-bottom:1px solid ${borderLight};display:flex;align-items:center;gap:16px;">
    <img src="${p.img}" alt="${p.name}" width="72" height="72" style="border-radius:12px;object-fit:cover;border:1px solid ${borderLight};flex-shrink:0;" />
    <div>
      <div style="font-size:15px;font-weight:600;color:${textPrimary};line-height:1.4;">${p.name}</div>
      <div style="font-size:13px;color:${textSecondary};margin-top:2px;">Cantidad: ${p.qty}</div>
      <div style="font-size:11px;color:${textMuted};margin-top:4px;">Hecho a mano · Flores eternas</div>
    </div>
  </div>`;
}

