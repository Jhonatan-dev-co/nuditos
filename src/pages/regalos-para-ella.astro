---
import PremiumLanding from '../components/PremiumLanding.astro';
export const prerender = false;
---
<PremiumLanding
  seoTitle="Regalos para Ella | Flores Eternas Tejidas a Mano en Colombia | Nuditos"
  seoDesc="Sorprende a esa mujer especial con flores que duran para siempre. Ramos artesanales tejidos a mano, el detalle más original y romántico de Colombia. Envío a todo el país."
  seoKeywords="regalos para ella, flores para mi novia, detalle para mujer, ramos eternos, flores tejidas colombia, regalo original mujer"
  eyebrow="Porque ella merece algo que dure"
  h1="Un detalle para esa mujer que"
  h1Em="merece flores eternas"
  heroCopy="No esperes una fecha especial. Ese ser que ilumina tu vida merece un gesto tan duradero como lo que sientes. Nuestros ramos tejidos a mano son más que flores: son un mensaje que no se marchita. Envío a toda Colombia."
  ctaWaText="Hola Nuditos! 🌸 Quiero sorprenderla con un detalle especial"
  collectionTitle="Escoge el Detalle Perfecto"
  collectionBadge="Lo más pedido por ellos 🔥"
  relatedLinks={[
    { label: "Regalos para Novia", href: "/regalos-para-novia" },
    { label: "Regalos de Aniversario", href: "/regalos-de-aniversario" },
    { label: "Regalo para Esposa", href: "/regalo-para-esposa" },
    { label: "Catálogo Completo", href: "/catalogo" }
  ]}
  faq={[
    { q: "¿Por qué regalarle flores tejidas en lugar de naturales?", a: "Las flores naturales duran días, nuestros ramos duran años. Son un recordatorio permanente de tu detalle y decorarán su espacio favorito por mucho tiempo." },
    { q: "¿Puedo personalizar los colores del ramo?", a: "Sí, puedes elegir los colores que más le gusten. Escríbenos por WhatsApp y te asesoramos para crear algo único." },
    { q: "¿Llegan bien empacados?", a: "Cada ramo va en empaque boutique premium con protección especial. Llegan perfectos y listos para sorprender." },
    { q: "¿Hacen envíos a toda Colombia?", a: "Sí, enviamos a todas las ciudades principales y municipios con cobertura nacional. El envío es seguro y rastreable." },
    { q: "¿Incluyen dedicatoria?", a: "Sí, puedes agregar una nota escrita a mano para que el detalle sea aún más personal." },
  ]}
  ctaFinalTitle="¿Listo para <em class='italic text-violet-600 font-normal'>sorprenderla?</em>"
  ctaFinalCopy="No necesitas una excusa. El mejor momento para demostrarle lo que sientes es hoy. Escríbenos y te ayudamos a elegir el ramo perfecto."
  ctaTags={["🌹 Flores eternas", "🎁 Empaque boutique", "✍️ Dedicatoria a mano", "🚚 Envío seguro"]}
/>
