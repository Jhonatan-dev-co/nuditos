---
import Icon from '../../components/Icon.astro';
import Layout from '../../layouts/Layout.astro';
import { clUrl } from '../../data/datos';
import { getLivePosts } from '../../lib/supabase';

// Fetch live posts from Supabase or fallback to mock data
const livePosts = await getLivePosts();
const posts = livePosts.length > 0 ? livePosts : [
  {
    title: 'Cómo cuidar tus flores de crochet para que duren años',
    created_at: '2026-03-31',
    excerpt: 'Descubre los secretos para mantener tus ramos de crochet tan frescos como el primer día. Limpieza, luz y almacenamiento.',
    category: 'Cuidados',
    slug: 'cuidados-ramos-crochet',
    image: 'https://images.unsplash.com/photo-1544833058-e70f9ca2bf2e?q=80&w=1200'
  },
  {
    title: 'El lenguaje de las flores eternas: ¿Qué significa cada color?',
    created_at: '2026-03-25',
    excerpt: 'Descubre el significado detrás de los colores de nuestros ramos de crochet.',
    category: 'Regalos',
    slug: 'significado-colores-crochet',
    image: 'https://images.unsplash.com/photo-1490750967868-88aa3386c946?q=80&w=1200'
  }
];

function formatDate(dateStr: string) {
  const date = new Date(dateStr);
  return date.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });
}
---

<Layout
  title="Blog Nuditos — Guías de Regalos, Flores y Crochet en Colombia"
  description="Artículos sobre ramos de crochet, ideas de regalos para novia, mamá y amiga, flores eternas y más. Todo sobre Nuditos Tejidos."
  keywords="blog ramos crochet, guía regalos Colombia, flores eternas blog, ideas de regalo, nuditos tejidos"
>
  <!-- Hero -->
  <section class="bg-gradient-to-br from-stone-50 via-white to-amber-50/20 pt-20 sm:pt-24 pb-12 sm:pb-16 px-4 md:px-6 border-b border-stone-100 text-center">
    <div class="max-w-4xl mx-auto">
      <div class="inline-flex items-center gap-1.5 bg-amber-50 border border-amber-200/70 text-amber-900 px-3.5 py-1 rounded-full text-[10px] sm:text-xs font-bold uppercase tracking-wider mb-4">
        Puntadas & Consejos
      </div>
      <h1 class="font-serif text-[clamp(2.1rem,6vw,4.2rem)] font-light leading-[1.08] text-slate-800 mb-4">
        Blog <em class="italic text-amber-600 font-normal">Nuditos</em>
      </h1>
      <p class="max-w-xl mx-auto text-slate-500 text-xs sm:text-sm md:text-base leading-relaxed">
        Historias, guías de cuidado, ideas de regalo y secretos detrás de nuestras flores tejidas a mano.
      </p>
    </div>
  </section>

  <!-- Grilla de Artículos -->
  <main class="max-w-[1100px] mx-auto px-4 sm:px-6 py-12 sm:py-16">
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
      {posts.map(post => (
        <a href={`/blog/${post.slug}`} class="group bg-white rounded-2xl sm:rounded-3xl overflow-hidden border border-stone-200/80 hover:border-amber-300 shadow-xs hover:shadow-lg transition-all duration-300 flex flex-col hover:-translate-y-1">
          <div class="aspect-16/10 overflow-hidden bg-stone-100 relative">
            <img 
              src={clUrl(post.image || post.img, 800)} 
              alt={post.title} 
              width="800"
              height="500"
              loading="lazy"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
          </div>
          <div class="p-5 sm:p-6 flex flex-col flex-1">
            <div class="flex items-center gap-2 mb-3">
              <span class="bg-amber-50 border border-amber-200/60 text-amber-900 px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider">
                {post.category || 'Nuditos'}
              </span>
              <span class="text-[11px] text-slate-400 font-medium">{formatDate(post.created_at)}</span>
            </div>
            
            <h2 class="font-serif text-xl sm:text-2xl font-light text-slate-800 group-hover:text-amber-600 transition-colors leading-snug mb-2">
              {post.title}
            </h2>
            
            <p class="text-slate-500 text-xs leading-relaxed mb-4 line-clamp-3">
              {post.excerpt || post.content?.substring(0, 150) + '...'}
            </p>
            
            <div class="mt-auto pt-3 border-t border-stone-100 flex items-center justify-between text-xs font-bold text-slate-700 group-hover:text-amber-600 transition-colors">
              <span class="uppercase tracking-wider text-[10px]">Leer artículo</span>
              <Icon name="arrow-right" class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" />
            </div>
          </div>
        </a>
      ))}
    </div>
  </main>
</Layout>
